+static unsigned quant(const uint8_t *b, int i, bool q6) {
+    if (!q6)
+        return (b[16 + 32 * (i / 64) + i % 32] >> (4 * ((i % 64) / 32))) & 15;
+    const int h = i / 128, p = i % 128;
+    return ((b[64 * h + p % 64] >> (4 * (p / 64))) & 15) |
+           (((b[128 + 32 * h + p % 32] >> (2 * (p / 32))) & 3) << 4);
+}
+static void set_quant(uint8_t *b, int i, unsigned x, bool q6) {
+    if (!q6) {
+        b[16 + 32 * (i / 64) + i % 32] |= x << (4 * ((i % 64) / 32));
+        return;
+    }
+    int h = i / 128, p = i % 128;
+    b[64 * h + p % 64] |= (x & 15) << (4 * (p / 64));
+    b[128 + 32 * h + p % 32] |= (x >> 4) << (2 * (p / 32));
+}
+void moe_tiled_pack(const uint8_t *raw, uint8_t *out, int rows, int nb, int nr, bool q6) {
+    const int sz = q6 ? 210 : 144, nh = q6 ? 18 : 16;
+    std::memset(out, 0, size_t(rows) * nb * sz);
+    for (int t = 0; t < rows / nr; ++t)
+        for (int bp = 0; bp < nb; ++bp) {
+            auto *d = out + (t * nb + bp) * nr * sz;
+            for (int r = 0; r < nr; ++r) {
+                const auto *b = raw + ((t * nr + r) * nb + bp) * sz;
+                if (!q6) {
+                    std::memcpy(d + 4 * r, b, 4);
+                    for (int c = 4; c < 16; ++c)
+                        d[c * nr + r] = b[c];
+                } else {
+                    for (int c = 0; c < 16; ++c)
+                        d[c * nr + r] = b[192 + c];
+                    std::memcpy(d + 16 * nr + 2 * r, b + 208, 2);
+                }
+                for (int p = 0; p < 64; ++p)
+                    for (int j = 0; j < 4; ++j) {
+                        unsigned x = quant(b, 4 * p + j, q6);
+                        int f = 4 * r + j;
+                        auto *a = d + nh * nr + p * (q6 ? 3 : 2) * nr;
+                        a[f % (2 * nr)] |= (x & 15) << (4 * (f / (2 * nr)));
+                        if (q6)
+                            a[2 * nr + f % nr] |= (x >> 4) << (2 * (f / nr));
+                    }
+            }
+        }
+}
+void moe_tiled_unpack(const uint8_t *in, uint8_t *raw, int rows, int nb, int nr, bool q6) {
+    const int sz = q6 ? 210 : 144, nh = q6 ? 18 : 16;
+    std::memset(raw, 0, size_t(rows) * nb * sz);
+    for (int t = 0; t < rows / nr; ++t)
+        for (int bp = 0; bp < nb; ++bp) {
+            auto *d = in + (t * nb + bp) * nr * sz;
+            for (int r = 0; r < nr; ++r) {
+                auto *b = raw + ((t * nr + r) * nb + bp) * sz;
+                if (!q6) {
+                    std::memcpy(b, d + 4 * r, 4);
+                    for (int c = 4; c < 16; ++c)
+                        b[c] = d[c * nr + r];
+                } else {
+                    for (int c = 0; c < 16; ++c)
+                        b[192 + c] = d[c * nr + r];
+                    std::memcpy(b + 208, d + 16 * nr + 2 * r, 2);
+                }
+                for (int p = 0; p < 64; ++p)
+                    for (int j = 0; j < 4; ++j) {
+                        int f = 4 * r + j;
+                        auto *a = d + nh * nr + p * (q6 ? 3 : 2) * nr;
+                        unsigned x = (a[f % (2 * nr)] >> (4 * (f / (2 * nr)))) & 15;
+                        if (q6)
+                            x |= ((a[2 * nr + f % nr] >> (2 * (f / nr))) & 3) << 4;
+                        set_quant(b, 4 * p + j, x, q6);
+                    }
+            }
+        }
+}
