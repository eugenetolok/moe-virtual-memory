+template <int N> static inline void decode(const uint8_t *p, bool q6, int8x16_t *w) {
+    const auto mask = vdupq_n_u8(15);
+    const auto lo0 = vld1q_u8(p);
+    if constexpr (N == 16) {
+        const auto lo1 = vld1q_u8(p + 16);
+        uint8x16_t a[4] = {vandq_u8(lo0, mask), vandq_u8(lo1, mask), vshrq_n_u8(lo0, 4), vshrq_n_u8(lo1, 4)};
+        if (q6) {
+            const auto h = vld1q_u8(p + 32);
+            const auto m = vdupq_n_u8(3);
+            a[0] = vorrq_u8(a[0], vshlq_n_u8(vandq_u8(h, m), 4));
+            a[1] = vorrq_u8(a[1], vshlq_n_u8(vandq_u8(vshrq_n_u8(h, 2), m), 4));
+            a[2] = vorrq_u8(a[2], vshlq_n_u8(vandq_u8(vshrq_n_u8(h, 4), m), 4));
+            a[3] = vorrq_u8(a[3], vshlq_n_u8(vshrq_n_u8(h, 6), 4));
+        }
+        for (int i = 0; i < 4; ++i)
+            w[i] = vreinterpretq_s8_u8(a[i]);
+    } else {
+        auto a = vandq_u8(lo0, mask), b = vshrq_n_u8(lo0, 4);
+        if (q6) {
+            const auto h = vld1_u8(p + 16), m = vdup_n_u8(3);
+            auto h0 = vcombine_u8(vand_u8(h, m), vand_u8(vshr_n_u8(h, 2), m));
+            auto h1 = vcombine_u8(vand_u8(vshr_n_u8(h, 4), m), vshr_n_u8(h, 6));
+            a = vorrq_u8(a, vshlq_n_u8(h0, 4));
+            b = vorrq_u8(b, vshlq_n_u8(h1, 4));
+        }
+        w[0] = vreinterpretq_s8_u8(a);
+        w[1] = vreinterpretq_s8_u8(b);
+    }
+}
