+double thread_cpu_ms() {
+    struct timespec ts;
+    GGML_ASSERT(clock_gettime(CLOCK_THREAD_CPUTIME_ID, &ts) == 0);
+    return ts.tv_sec * 1000.0 + ts.tv_nsec / 1e6;
