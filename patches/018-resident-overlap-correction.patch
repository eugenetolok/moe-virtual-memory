+// Union of useful expert intervals intersected with still-pending authoritative I/O.
+// Includes exact activation, which the graph reuses instead of recomputing.
+double early_interval_overlap(const llama_moe_paging_layer & l, double submit, double done) {
+    std::vector<std::pair<double, double>> spans;
+    for (int i = 0; i < 8; ++i) {
+        if (!l.early_ready[i]) { continue; }
+        auto span = std::make_pair(std::max(l.early_start[i], submit), std::min(l.early_end[i], done));
+        if (span.second > span.first) { spans.push_back(span); }
+    }
+    std::sort(spans.begin(), spans.end());
+    double total = 0, end = submit;
+    for (const auto & span : spans) {
+        total += std::max(0.0, span.second - std::max(end, span.first));
+        end = std::max(end, span.second);
+    }
+    return total;
 }
 
