new file mode 100644
index 0000000..68e7650
--- /dev/null
+++ b/src/llama-moe-paging.h
@@ -0,0 +1,112 @@
+#pragma once
+
+// Execution 004: decoupled staging + parallel cold I/O for CPU/hybrid MoE paging.
+//
+// Execution 003 coupled cache capacity M to the CPU mul_mat_id expert dimension:
+// every layer owned M-slot gate/up/down tensors, and the graph remapped global
+// expert ids to those M slots. Larger M meant more I/O hits but a slower kernel.
+//
+// This module keeps two separate objects per layer:
+//
+//   * resident cache: M raw record-layout byte slots, replaced by LRU or
+//     event-decay90; capacity M is independent of the compute shape;
+//   * staging: exactly K = n_expert_used gate/up/down tensors whose expert
+//     dimension is always K (8 for Qwen3.6-35B-A3B). The graph calls mul_mat_id
+//     on the staging tensors only, after the selected K experts are copied in.
+//
+// All misses of one layer event are gathered first and read through a bounded
+// reusable worker pool (QD 1/2/4/8). Two storage backends are supported:
+// one packed record per expert, or three component reads straight from the
+// source GGUF. Reads can be marked best-effort uncached (F_NOCACHE on macOS).
+//
+// Enabled when LLAMA_MOE_PAGING_M is set to a positive integer.
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_model;
+struct ggml_context;
+typedef struct ggml_backend_buffer * ggml_backend_buffer_t;
+
+struct llama_moe_paging_layer {
+    int il = -1;
+
+    // K = n_expert_used staging tensors, expert dimension always K
+    ggml_tensor * stage_gate = nullptr;
+    ggml_tensor * stage_up   = nullptr;
+    ggml_tensor * stage_down = nullptr;
+
+    ggml_context *        stage_ctx = nullptr;
+    ggml_backend_buffer_t stage_buf = nullptr;
+
+    // resident M-slot cache, one record-layout block per slot
+    std::vector<uint8_t> cache;
+    int n_slots = 0;
+    std::vector<int32_t>  slot_expert;  // global expert id per slot, -1 == empty
+    std::vector<uint64_t> last_use;     // per-slot recency clock
+    std::vector<double>   score;        // event-decay90 score
+    std::vector<uint8_t>  reserved;     // per event: slot is a miss destination
+
+    // component geometry inside a record
+    int64_t gate_bytes = 0;
+    int64_t up_bytes   = 0;
+    int64_t down_bytes = 0;
+    int64_t gate_off   = 0;
+    int64_t up_off     = 0;
+    int64_t down_off   = 0;
+
+    // absolute GGUF offsets for backend=gguf3
+    int64_t gguf_gate_off = 0;
+    int64_t gguf_up_off   = 0;
+    int64_t gguf_down_off = 0;
+
+    // instrumentation
+    uint64_t hits       = 0;
+    uint64_t misses     = 0;
+    uint64_t evictions  = 0;
+    uint64_t bytes_read = 0;
+    uint64_t stage_bytes = 0;
+    uint64_t events     = 0;
+    uint64_t qd_sum     = 0;
+    uint64_t qd_max     = 0;
+    uint64_t miss_hist[9] = {};   // layer events with 0..8 unique misses
+    uint64_t readset_hist[32] = {}; // read-set latency buckets for this layer
+    double   fault_ms   = 0.0;    // time waiting for the miss read set
+    double   stage_ms   = 0.0;    // cache -> staging copy
+    double   compute_ms = 0.0;    // router weights -> expert down projection
+    double   compute_start_ms = 0.0;
+};
