+// Same victim policy as pick_victim, but with an explicit reservation mask so a
+// plan pass never mutates the live LRU metadata.
+int pick_victim_ex(const llama_moe_paging_layer & l, const uint8_t * reserved) {
+    int slot = -1;
+    for (int s = 0; s < l.n_slots; s++) {
+        if (reserved[s]) {
+            continue;
+        }
+        if (l.slot_expert[s] < 0) {
+            return s;
+        }
+    }
+    const bool decay = g.policy == "event_decay90";
+    for (int s = 0; s < l.n_slots; s++) {
+        if (reserved[s]) {
+            continue;
+        }
+        if (slot < 0) {
+            slot = s;
+            continue;
+        }
+        const bool better = decay ? (l.score[s] < l.score[slot]) : (l.last_use[s] < l.last_use[slot]);
+        if (better) {
+            slot = s;
+        }
+    }
+    return slot;
+}
+
+// Deterministic hit/miss/victim plan for one layer event. It reads only the
+// pre-event cache state, so the early plan and a later demand recompute must be
+// identical. reserved is caller scratch of size l.n_slots.
+void plan_event(const llama_moe_paging_layer & l, const int32_t * req, int k,
+                int32_t * slot_out, bool * is_miss_out, int * miss_i_out,
+                int * n_miss_out, uint8_t * reserved) {
+    std::fill(reserved, reserved + l.n_slots, (uint8_t) 0);
+    int n_miss = 0;
+    for (int i = 0; i < k; i++) {
+        const int s = find_slot(l, req[i]);
+        slot_out[i] = s;
+        if (s >= 0) {
+            is_miss_out[i] = false;
+            reserved[s] = 1;
+        } else {
+            is_miss_out[i] = true;
+            miss_i_out[n_miss++] = i;
+        }
+    }
+    for (int m = 0; m < n_miss; m++) {
+        const int s = pick_victim_ex(l, reserved);
+        if (s < 0) {
+            GGML_ABORT("moe paging: no victim slot available (M=%d, misses=%d)", l.n_slots, n_miss);
+        }
+        reserved[s] = 1;
+        slot_out[miss_i_out[m]] = s;
+    }
+    *n_miss_out = n_miss;
+}
+
+// Start the exact oracle-route reads for one layer event, into the final victim
+// slots. Publishes no mapping and touches no LRU metadata.
+void oracle_early_event(llama_moe_paging_layer & l) {
+    if (!g.oracle_enabled || !llama_moe_paging_direct_storage()) {
+        return;
+    }
+    if (l.oracle_plan_valid) {
+        GGML_ABORT("moe oracle: layer %d already has a pending early plan", l.il);
+    }
+    const int64_t n_layer = g.n_layer;
+    const int64_t ev = (int64_t) g.tokens * n_layer + l.il;
+    const int64_t total = (int64_t) g.oracle_n_token * n_layer;
+    if (ev < 0 || ev >= total) {
+        GGML_ABORT("moe oracle: route trace exhausted at token %llu layer %d (events=%lld)",
+                   (unsigned long long) g.tokens, l.il, (long long) total);
+    }
+    const int k = g.oracle_k;
+    int32_t req[8];
+    for (int i = 0; i < k; i++) {
+        req[i] = g.oracle_routes[(size_t) ev * (size_t) k + i];
+    }
+
+    int32_t slot[8];
+    bool is_miss[8] = {};
+    int miss_i[8] = {};
+    int n_miss = 0;
+    plan_event(l, req, k, slot, is_miss, miss_i, &n_miss, l.oracle_reserved.data());
+    for (int i = 0; i < k; i++) {
+        for (int j = 0; j < i; j++) {
+            if (slot[i] == slot[j]) {
+                g.duplicate_reads++;
+                GGML_ABORT("moe oracle: duplicate victim slot; fail closed");
+            }
+        }
+    }
+
+    l.oracle_plan_valid = true;
+    l.oracle_event = ev;
+    l.oracle_n_miss = n_miss;
+    l.oracle_submit_ms = now_ms();
+    if (l.oracle_layer_start_ms > 0.0) {
+        g.a0_compute_us.push_back((l.oracle_submit_ms - l.oracle_layer_start_ms) * 1000.0);
+    }
+    for (int i = 0; i < k; i++) {
+        l.oracle_req[i] = req[i];
+        l.oracle_slot[i] = slot[i];
+        l.oracle_is_miss[i] = is_miss[i];
+    }
+
+    std::fill(l.early_slot.begin(), l.early_slot.end(), (uint8_t) 0);
+    for (int i = 0; i < k; i++) {
+        l.early_slot[slot[i]] = 1;  // EARLY_RESERVED
+    }
+
+    std::vector<io_task> tasks;
+    tasks.reserve((size_t) n_miss * 3);
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        build_read_tasks(l, req[i], slot[i], tasks);
+        l.early_slot[slot[i]] = 2;  // EARLY_LOADING
+    }
+
+    auto & p = *g.oracle_pending[l.il];
+    p.submitted = false;
+    p.async = false;
+    p.ok = true;
+    if (!tasks.empty()) {
+        submit_read_tasks(tasks, p);
+    }
+
+    g.oracle_events++;
+    if (!tasks.empty()) {
+        g.early_readsets_submitted++;
+        g.early_experts_submitted += (uint64_t) n_miss;
+        for (const auto & t : tasks) {
+            g.early_bytes += (uint64_t) t.size;
+        }
+    }
+}
+
+// Authoritative demand: verify the oracle route, re-derive the plan, join the
+// in-flight reads, and only then commit the normal cache metadata.
+void stage_event_oracle_demand(llama_moe_paging_layer & l, const int32_t * req, int k,
+                               int32_t * out_slot) {
+    if (k != g.oracle_k) {
+        g.oracle_route_mismatches++;
+        GGML_ABORT("moe oracle: n_expert_used=%d != oracle k=%d; fail closed", k, g.oracle_k);
+    }
+    for (int i = 0; i < k; i++) {
+        if (req[i] != l.oracle_req[i]) {
+            g.oracle_route_mismatches++;
+            fprintf(stderr, "ORACLE ROUTE MISMATCH token=%llu layer=%d pos=%d native=%d oracle=%d\n",
+                    (unsigned long long) g.tokens, l.il, i, req[i], l.oracle_req[i]);
+            GGML_ABORT("moe oracle: native ordered Top-8 != oracle route; fail closed");
+        }
+    }
+    g.oracle_route_matches++;
+
+    int32_t slot[8];
+    bool is_miss[8] = {};
+    int miss_i[8] = {};
+    int n_miss = 0;
+    plan_event(l, req, k, slot, is_miss, miss_i, &n_miss, l.oracle_reserved.data());
+
+    bool plan_ok = (n_miss == l.oracle_n_miss);
+    for (int i = 0; i < k && plan_ok; i++) {
+        if (slot[i] != l.oracle_slot[i] || is_miss[i] != l.oracle_is_miss[i]) {
+            plan_ok = false;
+        }
+    }
+    if (!plan_ok) {
+        g.victim_plan_mismatches++;
+        GGML_ABORT("moe oracle: demand victim plan != reservation plan (layer %d); fail closed", l.il);
+    }
+    g.victim_plan_matches++;
+
+    const double demand_ms = now_ms();
+    auto & p = *g.oracle_pending[l.il];
+    const bool ready = p.submitted && (!p.async || p.batch.remaining.load() == 0);
+    if (ready) {
+        g.early_ready_before_demand++;
+    } else {
+        g.early_join_inflight++;
+    }
+    const double w0 = now_ms();
+    const bool rok = wait_read_tasks(p);
+    const double w1 = now_ms();
+    g.early_wait_ms_at_demand += (w1 - w0);
+    if (!rok) {
+        GGML_ABORT("moe oracle: early read set failed (layer %d); fail closed", l.il);
+    }
+
+    const bool decay = g.policy == "event_decay90";
+    std::fill(l.reserved.begin(), l.reserved.end(), (uint8_t) 0);
+    for (int i = 0; i < k; i++) {
+        const int s = slot[i];
+        l.reserved[s] = 1;
+        if (!is_miss[i]) {
+            l.hits++;
+            l.last_use[s] = ++g.clock;
+            if (decay) {
+                l.score[s] += 1.0;
+            }
+        }
+    }
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = slot[i];
+        if (l.slot_expert[s] >= 0) {
+            l.evictions++;
+        }
+        l.slot_expert[s] = req[i];
+        l.last_use[s] = ++g.clock;
+        l.score[s] = decay ? 1.0 : 0.0;
+        l.misses++;
+        l.bytes_read += (uint64_t) g.record_stride;
+    }
+    l.miss_hist[std::min(n_miss, 8)]++;
+    l.events++;
+    for (int j = 0; j < k; j++) {
+        out_slot[j] = slot[j];
+    }
+    l.direct_calls++;
+    const double now = now_ms();
+    l.stage_wall_ms += now - l.oracle_submit_ms;
+    l.readset_wall_ms += demand_ms - l.oracle_submit_ms;
+    l.read_wait_ms += (w1 - w0);
+    l.fault_ms += (w1 - w0);
+    l.compute_start_ms = now;
+    g.early_hidden_ms += std::max(0.0, demand_ms - l.oracle_submit_ms);
+    g.early_lead_us.push_back((demand_ms - l.oracle_submit_ms) * 1000.0);
+
+    l.oracle_plan_valid = false;
+    std::fill(l.early_slot.begin(), l.early_slot.end(), (uint8_t) 0);
+    l.oracle_submit_ms = 0.0;
+}
