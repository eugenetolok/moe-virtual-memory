+#pragma once
+// Bounded, passive observer. No I/O on the inference/worker hot path.
+#include <atomic>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <memory>
+#include <string>
+
+struct moe_observe_record {
+    uint64_t id = 0, step = 0, bytes = 0;
+    int64_t offset = 0;
+    int32_t type = 0, layer = -1, expert = -1, component = -1, worker = -1, flags = 0;
+    double enqueue_ms = 0, start_ms = 0, end_ms = 0, promotion_ms = 0;
+    uint64_t high_bytes = 0, low_bytes = 0;
+    double value = 0;
+    uint64_t active_bytes = 0, calibration_samples = 0;
+};
+
+struct moe_observer {
+    // 0 off, 1 summary, 2 trace. Changes only at initialization.
+    int mode = 0;
+    uint64_t first = 0, count = UINT64_MAX, stride = 1;
+    size_t capacity = 0;
+    std::string path;
+    std::unique_ptr<moe_observe_record[]> records;
+    std::atomic<uint64_t> cursor{0}, dropped{0}, next_id{1};
+    std::array<std::atomic<uint64_t>, 16> events{}, bytes{}, duration_ns{}, queue_ns{};
+    std::array<std::atomic<uint64_t>, 64> read_hist{};
+    std::array<std::atomic<uint64_t>, 4096> ordinary_step_bytes{}, prefetch_step_bytes{};
+    std::atomic<uint64_t> step_bytes_overflow{0};
+
+    moe_observer() {
+        for(auto & a:events) { a.store(0); } for(auto & a:bytes) { a.store(0); }
+        for(auto & a:duration_ns) { a.store(0); } for(auto & a:queue_ns) { a.store(0); }
+        for(auto & a:read_hist) { a.store(0); }
+        for(auto & a:ordinary_step_bytes) { a.store(0); } for(auto & a:prefetch_step_bytes) { a.store(0); }
+    }
+    void init(int m, size_t budget, uint64_t start, uint64_t n, uint64_t every, const std::string & output) {
+        mode = m; first = start; count = n; stride = every; path = output;
+        capacity = m == 2 ? budget / sizeof(moe_observe_record) : 0;
+        if (capacity) { records.reset(new moe_observe_record[capacity]); }
+    }
+    bool selected(uint64_t step) const {
+        return step >= first && step - first < count && (step - first) % stride == 0;
+    }
+    static uint64_t nanos(double ms) {
+        return std::isfinite(ms) && ms > 0 ? (uint64_t) (ms * 1e6) : 0;
+    }
+    void emit(const moe_observe_record & r) {
+        if (!mode) { return; }
+        const unsigned type = (unsigned) r.type;
+        if (type >= events.size()) { return; }
+        events[type].fetch_add(1, std::memory_order_relaxed);
+        bytes[type].fetch_add(r.bytes, std::memory_order_relaxed);
+        duration_ns[type].fetch_add(nanos(r.end_ms-r.start_ms), std::memory_order_relaxed);
+        queue_ns[type].fetch_add(nanos(r.enqueue_ms>0 ? r.start_ms-r.enqueue_ms : 0), std::memory_order_relaxed);
+        if (type == 0) {
+            if (r.step < ordinary_step_bytes.size()) {
+                auto & ledger = (r.flags & 1) ? ordinary_step_bytes : prefetch_step_bytes;
+                ledger[r.step].fetch_add(r.bytes, std::memory_order_relaxed);
+            } else { step_bytes_overflow.fetch_add(r.bytes, std::memory_order_relaxed); }
+            double us = std::max(0.0, (r.end_ms-r.start_ms)*1000);
+            unsigned b = 0; while (us > 1 && b < 63) { us /= 2; ++b; }
+            read_hist[b].fetch_add(1, std::memory_order_relaxed);
+        }
+        if (mode != 2 || !selected(r.step)) { return; }
+        const uint64_t index = cursor.fetch_add(1, std::memory_order_relaxed);
+        if (index >= capacity) { dropped.fetch_add(1, std::memory_order_relaxed); return; }
+        records[index] = r; // unique producer slot; read only after all workers join
+    }
+    void stats(FILE * f) const {
+        fprintf(f, " \"telemetry_schema\": 1,\n \"telemetry_mode\": %d,\n \"telemetry_record_bytes\": %zu,\n \"telemetry_buffer_bytes\": %zu,\n \"telemetry_dropped\": %llu,\n", mode, sizeof(moe_observe_record), capacity*sizeof(moe_observe_record), (unsigned long long) dropped.load());
+        fprintf(f, " \"telemetry_summary\": [");
+        for (size_t i=0;i<events.size();++i) {
+            fprintf(f, "%s{\"type\":%zu,\"events\":%llu,\"bytes\":%llu,\"work_ms\":%.9f,\"queue_ms\":%.9f}", i?",":"", i, (unsigned long long)events[i].load(), (unsigned long long)bytes[i].load(), duration_ns[i].load()/1e6, queue_ns[i].load()/1e6);
+        }
+        fprintf(f, "],\n \"telemetry_read_hist_log2_us\": [");
+        for(size_t i=0;i<read_hist.size();++i) { fprintf(f,"%s%llu",i?",":"",(unsigned long long)read_hist[i].load()); }
+        fprintf(f,"] ,\n");
+        fprintf(f," \"telemetry_fixed_metadata_bytes\": %zu,\n \"telemetry_step_bytes_overflow\": %llu,\n",sizeof(*this),(unsigned long long)step_bytes_overflow.load());
+        for(int arm=0;arm<2;++arm) {
+            const auto & ledger=arm?prefetch_step_bytes:ordinary_step_bytes;
+            fprintf(f," \"telemetry_%s_step_bytes\": [",arm?"prefetch":"ordinary");
+            size_t end=ledger.size(); while(end && ledger[end-1].load()==0) { --end; }
+            for(size_t i=0;i<end;++i) { fprintf(f,"%s%llu",i?",":"",(unsigned long long)ledger[i].load()); }
+            fprintf(f,"],\n");
+        }
+    }
+    bool flush() const {
+        if (mode != 2) { return true; }
+        FILE * f = fopen(path.c_str(), "w"); if (!f) { return false; }
+        fprintf(f,"id,step,type,layer,expert,component,worker,flags,bytes,offset,enqueue_ms,start_ms,end_ms,promotion_ms,high_bytes,low_bytes,value,active_bytes,calibration_samples\n");
+        const size_t n=std::min<uint64_t>(cursor.load(),capacity);
+        for(size_t i=0;i<n;++i) { const auto & r=records[i];
+            fprintf(f,"%llu,%llu,%d,%d,%d,%d,%d,%d,%llu,%lld,%.17g,%.17g,%.17g,%.17g,%llu,%llu,%.17g,%llu,%llu\n",(unsigned long long)r.id,(unsigned long long)r.step,r.type,r.layer,r.expert,r.component,r.worker,r.flags,(unsigned long long)r.bytes,(long long)r.offset,r.enqueue_ms,r.start_ms,r.end_ms,r.promotion_ms,(unsigned long long)r.high_bytes,(unsigned long long)r.low_bytes,r.value,(unsigned long long)r.active_bytes,(unsigned long long)r.calibration_samples);
+        }
+        const bool ok=ferror(f)==0; return fclose(f)==0 && ok;
+    }
+};
