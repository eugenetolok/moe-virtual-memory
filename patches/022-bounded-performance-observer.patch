+bool llama_moe_observe_enabled() { return g.enabled && observer.mode; }
+void llama_moe_observe_marker(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(dst); GGML_UNUSED(a); GGML_UNUSED(nth);
+    if (ith != 0 || !observer.mode) { return; }
+    const uintptr_t tag=(uintptr_t)userdata; const int phase=(int)(tag/64), layer=(int)(tag%64)-1;
+    moe_observe_record r; r.type=phase; r.layer=layer;
+    r.step = phase>=10 && g.tokens ? g.tokens-1 : g.tokens;
+    if (layer>=0 && phase>=8 && (size_t)layer<g.layers.size() && g.layers[layer].events) { r.step=g.layers[layer].events-1; }
+    r.start_ms=r.end_ms=now_ms();
+    const int index=layer<0?40:layer;
+    GGML_ASSERT(index>=0 && index<=40 && phase>=0 && phase<16);
+    const int previous=phase==7?6:phase==8?7:phase==9?8:phase==11?10:phase==12?11:phase==14?13:-1;
+    if (previous>=0 && observe_phase_ms[index][previous]>0) { r.start_ms=observe_phase_ms[index][previous]; }
+    observe_phase_ms[index][phase]=r.end_ms;
+    observer.emit(r);
+}
