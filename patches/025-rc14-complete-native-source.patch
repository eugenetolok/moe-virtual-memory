+
+// Destination pointer of one read. In staging mode the record is assembled in
+// the M-slot cache; in direct_sparse a component lands in its resident-slot
+// tensor and never touches the byte cache.
+uint8_t * read_dst(llama_moe_paging_layer & l, int32_t slot, int kind) {
+    if (llama_moe_paging_direct_storage()) {
+        switch (kind) {
+            case READ_GATE: return (uint8_t *) l.slot_gate->data + (size_t) slot * (size_t) l.gate_bytes;
+            case READ_UP:   return (uint8_t *) l.slot_up->data   + (size_t) slot * (size_t) l.up_bytes;
+            default:        return (uint8_t *) l.slot_down->data + (size_t) slot * (size_t) l.down_bytes;
+        }
+    }
+    uint8_t * rec = l.cache.data() + (size_t) slot * (size_t) g.record_stride;
+    switch (kind) {
+        case READ_GATE: return rec + l.gate_off;
+        case READ_UP:   return rec + l.up_off;
+        default:        return rec + l.down_off;
+    }
+}
+
+void build_read_tasks(llama_moe_paging_layer & l, int32_t gid, int32_t slot, std::vector<io_task> & tasks) {
+    if (g.backend == "gguf3") {
+        io_task a; a.layer = &l; a.gid = gid; a.slot = slot; a.kind = READ_GATE;
+        a.offset = l.gguf_gate_off + (int64_t) gid * l.gate_bytes;
+        a.size = (size_t) l.gate_bytes;
+        tasks.push_back(a);
+        io_task b = a; b.kind = READ_UP;
+        b.offset = l.gguf_up_off + (int64_t) gid * l.up_bytes;
+        b.size = (size_t) l.up_bytes;
+        tasks.push_back(b);
+        io_task c = a; c.kind = READ_DOWN;
+        c.offset = l.gguf_down_off + (int64_t) gid * l.down_bytes;
+        c.size = (size_t) l.down_bytes;
+        tasks.push_back(c);
+    } else {
+        io_task a;
+        a.layer = &l; a.gid = gid; a.slot = slot; a.kind = READ_PACKED;
+        a.offset = ((int64_t) l.il * g.n_expert + gid) * g.record_stride;
+        a.size = (size_t) g.record_stride;
+        tasks.push_back(a);
+    }
+}
+
+int find_slot(const llama_moe_paging_layer & l, int32_t gid) {
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_expert[s] == gid) {
+            return s;
+        }
+    }
+    return -1;
+}
+
+int pick_victim(const llama_moe_paging_layer & l) {
+    int slot = -1;
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.reserved[s]) {
+            continue;
+        }
+        if (l.slot_expert[s] < 0) {
+            slot = s;
+            break;
+        }
+    }
+    if (slot >= 0) {
+        return slot;
+    }
+    const bool decay = g.policy == "event_decay90";
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.reserved[s]) {
+            continue;
+        }
+        if (slot < 0) {
+            slot = s;
+            continue;
+        }
+        const bool better = decay ? (l.score[s] < l.score[slot]) : (l.last_use[s] < l.last_use[slot]);
+        if (better) {
+            slot = s;
+        }
+    }
+    return slot;
+}
+
+// Same victim policy as pick_victim, but with an explicit reservation mask so a
+// plan pass never mutates the live LRU metadata.
+int pick_victim_ex(const llama_moe_paging_layer & l, const uint8_t * reserved) {
+    int slot = -1;
+    for (int s = 0; s < l.n_slots; s++) {
+        if (reserved[s]) {
+            continue;
+        }
+        if (l.slot_expert[s] < 0) {
+            return s;
+        }
+    }
+    const bool decay = g.policy == "event_decay90";
+    for (int s = 0; s < l.n_slots; s++) {
+        if (reserved[s]) {
+            continue;
+        }
+        if (slot < 0) {
+            slot = s;
+            continue;
+        }
+        const bool better = decay ? (l.score[s] < l.score[slot]) : (l.last_use[s] < l.last_use[slot]);
+        if (better) {
+            slot = s;
+        }
+    }
+    return slot;
+}
+
+// Deterministic hit/miss/victim plan for one layer event. It reads only the
+// pre-event cache state, so the early plan and a later demand recompute must be
+// identical. reserved is caller scratch of size l.n_slots.
+void plan_event(const llama_moe_paging_layer & l, const int32_t * req, int k,
+                int32_t * slot_out, bool * is_miss_out, int * miss_i_out,
+                int * n_miss_out, uint8_t * reserved) {
+    std::fill(reserved, reserved + l.n_slots, (uint8_t) 0);
+    int n_miss = 0;
+    for (int i = 0; i < k; i++) {
+        const int s = find_slot(l, req[i]);
+        slot_out[i] = s;
+        if (s >= 0) {
+            is_miss_out[i] = false;
+            reserved[s] = 1;
+        } else {
+            is_miss_out[i] = true;
+            miss_i_out[n_miss++] = i;
+        }
+    }
+    for (int m = 0; m < n_miss; m++) {
+        const int s = pick_victim_ex(l, reserved);
+        if (s < 0) {
+            GGML_ABORT("moe paging: no victim slot available (M=%d, misses=%d)", l.n_slots, n_miss);
+        }
+        reserved[s] = 1;
+        slot_out[miss_i_out[m]] = s;
+    }
+    *n_miss_out = n_miss;
+}
+
+// --- Execution 015 protected probation ---------------------------------------
+// Speculative prefetch never evicts a logical DEMAND slot; the demand-only M-slot
+// LRU evolves exactly as if prefetch did not exist.
+
+int find_slot_state(const llama_moe_paging_layer & l, int32_t gid, uint8_t st) {
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] == st && l.slot_expert[s] == gid) {
+            return s;
+        }
+    }
+    return -1;
+}
+
+int find_empty_slot(const llama_moe_paging_layer & l) {
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] == ST_EMPTY) {
+            return s;
+        }
+    }
+    return -1;
+}
+
+int find_empty_slot_ex(const llama_moe_paging_layer & l, const uint8_t * reserved) {
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] == ST_EMPTY && !reserved[s]) {
+            return s;
+        }
+    }
+    return -1;
+}
+
+// Smaller frequency / (age + 1) loses. Compare exact integer ratios.
+bool frequency_age_less(const std::vector<uint64_t> & frequency, const std::vector<uint64_t> & last,
+                        uint64_t event, int a, int b, uint64_t recency_a, uint64_t recency_b) {
+    GGML_ASSERT(a >= 0 && b >= 0 && event >= last[a] && event >= last[b]);
+    const unsigned __int128 left = (unsigned __int128) frequency[a] * (event - last[b] + 1);
+    const unsigned __int128 right = (unsigned __int128) frequency[b] * (event - last[a] + 1);
+    return left == right ? recency_a < recency_b : left < right;
+}
+
+void observe_demand_history(std::vector<uint64_t> & frequency, std::vector<uint64_t> & last,
+                            uint64_t event, const int32_t * req, int k) {
+    for (int i = 0; i < k; ++i) {
+        GGML_ASSERT(req[i] >= 0 && (size_t) req[i] < frequency.size() && frequency[req[i]] < UINT64_MAX);
+        ++frequency[req[i]];
+        last[req[i]] = event;
+    }
+}
+
+// Demand-only LRU victim among DEMAND slots not reserved by this event.
+int pick_demand_victim(const llama_moe_paging_layer & l, const uint8_t * reserved) {
+    int slot = -1;
+    const bool decay = g.policy == "event_decay90";
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] != ST_DEMAND || reserved[s]) {
+            continue;
+        }
+        if (slot < 0) {
+            slot = s;
+            continue;
+        }
+        const bool better = g.policy == "frequency_age" ?
+            frequency_age_less(l.demand_frequency, l.demand_last_event, l.events + 1,
+                               l.slot_expert[s], l.slot_expert[slot], l.last_use[s], l.last_use[slot]) : decay ? (l.score[s] < l.score[slot]) : (l.last_use[s] < l.last_use[slot]);
+        if (better) {
+            slot = s;
+        }
+    }
+    return slot;
+}
+
+// Mark one completed speculative batch. Returns the number of slots that are
+// still in-flight after this batch closed; zero means the layer has no
+// outstanding speculative read left. Does not wait.
+int prefetch_close_batch(llama_moe_paging_layer & l, std::vector<prefetch_batch>::iterator it) {
+    const bool ok = it->p->submitted ? it->p->ok : true;
+    for (const int32_t s : it->slots) {
+        if (s >= 0 && s < (int32_t) l.slot_batch.size()) {
+            l.slot_batch[s] = -1;
+        }
+        if (l.slot_state[s] != ST_LOADING) {
+            continue;
+        }
+        if (ok) {
+            l.slot_state[s] = ST_READY;
+        } else {
+            l.slot_state[s] = ST_EMPTY;
+            l.slot_expert[s] = -1;
+            l.last_use[s] = 0;
+            g.pf_failed++;
+        }
+    }
+    g.pf_batches[l.il].erase(it);
+    int active = 0;
+    for (const auto & b : g.pf_batches[l.il]) {
+        active += (int) b.slots.size();
+    }
+    return active;
+}
+
+// Drop completed prefetch batches. Does not wait.
+void prefetch_finalize(llama_moe_paging_layer & l) {
+    auto & bs = g.pf_batches[l.il];
+    for (auto it = bs.begin(); it != bs.end(); ) {
+        const bool done = it->p->submitted && (!it->p->async || it->p->batch.remaining.load() == 0);
+        if (!done) {
+            ++it;
+            continue;
+        }
+        if (it->p->async) {
+            it->p->ok = !it->p->batch.failed.load();
+            // Execution 016: the worker that completed the last task may still
+            // hold batch.m while remaining is already zero. Take the lock so the
+            // batch and its mutex are not erased under that worker.
+            std::lock_guard<std::mutex> lk(it->p->batch.m);
+        }
+        prefetch_close_batch(l, it);
+    }
+}
+
+// Authoritative demand joins the in-flight speculative batch that owns slot.
+// Execution 016: speculation is submitted one batch per expert, so this waits
+// only for the requested expert. Other speculative batches stay low priority.
+void prefetch_join(llama_moe_paging_layer & l, int32_t slot) {
+    auto & bs = g.pf_batches[l.il];
+    for (auto it = bs.begin(); it != bs.end(); ++it) {
+        bool has = false;
+        for (const int32_t s : it->slots) {
+            if (s == slot) {
+                has = true;
+                break;
+            }
+        }
+        if (!has) {
+            continue;
+        }
+        int unrelated = 0;
+        for (const auto & b : bs) {
+            if (&b == &(*it)) {
+                continue;
+            }
+            if (b.p->submitted && (!b.p->async || b.p->batch.remaining.load() > 0)) {
+                unrelated += (int) b.slots.size();
+            }
+        }
+        const double j0 = now_ms();
+        wait_read_tasks(*it->p);
+        g.ov_join_done_ms = std::max(g.ov_join_done_ms, it->p->batch.done_ms.load());
+        const double jdt = now_ms() - j0;
+        g.pf_join_batches++;
+        g.pf_join_wait_ms += jdt;
+        g.pf_join_wait_us.push_back(jdt * 1000.0);
+        g.pf_unrelated_active += (uint64_t) unrelated;
+        if (it->p->async) {
+            it->p->ok = !it->p->batch.failed.load();
+        }
+        prefetch_close_batch(l, it);
+        return;
+    }
+}
+
+// Use only observations from completed authoritative events. No backfill.
+bool prefetch_rank_admit(uint64_t observations, uint64_t useful) {
+    GGML_ASSERT(useful <= observations);
+    return observations < 16 || (unsigned __int128) 4 * useful >= (unsigned __int128) 3 * observations;
+}
+
+// Admission proxy only: useful head start versus wrong-read work extending
+// beyond the predicted routing window. Idle-window reads are not penalized.
+bool prefetch_time_admit(const moe_prefetch_nomination & nomination, double & gain_ms) {
+    GGML_ASSERT(nomination.useful <= nomination.observations);
+    gain_ms = 0.0;
+    if (nomination.observations < 16 || nomination.lead_samples < 16 || nomination.read_samples < 32 ||
+        !std::isfinite(nomination.read_ms) || nomination.read_ms <= 0.0 ||
+        !std::isfinite(nomination.lead_ms) || nomination.lead_ms <= 0.0 ||
+        !std::isfinite(nomination.queue_ms) || nomination.queue_ms < 0.0) { return true; }
+    const double probability = ((double) nomination.useful + 1.0) / ((double) nomination.observations + 2.0);
+    const double head_start = std::min(nomination.read_ms, std::max(0.0, nomination.lead_ms - nomination.queue_ms));
+    const double exposed_waste = std::max(0.0, nomination.queue_ms + nomination.read_ms - nomination.lead_ms);
+    gain_ms = probability * head_start - (1.0 - probability) * exposed_waste;
+    if (!std::isfinite(gain_ms)) { gain_ms = 0.0; return true; }
+    return gain_ms >= 0.0;
+}
+
+int prefetch_select(llama_moe_paging_layer & l, const int32_t * pool, int npool, int32_t * out) {
+    const double cpu0 = thread_cpu_ms();
+    GGML_ASSERT(l.pf_nomination_n == 0);
+    int n = 0;
+    double cost_ms = 0.0, queue_ms = 0.0;
+    uint64_t read_samples = 0;
+    if (g.pf_admission == "time_gate") {
+        double unit_ms;
+        { std::lock_guard<std::mutex> lk(g.hist_m);
+          unit_ms = g.pf_read_ms_per_byte; read_samples = g.pf_read_samples; }
+        uint64_t queued_bytes;
+        { std::lock_guard<std::mutex> lk(g.mtx);
+          queued_bytes = g.pf_active_bytes;
+          for (const auto & t : g.queue_hi) { queued_bytes += t.size; }
+          for (const auto & t : g.queue_lo) { queued_bytes += t.size; } }
+        // Aggregate service-work/QD proxy, not an observed completion deadline.
+        cost_ms = unit_ms * (double) g.record_stride / (double) g.qd;
+        queue_ms = unit_ms * (double) queued_bytes / (double) g.qd;
+    }
+    for (int i = 0; i < npool && l.pf_nomination_n < g.prefetch_p; i++) {
+        const int32_t e = pool[i];
+        g.pf_candidates++;
+        if (e < 0 || e >= g.n_expert) { continue; }
+        if (find_slot_state(l, e, ST_DEMAND) >= 0) { g.pf_skipped_demand++; continue; }
+        if (find_slot_state(l, e, ST_READY) >= 0 || find_slot_state(l, e, ST_LOADING) >= 0) { g.pf_skipped_existing++; continue; }
+        const int bin = std::min(i / 4, 3);
+        auto & nomination = l.pf_nominations[l.pf_nomination_n++];
+        nomination = {e, i + 1, false, false, l.pf_rank_observations[bin], l.pf_rank_useful[bin]};
+        nomination.decision_ms = g.pf_admission == "time_gate" ? now_ms() : 0.0;
+        if (g.pf_admission == "time_gate") {
+            GGML_ASSERT(i >= 0 && i < 16);
+            nomination.observations = l.pf_exact_rank_observations[i];
+            nomination.useful = l.pf_exact_rank_useful[i];
+            nomination.lead_ms = l.pf_lead_ewma_ms;
+            nomination.lead_samples = l.pf_lead_samples;
+            nomination.read_ms = cost_ms;
+            nomination.read_samples = read_samples;
+            nomination.queue_ms = queue_ms + n * cost_ms;
+            nomination.admitted = prefetch_time_admit(nomination, nomination.expected_gain_ms);
+        } else {
+            nomination.admitted = g.pf_admission == "all" || prefetch_rank_admit(nomination.observations, nomination.useful);
+        }
+        if (observer.mode) { moe_observe_record r; r.type=15; r.step=g.tokens; r.layer=l.il;
+            r.expert=e; r.component=i+1; r.bytes=nomination.observations; r.offset=(int64_t)nomination.useful;
+            r.flags=nomination.admitted?1:0; r.value=nomination.expected_gain_ms;
+            r.start_ms=r.end_ms=now_ms(); observer.emit(r); }
+        g.pf_gate_considered++;
+        if (nomination.admitted) { out[n++] = e; } else { g.pf_gate_rejected++; }
+    }
+    g.pf_gate_cpu_ms += thread_cpu_ms() - cpu0;
+    return n;
+}
+
+void prefetch_observe_nominations(llama_moe_paging_layer & l, const int32_t * req, int k, double authoritative_ms = 0.0) {
+    const double cpu0 = thread_cpu_ms();
+    for (int i = 0; i < l.pf_nomination_n; ++i) {
+        const auto & nomination = l.pf_nominations[i];
+        bool wanted = false;
+        for (int j = 0; j < k; ++j) { wanted |= req[j] == nomination.expert; }
+        const int bin = std::min((nomination.rank - 1) / 4, 3);
+        if (l.pf_rank_observations[bin] == UINT64_MAX) { GGML_ABORT("prefetch observation overflow"); }
+        ++l.pf_rank_observations[bin];
+        l.pf_rank_useful[bin] += wanted;
+        if (!nomination.admitted) { if (wanted) { ++g.pf_gate_rejected_useful; } else { ++g.pf_gate_rejected_wasted; } }
+        if (g.pf_admission == "time_gate") {
+            const int rank = nomination.rank - 1;
+            GGML_ASSERT(rank >= 0 && rank < 16);
+            if (l.pf_exact_rank_observations[rank] == UINT64_MAX) { GGML_ABORT("prefetch exact-rank overflow"); }
+            ++l.pf_exact_rank_observations[rank];
+            l.pf_exact_rank_useful[rank] += wanted;
+            const double actual_lead = std::max(0.0, authoritative_ms - nomination.decision_ms);
+            const double proxy = std::min(actual_lead, nomination.read_ms);
+            if (wanted && !nomination.admitted) { g.pf_rejected_useful_lead_proxy_ms += proxy; }
+            if (wanted && nomination.submitted) { g.pf_admitted_useful_lead_proxy_ms += proxy; }
+        }
+        if (g.pf_decisions_f) {
+            fprintf(g.pf_decisions_f, "%llu,%d,%d,%d,%d,%d,%d,%llu,%llu", (unsigned long long) g.tokens, l.il, nomination.expert, nomination.rank,
+                    nomination.admitted, nomination.submitted, wanted, (unsigned long long) nomination.observations, (unsigned long long) nomination.useful);
+            if (g.pf_admission == "time_gate") {
+                fprintf(g.pf_decisions_f, ",%.17g,%.17g,%.17g,%.17g,%.17g,%llu,%llu,%.17g",
+                        nomination.decision_ms, nomination.lead_ms, nomination.read_ms, nomination.queue_ms,
+                        nomination.expected_gain_ms, (unsigned long long) nomination.lead_samples,
+                        (unsigned long long) nomination.read_samples, std::max(0.0, authoritative_ms - nomination.decision_ms));
+            }
+            fprintf(g.pf_decisions_f, "\n");
+        }
+    }
+    // Update once per authoritative event, AFTER all decisions and labels.
+    if (g.pf_admission == "time_gate" && l.pf_nomination_n > 0) {
+        const double lead = std::max(0.0, authoritative_ms - l.pf_nominations[0].decision_ms);
+        if (std::isfinite(lead) && lead > 0.0) {
+            l.pf_lead_ewma_ms = l.pf_lead_samples == 0 ? lead : 0.875 * l.pf_lead_ewma_ms + 0.125 * lead;
+            if (l.pf_lead_samples == UINT64_MAX) { GGML_ABORT("prefetch lead sample overflow"); }
+            ++l.pf_lead_samples;
+        }
+    }
+    l.pf_nomination_n = 0;
+    g.pf_gate_cpu_ms += thread_cpu_ms() - cpu0;
+}
+
+// Execution 016 C1: FNV-1a over one submitted (token_event, layer, expert_id).
+void pf_seq_mix(uint64_t & h, uint64_t v) {
+    for (int b = 0; b < 8; b++) {
+        h ^= (v >> (8 * b)) & 0xffu;
+        h *= 1099511628211ULL;
+    }
+}
+
+// Submit the selected candidates. Execution 016 keeps one independently joinable
+// low-priority batch per expert, so a demand join waits only for its own expert.
+// LLAMA_MOE_PAGING_PREFETCH_SHARED=1 restores the single shared batch for the
+// equivalence measurement.
+void prefetch_submit(llama_moe_paging_layer & l, const int32_t * cand, int n) {
+    if (n <= 0) {
+        return;
+    }
+    if (g.prefetch_shared && !g.pf_batches[l.il].empty()) {
+        g.pf_skipped_busy += (uint64_t) n;
+        return;
+    }
+    // Execution 016: one batch per speculative expert. Each batch is joinable
+    // on its own, so a demand event waits only for the expert it asked for while
+    // the other speculative reads stay on the low-priority queue.
+    // LLAMA_MOE_PAGING_PREFETCH_SHARED=1 restores one shared batch
+    // (Execution 015 behavior) for the equivalence check.
+    struct submit_group {
+        std::vector<int32_t> slots;
+        std::vector<io_task> tasks;
+    };
+    std::vector<submit_group> groups;
+    for (int i = 0; i < n; i++) {
+        const int s = find_empty_slot(l);
+        if (s < 0) {
+            g.pf_skipped_busy++;
+            continue;
+        }
+        for (int j = 0; j < l.pf_nomination_n; ++j) {
+            if (l.pf_nominations[j].expert == cand[i]) { l.pf_nominations[j].submitted = true; }
+        }
+        l.slot_expert[s] = cand[i];
+        l.slot_state[s] = ST_LOADING;
+        l.pf_submit_ms[s] = now_ms();
+        std::vector<io_task> etasks;
+        build_read_tasks(l, cand[i], s, etasks);
+        size_t bytes = 0;
+        for (const auto & t : etasks) {
+            bytes += t.size;
+        }
+        g.pf_submitted_bytes += (uint64_t) bytes;
+        g.prefetch_read_bytes += (uint64_t) g.record_stride;
+        g.pf_submitted_experts++;
+        // Diagnostic identity hash, in exact submission order.
+        pf_seq_mix(g.pf_seq_hash, (uint64_t) g.tokens);
+        pf_seq_mix(g.pf_seq_hash, (uint64_t) (uint32_t) l.il);
+        pf_seq_mix(g.pf_seq_hash, (uint64_t) (uint32_t) cand[i]);
+        g.pf_seq_n++;
+        if (g.pf_seq_f != nullptr) {
+            fprintf(g.pf_seq_f, "%llu,%d,%d\n",
+                    (unsigned long long) g.tokens, l.il, cand[i]);
+        }
+        // Shared mode merges every expert into the first group; the default
+        // opens a new group per expert. Index, not a reference: push_back may
+        // reallocate and invalidate a reference held across the loop.
+        if (!g.prefetch_shared || groups.empty()) {
+            groups.emplace_back();
+        }
+        submit_group & grp = groups.back();
+        grp.slots.push_back(s);
+        std::shared_ptr<tl_expert_rec> rec;
+        if (g.timeline) {
+            rec = std::make_shared<tl_expert_rec>();
+            if (g.tl_slot_rec.size() <= (size_t) l.il) {
+                g.tl_slot_rec.resize((size_t) l.il + 1);
+            }
+            if (g.tl_slot_rec[l.il].size() <= (size_t) s) {
+                g.tl_slot_rec[l.il].resize((size_t) l.n_slots);
+            }
+            g.tl_slot_rec[l.il][s] = rec;
+        }
+        for (auto & t : etasks) {
+            t.slot = s;
+            if (g.timeline) {
+                t.tl_rec = &rec->kind[t.kind];
+            }
+            grp.tasks.push_back(t);
+        }
+    }
+    for (auto & grp : groups) {
+        auto p = std::make_unique<read_pending>();
+        submit_read_tasks(grp.tasks, *p, /*high=*/false);
+        prefetch_batch pb;
+        pb.p = std::move(p);
+        pb.slots = grp.slots;
+        for (const int32_t s : pb.slots) {
+            l.slot_batch[s] = (int32_t) g.pf_batches[l.il].size();
+        }
+        g.pf_batches[l.il].push_back(std::move(pb));
+        g.pf_expert_batches++;
+        if (g.prefetch_shared) {
+            g.pf_shared_batches++;
+        }
+    }
+}
+
+// Layer-start A0 event: drop stale READY entries, then record or submit Top-P.
+void prefetch_event(llama_moe_paging_layer & l, const int32_t * pool, int npool) {
+    prefetch_finalize(l);
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] == ST_READY) {
+            l.slot_state[s] = ST_EMPTY;
+            l.slot_expert[s] = -1;
+            l.last_use[s] = 0;
+            g.pf_wasted++;
+            g.pf_evicted_unused++;
+        }
+    }
+    int32_t cand[MAX_K];
+    const int n = prefetch_select(l, pool, npool, cand);
+    if (g.prefetch_mode == "a0_shadow") {
+        l.pf_cand_n = n;
+        for (int i = 0; i < n; i++) {
+            l.pf_cand[i] = cand[i];
+        }
+        g.pf_shadow_cand += (uint64_t) n;
+        return;
+    }
+    prefetch_submit(l, cand, n);
+}
+
+// Independent demand-only M-slot LRU over expert ids, used to assert that the
+// physical DEMAND set stayed identical to demand-only.
+int shadow_step(llama_moe_paging_layer & l, const int32_t * req, int k, bool * is_miss) {
+    const int M = g.demand_slots;
+    if (g.policy == "frequency_age") {
+        observe_demand_history(l.shadow_frequency, l.shadow_last_event, l.events + 1, req, k);
+    }
+    std::vector<uint8_t> reserved((size_t) M, 0);
+    int n_miss = 0;
+    for (int i = 0; i < k; i++) {
+        const int idx = [&] {
+            for (int j = 0; j < l.shadow_n; j++) {
+                if (l.shadow_expert[j] == req[i]) {
+                    return j;
+                }
+            }
+            return -1;
+        }();
+        if (idx >= 0) {
+            is_miss[i] = false;
+            reserved[idx] = 1;
+        } else {
+            is_miss[i] = true;
+            n_miss++;
+        }
+    }
+    // hits refresh first, then admissions, mirroring the demand-only clock order
+    for (int i = 0; i < k; i++) {
+        if (is_miss[i]) {
+            continue;
+        }
+        for (int j = 0; j < l.shadow_n; j++) {
+            if (l.shadow_expert[j] == req[i]) {
+                l.shadow_last_use[j] = ++g.clock;
+                break;
+            }
+        }
+    }
+    for (int i = 0; i < k; i++) {
+        if (!is_miss[i]) {
+            continue;
+        }
+        int victim = -1;
+        if (l.shadow_n < M) {
+            victim = l.shadow_n++;
+        } else {
+            for (int j = 0; j < l.shadow_n; j++) {
+                if (reserved[j]) {
+                    continue;
+                }
+                if (victim < 0 || (g.policy == "frequency_age" ?
+                    frequency_age_less(l.shadow_frequency, l.shadow_last_event, l.events + 1,
+                                       l.shadow_expert[j], l.shadow_expert[victim], l.shadow_last_use[j], l.shadow_last_use[victim]) :
+                    l.shadow_last_use[j] < l.shadow_last_use[victim])) {
+                    victim = j;
+                }
+            }
+        }
+        if (victim < 0) {
+            GGML_ABORT("moe paging shadow: no victim (M=%d misses=%d)", M, n_miss);
+        }
+        reserved[victim] = 1;
+        l.shadow_expert[victim] = req[i];
+        l.shadow_last_use[victim] = ++g.clock;
+    }
+    return n_miss;
+}
+
+void shadow_check(const llama_moe_paging_layer & l) {
+    int n = 0;
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_state[s] != ST_DEMAND) {
+            continue;
+        }
+        n++;
+        bool found = false;
+        for (int j = 0; j < l.shadow_n; j++) {
+            if (l.shadow_expert[j] == l.slot_expert[s]) {
+                found = true;
+                break;
+            }
+        }
+        if (!found) {
+            g.shadow_fail++;
+            GGML_ABORT("moe paging shadow: physical DEMAND expert %d not in demand-only set (layer %d)",
+                       l.slot_expert[s], l.il);
+        }
+    }
+    if (n != l.shadow_n) {
+        g.shadow_fail++;
+        GGML_ABORT("moe paging shadow: %d physical DEMAND slots != shadow %d (layer %d)",
+                   n, l.shadow_n, l.il);
+    }
+    for (int j = 0; j < l.shadow_n; j++) {
+        if (find_slot_state(l, l.shadow_expert[j], ST_DEMAND) < 0) {
+            g.shadow_fail++;
+            GGML_ABORT("moe paging shadow: demand-only expert %d missing from physical DEMAND (layer %d)",
+                       l.shadow_expert[j], l.il);
+        }
+    }
+    g.shadow_checks++;
+}
+
+// One representation-aware leaf shared by normal and already-ready expert work.
+// It never reads another expert file or materializes an original component.
+void tile_compute(const char * packed, const void * q8, float * out,
+                  int rows, int blocks, bool q6, ggml_vec_dot_t native_dot, int lane) {
+    GGML_ASSERT(lane >= 0 && lane < 24 && rows > 0 && rows % 16 == 0 && blocks <= 8);
+    auto & metric = g.tile_counts[lane];
+    ++metric.chunks; metric.rows += rows;
+    if (!moe_tiled_dot((const uint8_t *) packed, q8, out, rows, blocks, 16, q6)) {
+        ++metric.fallback_chunks;
+        alignas(16) std::array<uint8_t, 1152> scratch;
+        if (!moe_tiled_reference_dot((const uint8_t *) packed, q8, out, rows, blocks,
+                                    16, q6, native_dot, scratch.data(), scratch.size())) {
+            GGML_ABORT("tile16 inverse-row fallback rejected geometry");
+        }
+    }
+}
+
+void tile_admit() {
+#ifdef __APPLE__
+    // This version supports exactly the audited Qwen GGUF and bijective tile16 file.
+    // No environment variable can disable or replace the full payload SHA check.
+    constexpr const char * model_sha = "f5ee307a2982106a6eb82b62b2c00b575c9072145a759ae4660378acda8dcf2d";
+    constexpr const char * sidecar_sha = "e3dfd7ff1c930f665bdd45f45615d40eeaef40cede7f4eb8dfda1808dcf2d245";
+    constexpr const char * offsets_sha = "d0634f26c62a91a1d6157f117cd10e8c59f62c2ce39e3bcf221f5b1f27ef90d9";
+    const double t0 = now_ms();
+    std::array<uint8_t, 4096> header{};
+    struct stat before{}, after{};
+    if (fstat(g.gguf_fd, &before) || before.st_size != 23938321664LL ||
+        (before.st_mode & 0222) || pread(g.gguf_fd, header.data(), header.size(), 0) != ssize_t(header.size())) {
+        GGML_ABORT("tile16 requires the completed read-only supported sidecar");
+    }
+    const uint32_t expected[4] = {1, 16, 30720, 108};
+    if (memcmp(header.data(), "MOETIL16", 8) || memcmp(header.data()+8, expected, sizeof(expected)) ||
+        memcmp(header.data()+32, model_sha, 64)) { GGML_ABORT("tile16 sidecar header/model mismatch"); }
+    auto hash_fd = [&](int fd, uint64_t bytes) {
+        std::array<uint8_t, 262144> buffer{}; CC_SHA256_CTX ctx; CC_SHA256_Init(&ctx);
+        for (uint64_t pos = 0; pos < bytes;) {
+            const size_t count = std::min<uint64_t>(buffer.size(), bytes-pos);
+            const ssize_t got = pread(fd, buffer.data(), count, pos);
+            if (got <= 0) { GGML_ABORT("tile16 admission read failed"); }
+            CC_SHA256_Update(&ctx, buffer.data(), CC_LONG(got)); pos += uint64_t(got);
+        }
+        std::array<uint8_t, 32> digest{}; CC_SHA256_Final(digest.data(), &ctx);
+        std::string result; for (auto x : digest) { result += "0123456789abcdef"[x>>4]; result += "0123456789abcdef"[x&15]; }
+        return result;
+    };
+    if (hash_fd(g.gguf_fd, before.st_size) != sidecar_sha) { GGML_ABORT("tile16 payload SHA mismatch"); }
+    const std::string offsets = getenv_str("LLAMA_MOE_PAGING_OFFSETS", "results/gguf_expert_offsets.csv");
+    const int fd = open(offsets.c_str(), O_RDONLY); struct stat csv{};
+    if (fd < 0 || fstat(fd, &csv) || hash_fd(fd, csv.st_size) != offsets_sha) { GGML_ABORT("tile16 offsets SHA mismatch"); }
+    close(fd);
+    if (fstat(g.gguf_fd, &after) || before.st_size != after.st_size ||
+        before.st_mtimespec.tv_sec != after.st_mtimespec.tv_sec || before.st_mtimespec.tv_nsec != after.st_mtimespec.tv_nsec ||
+        before.st_ctimespec.tv_sec != after.st_ctimespec.tv_sec || before.st_ctimespec.tv_nsec != after.st_ctimespec.tv_nsec) {
+        GGML_ABORT("tile16 artifact changed during admission");
+    }
+    g.tile_admission_bytes = uint64_t(before.st_size) + uint64_t(csv.st_size);
+    g.tile_admission_ms = now_ms()-t0;
+    LLAMA_LOG_INFO("tile16: complete immutable payload admission %.3f ms (%llu bytes, startup only)\n",
+                   g.tile_admission_ms, (unsigned long long)g.tile_admission_bytes);
+#else
+    GGML_ABORT("tile16 verified sidecar admission currently requires macOS");
+#endif
+}
+
+// Authoritative demand event under protected probation.
+// Execution 017 Part D: exact full contribution of the already-ready selected experts,
+// computed while the authoritative cold reads are in flight. Raw down outputs are stored
+// per selected position; the graph matmul hook skips these positions and the down hook
+// injects the stored columns so the canonical accumulation order is unchanged.
+void early_compute_ready(llama_moe_paging_layer & l, int k,
+                         const bool * is_demand, const int * hit_slot,
+                         const int * pf_slot, const bool * pf_was_loading) {
+    std::fill(l.early_ready, l.early_ready + 8, false);
+    l.early_n = 0;
+    if (!g.overlap_enabled || !l.early_in) { return; }
+    GGML_ASSERT(k <= 8 && l.early_in->type == GGML_TYPE_F32);
+    bool any_ready = false;
+    for (int i = 0; i < k; ++i) { any_ready |= is_demand[i] || (pf_slot[i] >= 0 && !pf_was_loading[i]); }
+    if (!any_ready) { ++g.ov_masks[0]; return; }
+    const auto * wg = l.slot_gate; const auto * wu = l.slot_up; const auto * wd = l.slot_down;
+    GGML_ASSERT(wg && wu && wd);
+    const int n_in = wg->ne[0], n_ff = wg->ne[1], n_emb = wd->ne[1];
+    const auto gv = ggml_get_type_traits_cpu(wg->type)->vec_dot_type;
+    const auto uv = ggml_get_type_traits_cpu(wu->type)->vec_dot_type;
+    const auto dv = ggml_get_type_traits_cpu(wd->type)->vec_dot_type;
+    const auto vg = ggml_get_type_traits_cpu(wg->type)->vec_dot;
+    const auto vu = ggml_get_type_traits_cpu(wu->type)->vec_dot;
+    const auto vd = ggml_get_type_traits_cpu(wd->type)->vec_dot;
+    const size_t rs_g = ggml_row_size(gv, n_in), rs_u = ggml_row_size(uv, n_in);
+    const size_t rs_d = ggml_row_size(dv, n_ff);
+    g.ov_inbuf.resize(rs_g); g.ov_upinbuf.resize(rs_u);
+    g.ov_actbuf.resize(k * rs_d);
+    g.ov_fbuf.resize(k * (size_t) n_ff);
+    l.early_gate.resize(k * (size_t) n_ff); l.early_up.resize(k * (size_t) n_ff);
+    l.early_out.resize(k * (size_t) n_emb);
+    l.early_act.resize(k * (size_t) n_ff);
+    const double conv_cpu = thread_cpu_ms();
+    ggml_get_type_traits_cpu(gv)->from_float((const float *) l.early_in->data, g.ov_inbuf.data(), n_in);
+    if (uv != gv) {
+        ggml_get_type_traits_cpu(uv)->from_float((const float *) l.early_in->data, g.ov_upinbuf.data(), n_in);
+    }
+    const double extra_conversion_cpu = thread_cpu_ms() - conv_cpu;
+    g.ov_dup_cpu_ms += extra_conversion_cpu;
+    g.ov_dup_ms += extra_conversion_cpu;
+    ++g.ov_dup_experts;
+    g.ov_cpu_ms += extra_conversion_cpu;
+    int slots[8];
+    unsigned mask = 0;
+    for (int i = 0; i < k; ++i) {
+        l.early_ready[i] = is_demand[i] || (pf_slot[i] >= 0 && !pf_was_loading[i]);
+        slots[i] = is_demand[i] ? hit_slot[i] : pf_slot[i];
+        if (l.early_ready[i]) { GGML_ASSERT(slots[i] >= 0 && slots[i] < wg->ne[2]); mask |= 1u << i; ++l.early_n; }
+    }
+    ++g.ov_masks[mask];
+    double lane_cpu[8] = {};
+    resident_parallel([&](int lane) {
+        const double cpu0 = thread_cpu_ms();
+        for (int i = lane; i < k; i += g.ov_threads) {
+            if (!l.early_ready[i]) { continue; }
+            l.early_start[i] = now_ms();
+            float * gate = l.early_gate.data() + (size_t) i * n_ff;
+            float * up = l.early_up.data() + (size_t) i * n_ff;
+            float * act = l.early_act.data() + (size_t) i * n_ff;
+            const char * gw = (const char *) wg->data + (size_t) slots[i] * wg->nb[2];
+            const char * uw = (const char *) wu->data + (size_t) slots[i] * wu->nb[2];
+            const char * dw = (const char *) wd->data + (size_t) slots[i] * wd->nb[2];
+            if (g.tile16) {
+                tile_compute(gw, g.ov_inbuf.data(), gate, n_ff, n_in/256, false, vg, 16+lane);
+                tile_compute(uw, uv == gv ? g.ov_inbuf.data() : g.ov_upinbuf.data(), up, n_ff, n_in/256, false, vu, 16+lane);
+            } else {
+            for (int r = 0; r < n_ff; ++r) {
+                vg(n_in, gate + r, 0, gw + r * wg->nb[1], 0, g.ov_inbuf.data(), 0, 1);
+                vu(n_in, up + r, 0, uw + r * wu->nb[1], 0,
+                   uv == gv ? g.ov_inbuf.data() : g.ov_upinbuf.data(), 0, 1);
+            }
+            }
+            l.early_act_start[i] = now_ms();
+            ggml_vec_swiglu_f32(n_ff, act, gate, up);
+            l.early_act_end[i] = now_ms();
+            auto * cd = g.ov_actbuf.data() + (size_t) i * rs_d;
+            ggml_get_type_traits_cpu(dv)->from_float(act, cd, n_ff);
+            float * out = l.early_out.data() + (size_t) i * n_emb;
+            if (g.tile16) { tile_compute(dw, cd, out, n_emb, n_ff/256, true, vd, 16+lane); }
+            else { for (int r = 0; r < n_emb; ++r) { vd(n_ff, out + r, 0, dw + r * wd->nb[1], 0, cd, 0, 1); } }
+            l.early_end[i] = now_ms();
+            if (observer.mode) { moe_observe_record r; r.type=5; r.step=g.tokens; r.layer=l.il;
+                r.expert=(size_t)slots[i]<l.slot_expert.size()?l.slot_expert[slots[i]]:-1; r.component=i; r.worker=lane;
+                r.start_ms=l.early_start[i]; r.end_ms=l.early_end[i]; observer.emit(r); }
+        }
+        lane_cpu[lane] = thread_cpu_ms() - cpu0;
+    });
+    for (int lane = 0; lane < g.ov_threads; ++lane) {
+        g.ov_cpu_ms += lane_cpu[lane];
+    }
+    size_t scratch = g.ov_fbuf.capacity() * sizeof(float) + g.ov_inbuf.capacity() +
+        g.ov_upinbuf.capacity() + g.ov_actbuf.capacity();
+    for (const auto & layer : g.layers) {
+        scratch += (layer.early_gate.capacity() + layer.early_up.capacity() + layer.early_out.capacity() + layer.early_act.capacity()) * sizeof(float);
+    }
+    g.ov_scratch_bytes = std::max(g.ov_scratch_bytes, (int64_t) scratch);
+}
+
+// Union of useful expert intervals intersected with still-pending authoritative I/O.
+// Includes exact activation, which the graph reuses instead of recomputing.
+double early_interval_overlap(const llama_moe_paging_layer & l, double submit, double done) {
+    std::vector<std::pair<double, double>> spans;
+    for (int i = 0; i < 8; ++i) {
+        if (!l.early_ready[i]) { continue; }
+        auto span = std::make_pair(std::max(l.early_start[i], submit), std::min(l.early_end[i], done));
+        if (span.second > span.first) { spans.push_back(span); }
+    }
+    std::sort(spans.begin(), spans.end());
+    double total = 0, end = submit;
+    for (const auto & span : spans) {
+        total += std::max(0.0, span.second - std::max(end, span.first));
+        end = std::max(end, span.second);
+    }
+    return total;
+}
+
+void stage_event_prefetch(llama_moe_paging_layer & l, const int32_t * req, int k, int32_t * out_slot) {
+    const double demand_t0 = now_ms();
+    // any completed speculative batch is READY before the router request is served
+    prefetch_finalize(l);
+    if (l.a0_ready_ms > 0.0) {
+        g.a0_lead_us.push_back((demand_t0 - l.a0_ready_ms) * 1000.0);
+        l.a0_ready_ms = 0.0;
+    }
+    uint64_t tl_ev = 0;
+    if (g.timeline) {
+        l.tl_router_ms = demand_t0;
+        g.tl_layer_events++;
+        tl_ev = g.tl_event_seq++;
+        double a0dt = 0.0, attndt = 0.0;
+        if (l.tl_start_ms > 0.0 && l.tl_a0_ms > 0.0) {
+            a0dt = l.tl_a0_ms - l.tl_start_ms;
+            attndt = demand_t0 - l.tl_a0_ms;
+            g.tl_a0_ms += a0dt;
+            g.tl_a0_n++;
+            g.tl_attn_router_ms += attndt;
+            g.tl_attn_router_n++;
+        }
+        g.tl_event_step.push_back(g.tokens);
+        g.tl_event_a0_ms.push_back(a0dt);
+        g.tl_event_attn_ms.push_back(attndt);
+    }
+    if (observer.mode) {
+        for (int i=0;i<k;++i) { moe_observe_record r; r.type=2; r.step=g.tokens;
+            r.layer=l.il; r.expert=req[i]; r.component=i;
+            r.offset=find_slot_state(l,req[i],ST_DEMAND); r.flags=r.offset>=0?1:0;
+            if(r.offset<0) { r.offset=find_slot_state(l,req[i],ST_READY); if(r.offset>=0) { r.flags=2; } }
+            if(r.offset<0) { r.offset=find_slot_state(l,req[i],ST_LOADING); if(r.offset>=0) { r.flags=3; } }
+            if(r.offset<0) { r.flags=4; }
+            r.start_ms=r.end_ms=demand_t0; observer.emit(r); }
+    }
+    prefetch_observe_nominations(l, req, k, demand_t0);
+    const bool decay = g.policy == "event_decay90";
+    if (decay) {
+        for (int s = 0; s < l.n_slots; s++) {
+            l.score[s] *= 0.90;
+        }
+    }
+
+    if (g.policy == "frequency_age") {
+        observe_demand_history(l.demand_frequency, l.demand_last_event, l.events + 1, req, k);
+    }
+
+    int  hit_slot[MAX_K];
+    int  pf_slot[MAX_K];
+    bool is_demand[MAX_K];
+    bool pf_was_loading[MAX_K];
+    for (int i = 0; i < k; i++) {
+        hit_slot[i] = find_slot_state(l, req[i], ST_DEMAND);
+        is_demand[i] = hit_slot[i] >= 0;
+        pf_slot[i] = -1;
+        pf_was_loading[i] = false;
+        if (!is_demand[i]) {
+            pf_slot[i] = find_slot_state(l, req[i], ST_READY);
+            if (pf_slot[i] >= 0) {
+                g.pf_ready_at_demand++;
+            } else {
+                pf_slot[i] = find_slot_state(l, req[i], ST_LOADING);
+                pf_was_loading[i] = pf_slot[i] >= 0;
+                if (pf_was_loading[i]) {
+                    g.pf_loading_at_demand++;
+                }
+            }
+        }
+    }
+    if (g.timeline) {
+        int n_res = 0, n_rdy = 0, n_ldg = 0, n_ord = 0;
+        for (int i = 0; i < k; i++) {
+            if (is_demand[i]) { n_res++; }
+            else if (pf_was_loading[i]) { n_ldg++; }
+            else if (pf_slot[i] >= 0) { n_rdy++; }
+            else { n_ord++; }
+        }
+        g.tl_resident_sel += (uint64_t) n_res;
+        g.tl_ready_sel += (uint64_t) n_rdy;
+        g.tl_loading_sel += (uint64_t) n_ldg;
+        g.tl_ordinary_sel += (uint64_t) n_ord;
+        g.tl_resident_hist[std::min(n_res, 8)]++;
+        g.tl_event_resident.push_back(n_res);
+        g.tl_event_ready.push_back(n_rdy);
+        g.tl_event_loading.push_back(n_ldg);
+        g.tl_event_ordinary.push_back(n_ord);
+        g.tl_requested_bytes += (uint64_t) k * (uint64_t) g.record_stride;
+        const uint64_t n_cold = (uint64_t) (k - n_res);
+        g.tl_miss_gate_bytes += n_cold * (uint64_t) l.gate_bytes;
+        g.tl_miss_up_bytes += n_cold * (uint64_t) l.up_bytes;
+        g.tl_miss_down_bytes += n_cold * (uint64_t) l.down_bytes;
+    }
+
+    // a0_shadow evidence: candidates the native router then requested
+    if (g.prefetch_mode == "a0_shadow" && l.pf_cand_n > 0) {
+        for (int j = 0; j < l.pf_cand_n; j++) {
+            for (int i = 0; i < k; i++) {
+                if (req[i] == l.pf_cand[j]) {
+                    g.pf_shadow_useful++;
+                    break;
+                }
+            }
+        }
+    }
+
+    // reserve this event's demand hits so no victim evicts them
+    std::vector<uint8_t> dres((size_t) l.n_slots, 0);
+    for (int i = 0; i < k; i++) {
+        if (is_demand[i]) {
+            dres[hit_slot[i]] = 1;
+        }
+    }
+
+    // logical M-slot admission plan; identical to demand-only. An empty slot is
+    // used only while the logical set is below M; extra misses evict the LRU.
+    const int M = g.demand_slots;
+    int running_demand = l.demand_count;
+    int victim[MAX_K];
+    for (int i = 0; i < k; i++) {
+        if (is_demand[i]) {
+            continue;
+        }
+        int v = -1;
+        if (running_demand < M) {
+            v = find_empty_slot_ex(l, dres.data());
+            if (v >= 0) {
+                running_demand++;
+            }
+        }
+        if (v < 0) {
+            v = pick_demand_victim(l, dres.data());
+        }
+        if (v < 0) {
+            GGML_ABORT("moe paging prefetch: no demand victim (M=%d misses=%d)", M, k);
+        }
+        dres[v] = 1;
+        victim[i] = v;
+    }
+
+    // ordinary demand reads for experts not served by probation
+    std::vector<io_task> tasks;
+    for (int i = 0; i < k; i++) {
+        if (is_demand[i] || pf_slot[i] >= 0) {
+            continue;
+        }
+        build_read_tasks(l, req[i], victim[i], tasks);
+    }
+    if (g.timeline) {
+        for (auto & t : tasks) {
+            t.event_id = tl_ev;
+        }
+    }
+
+    const double wait0 = now_ms();
+    if (g.timeline) {
+        l.tl_demand_submit_ms = wait0;
+    }
+    read_pending rp;
+    if (!tasks.empty()) {
+        submit_read_tasks(tasks, rp, /*high=*/true);
+    }
+    // promote not-yet-started speculative components, then join the same batch
+    for (int i = 0; i < k; i++) {
+        if (pf_was_loading[i]) {
+            promote_prefetch_tasks(l, req[i]);
+        }
+    }
+    g.ov_join_done_ms = 0.0;
+    const bool has_cold = !tasks.empty() || std::any_of(pf_was_loading, pf_was_loading + k, [](bool v) { return v; });
+    std::fill(l.early_ready, l.early_ready + 8, false); l.early_n = 0;
+    const double early_start = now_ms();
+    const double early_cpu0 = g.ov_cpu_ms, dup_cpu0 = g.ov_dup_cpu_ms;
+    // Execution 018: no early work when all selected weights are already ready.
+    if (g.overlap_enabled && has_cold) {
+        const double ov_t0 = now_ms();
+        early_compute_ready(l, k, is_demand, hit_slot, pf_slot, pf_was_loading);
+        g.ov_ms += now_ms() - ov_t0;
+        if (l.early_n > 0) {
+            g.ov_events++;
+            g.ov_experts += (uint64_t) l.early_n;
+            // Only input conversion is duplicated; activation is reused exactly.
+        }
+    }
+    const double early_end = now_ms();
+    const double join_start = now_ms();
+    for (int i = 0; i < k; i++) {
+        if (!pf_was_loading[i]) {
+            continue;
+        }
+        prefetch_join(l, pf_slot[i]);
+        if (g.timeline && (size_t) l.il < g.tl_slot_rec.size() &&
+                (size_t) pf_slot[i] < g.tl_slot_rec[l.il].size()) {
+            const std::shared_ptr<tl_expert_rec> & rec = g.tl_slot_rec[l.il][pf_slot[i]];
+            if (rec) {
+                record_expert_components(tl_ev, rec.get(), pf_slot[i], req[i]);
+            }
+        }
+        if (l.slot_state[pf_slot[i]] != ST_READY) {
+            // fail closed: a speculative read error that became authoritative
+            GGML_ABORT("moe paging prefetch: speculative read failed and became demand (layer %d expert %d)",
+                       l.il, req[i]);
+        }
+    }
+    const bool ord_ok = wait_read_tasks(rp);
+    const double unblock = now_ms();
+    const double wait_dt = unblock - wait0;
+    const double idle_wait = unblock - join_start;
+    const double cold_done = has_cold ? std::max(rp.batch.done_ms.load(), g.ov_join_done_ms) : wait0;
+    GGML_ASSERT(!has_cold || cold_done > 0.0);
+    const double achieved = has_cold ? early_interval_overlap(l, wait0, cold_done) : 0.0;
+    int finished = 0, outstanding = 0;
+    for (int i = 0; i < k; ++i) {
+        if (!l.early_ready[i]) { continue; }
+        if (l.early_end[i] <= cold_done) { ++finished; } else { ++outstanding; }
+    }
+    g.ov_ready_before_unblock += finished; g.ov_ready_outstanding += outstanding;
+    g.ov_achieved_ms += achieved; g.ov_idle_wait_ms += idle_wait;
+    if (g.ov_event_file) {
+        fprintf(g.ov_event_file, "%llu,%d,%d,%d,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%.6f,%d,%d,%.6f\n",
+            (unsigned long long) g.tokens, l.il, l.early_n, has_cold ? 1 : 0,
+            wait0, cold_done, early_start, early_end, g.ov_cpu_ms - early_cpu0,
+            achieved, idle_wait, finished, outstanding, g.ov_dup_cpu_ms - dup_cpu0);
+    }
+    if (g.timeline) {
+        l.tl_demand_unblock_ms = now_ms();
+        g.tl_demand_io_ms += wait_dt;
+        g.tl_demand_io_n++;
+        g.tl_event_io_ms.push_back(wait_dt);
+        g.tl_event_submit_ms.push_back(wait0);
+    }
+    if (!tasks.empty() && !ord_ok) {
+        LLAMA_LOG_ERROR("%s: cannot read the full demand read set (layer %d, %d reads)\n",
+                        __func__, l.il, (int) tasks.size());
+        GGML_ABORT("moe paging: incomplete demand read set; refusing to run with partial weights");
+    }
+    l.read_wait_ms += wait_dt;
+    l.fault_ms += wait_dt;
+    g.demand_blocking_wait_ms += wait_dt;
+    g.demand_wait_events++;
+
+    bool shadow_miss[MAX_K] = {};
+    const int n_logical_miss = shadow_step(l, req, k, shadow_miss);
+
+    // commit hits first, then admissions, mirroring the demand-only clock order
+    for (int i = 0; i < k; i++) {
+        if (!is_demand[i]) {
+            continue;
+        }
+        const int s = hit_slot[i];
+        l.last_use[s] = ++g.clock;
+        if (decay) {
+            l.score[s] += 1.0;
+        }
+        l.hits++;
+        g.logical_hits++;
+        out_slot[i] = s;
+    }
+    for (int i = 0; i < k; i++) {
+        if (is_demand[i]) {
+            continue;
+        }
+        const int v = victim[i];
+        if (pf_slot[i] >= 0) {
+            const int ps = pf_slot[i];
+            const double submit_at = l.pf_submit_ms[ps];
+            l.slot_state[ps] = ST_DEMAND;
+            l.slot_expert[ps] = req[i];
+            l.last_use[ps] = ++g.clock;
+            l.score[ps] = decay ? 1.0 : 0.0;
+            l.pf_submit_ms[ps] = 0.0;
+            // logical demand victim becomes EMPTY probation capacity, no weight copy
+            l.slot_state[v] = ST_EMPTY;
+            l.slot_expert[v] = -1;
+            l.last_use[v] = 0;
+            l.score[v] = 0.0;
+            if (l.demand_count < M) {
+                l.demand_count++;
+            }
+            if (submit_at > 0.0) {
+                g.pf_lead_us.push_back((demand_t0 - submit_at) * 1000.0);
+            }
+            if (pf_was_loading[i]) {
+                g.pf_join_useful++;
+            } else {
+                g.pf_ready_useful++;
+            }
+            g.pf_promotions++;
+            out_slot[i] = ps;
+        } else {
+            l.slot_state[v] = ST_DEMAND;
+            l.slot_expert[v] = req[i];
+            l.last_use[v] = ++g.clock;
+            l.score[v] = decay ? 1.0 : 0.0;
+            if (l.demand_count < M) {
+                l.demand_count++;
+            }
+            l.bytes_read += (uint64_t) g.record_stride;
+            g.demand_read_bytes += (uint64_t) g.record_stride;
+            out_slot[i] = v;
+        }
+        l.misses++;
+        g.logical_misses++;
+    }
+    l.miss_hist[std::min(k, 8)]++;
+    l.events++;
+    l.direct_calls++;
+    l.compute_start_ms = now_ms();
+
+    if (g.prefetch_mode == "a0_shadow") {
+        g.pf_shadow_misses += (uint64_t) n_logical_miss;
+    }
+    {
+        uint64_t occ = 0;
+        for (int s = 0; s < l.n_slots; s++) {
+            if (l.slot_state[s] == ST_READY || l.slot_state[s] == ST_LOADING) {
+                occ++;
+            }
+        }
+        g.pf_occupancy_sum += occ;
+        g.demand_occupancy_sum += (uint64_t) l.demand_count;
+        g.occupancy_samples++;
+    }
+    if (g.shadow_assert) {
+        for (int i = 0; i < k; i++) {
+            if (shadow_miss[i] == is_demand[i]) {
+                g.shadow_fail++;
+                GGML_ABORT("moe paging shadow: classification mismatch at layer %d expert %d",
+                           l.il, req[i]);
+            }
+        }
+        shadow_check(l);
+    }
+    if (g.assert_checks) {
+        for (int j = 0; j < k; j++) {
+            const int s = out_slot[j];
+            if (!(s >= 0 && s < l.n_slots)) {
+                GGML_ABORT("moe paging assert: slot %d out of range", s);
+            }
+            if (l.slot_expert[s] != req[j]) {
+                GGML_ABORT("moe paging assert: slot %d holds expert %d, expected %d",
+                           s, l.slot_expert[s], req[j]);
+            }
+            for (int q = 0; q < j; q++) {
+                if (out_slot[q] == s) {
+                    GGML_ABORT("moe paging assert: slot %d assigned twice", s);
+                }
+            }
+        }
+    }
+}
+
+// Oracle probation event: pick up to P actual current-layer demand misses from the
+// captured route trace and push them through the same probation plumbing.
+void prefetch_oracle_event(llama_moe_paging_layer & l) {
+    if (!g.oracle_enabled) {
+        return;
+    }
+    const int64_t ev = (int64_t) g.tokens * (int64_t) g.n_layer + l.il;
+    const int64_t total = (int64_t) g.oracle_n_token * (int64_t) g.n_layer;
+    if (ev < 0 || ev >= total) {
+        GGML_ABORT("moe prefetch oracle: route trace exhausted at token %llu layer %d",
+                   (unsigned long long) g.tokens, l.il);
+    }
+    const int k = g.oracle_k;
+    int32_t req[8];
+    for (int i = 0; i < k; i++) {
+        req[i] = g.oracle_routes[(size_t) ev * (size_t) k + i];
+    }
+    int32_t cand[32];
+    int nc = 0;
+    for (int i = 0; i < k && nc < g.prefetch_p; i++) {
+        if (find_slot_state(l, req[i], ST_DEMAND) >= 0) {
+            continue;
+        }
+        bool dup = false;
+        for (int j = 0; j < nc; j++) {
+            if (cand[j] == req[i]) {
+                dup = true;
+                break;
+            }
+        }
+        if (!dup) {
+            cand[nc++] = req[i];
+        }
+    }
+    prefetch_event(l, cand, nc);
+    g.oracle_events++;
+}
+
+// Start the exact oracle-route reads for one layer event, into the final victim
+// slots. Publishes no mapping and touches no LRU metadata.
+void oracle_early_event(llama_moe_paging_layer & l) {
+    if (!g.oracle_enabled || !llama_moe_paging_direct_storage()) {
+        return;
+    }
+    if (l.oracle_plan_valid) {
+        GGML_ABORT("moe oracle: layer %d already has a pending early plan", l.il);
+    }
+    const int64_t n_layer = g.n_layer;
+    const int64_t ev = (int64_t) g.tokens * n_layer + l.il;
+    const int64_t total = (int64_t) g.oracle_n_token * n_layer;
+    if (ev < 0 || ev >= total) {
+        GGML_ABORT("moe oracle: route trace exhausted at token %llu layer %d (events=%lld)",
+                   (unsigned long long) g.tokens, l.il, (long long) total);
+    }
+    const int k = g.oracle_k;
+    int32_t req[8];
+    for (int i = 0; i < k; i++) {
+        req[i] = g.oracle_routes[(size_t) ev * (size_t) k + i];
+    }
+
+    int32_t slot[8];
+    bool is_miss[8] = {};
+    int miss_i[8] = {};
+    int n_miss = 0;
+    plan_event(l, req, k, slot, is_miss, miss_i, &n_miss, l.oracle_reserved.data());
+    for (int i = 0; i < k; i++) {
+        for (int j = 0; j < i; j++) {
+            if (slot[i] == slot[j]) {
+                g.duplicate_reads++;
+                GGML_ABORT("moe oracle: duplicate victim slot; fail closed");
+            }
+        }
+    }
+
+    l.oracle_plan_valid = true;
+    l.oracle_event = ev;
+    l.oracle_n_miss = n_miss;
+    l.oracle_submit_ms = now_ms();
+    if (l.oracle_layer_start_ms > 0.0) {
+        g.a0_compute_us.push_back((l.oracle_submit_ms - l.oracle_layer_start_ms) * 1000.0);
+    }
+    for (int i = 0; i < k; i++) {
+        l.oracle_req[i] = req[i];
+        l.oracle_slot[i] = slot[i];
+        l.oracle_is_miss[i] = is_miss[i];
+    }
+
+    std::fill(l.early_slot.begin(), l.early_slot.end(), (uint8_t) 0);
+    for (int i = 0; i < k; i++) {
+        l.early_slot[slot[i]] = 1;  // EARLY_RESERVED
+    }
+
+    std::vector<io_task> tasks;
+    tasks.reserve((size_t) n_miss * 3);
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        build_read_tasks(l, req[i], slot[i], tasks);
+        l.early_slot[slot[i]] = 2;  // EARLY_LOADING
+    }
+
+    auto & p = *g.oracle_pending[l.il];
+    p.submitted = false;
+    p.async = false;
+    p.ok = true;
+    if (!tasks.empty()) {
+        submit_read_tasks(tasks, p);
+    }
+
+    g.oracle_events++;
+    if (!tasks.empty()) {
+        g.early_readsets_submitted++;
+        g.early_experts_submitted += (uint64_t) n_miss;
+        for (const auto & t : tasks) {
+            g.early_bytes += (uint64_t) t.size;
+        }
+    }
+}
+
+// Authoritative demand: verify the oracle route, re-derive the plan, join the
+// in-flight reads, and only then commit the normal cache metadata.
+void stage_event_oracle_demand(llama_moe_paging_layer & l, const int32_t * req, int k,
+                               int32_t * out_slot) {
+    if (k != g.oracle_k) {
+        g.oracle_route_mismatches++;
+        GGML_ABORT("moe oracle: n_expert_used=%d != oracle k=%d; fail closed", k, g.oracle_k);
+    }
+    for (int i = 0; i < k; i++) {
+        if (req[i] != l.oracle_req[i]) {
+            g.oracle_route_mismatches++;
+            fprintf(stderr, "ORACLE ROUTE MISMATCH token=%llu layer=%d pos=%d native=%d oracle=%d\n",
+                    (unsigned long long) g.tokens, l.il, i, req[i], l.oracle_req[i]);
+            GGML_ABORT("moe oracle: native ordered Top-8 != oracle route; fail closed");
+        }
+    }
+    g.oracle_route_matches++;
+
+    int32_t slot[8];
+    bool is_miss[8] = {};
+    int miss_i[8] = {};
+    int n_miss = 0;
+    plan_event(l, req, k, slot, is_miss, miss_i, &n_miss, l.oracle_reserved.data());
+
+    bool plan_ok = (n_miss == l.oracle_n_miss);
+    for (int i = 0; i < k && plan_ok; i++) {
+        if (slot[i] != l.oracle_slot[i] || is_miss[i] != l.oracle_is_miss[i]) {
+            plan_ok = false;
+        }
+    }
+    if (!plan_ok) {
+        g.victim_plan_mismatches++;
+        GGML_ABORT("moe oracle: demand victim plan != reservation plan (layer %d); fail closed", l.il);
+    }
+    g.victim_plan_matches++;
+
+    const double demand_ms = now_ms();
+    auto & p = *g.oracle_pending[l.il];
+    const bool ready = p.submitted && (!p.async || p.batch.remaining.load() == 0);
+    if (ready) {
+        g.early_ready_before_demand++;
+    } else {
+        g.early_join_inflight++;
+    }
+    const double w0 = now_ms();
+    const bool rok = wait_read_tasks(p);
+    const double w1 = now_ms();
+    g.early_wait_ms_at_demand += (w1 - w0);
+    if (!rok) {
+        GGML_ABORT("moe oracle: early read set failed (layer %d); fail closed", l.il);
+    }
+
+    const bool decay = g.policy == "event_decay90";
+    std::fill(l.reserved.begin(), l.reserved.end(), (uint8_t) 0);
+    for (int i = 0; i < k; i++) {
+        const int s = slot[i];
+        l.reserved[s] = 1;
+        if (!is_miss[i]) {
+            l.hits++;
+            l.last_use[s] = ++g.clock;
+            if (decay) {
+                l.score[s] += 1.0;
+            }
+        }
+    }
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = slot[i];
+        if (l.slot_expert[s] >= 0) {
+            l.evictions++;
+        }
+        l.slot_expert[s] = req[i];
+        l.last_use[s] = ++g.clock;
+        l.score[s] = decay ? 1.0 : 0.0;
+        l.misses++;
+        l.bytes_read += (uint64_t) g.record_stride;
+    }
+    l.miss_hist[std::min(n_miss, 8)]++;
+    l.events++;
+    for (int j = 0; j < k; j++) {
+        out_slot[j] = slot[j];
+    }
+    l.direct_calls++;
+    const double now = now_ms();
+    l.stage_wall_ms += now - l.oracle_submit_ms;
+    l.readset_wall_ms += demand_ms - l.oracle_submit_ms;
+    l.read_wait_ms += (w1 - w0);
+    l.fault_ms += (w1 - w0);
+    l.compute_start_ms = now;
+    g.early_hidden_ms += std::max(0.0, demand_ms - l.oracle_submit_ms);
+    g.early_lead_us.push_back((demand_ms - l.oracle_submit_ms) * 1000.0);
+
+    l.oracle_plan_valid = false;
+    std::fill(l.early_slot.begin(), l.early_slot.end(), (uint8_t) 0);
+    l.oracle_submit_ms = 0.0;
+}
+
+// --- Execution 008 staging copy helpers -------------------------------------
+
+// copy a record (gate/up/down at the component offsets) into stage position j
+void stage_write_record(llama_moe_paging_layer & l, int j, const uint8_t * rec) {
+    memcpy((uint8_t *) l.stage_gate->data + (size_t) j * (size_t) l.gate_bytes, rec + l.gate_off, (size_t) l.gate_bytes);
+    memcpy((uint8_t *) l.stage_up->data   + (size_t) j * (size_t) l.up_bytes,   rec + l.up_off,   (size_t) l.up_bytes);
+    memcpy((uint8_t *) l.stage_down->data + (size_t) j * (size_t) l.down_bytes, rec + l.down_off, (size_t) l.down_bytes);
+}
+
+// permute a record within the K8 stage; src_j and dst_j are distinct positions
+void stage_move(llama_moe_paging_layer & l, int dst_j, int src_j) {
+    memmove((uint8_t *) l.stage_gate->data + (size_t) dst_j * (size_t) l.gate_bytes,
+            (const uint8_t *) l.stage_gate->data + (size_t) src_j * (size_t) l.gate_bytes, (size_t) l.gate_bytes);
+    memmove((uint8_t *) l.stage_up->data   + (size_t) dst_j * (size_t) l.up_bytes,
+            (const uint8_t *) l.stage_up->data   + (size_t) src_j * (size_t) l.up_bytes,   (size_t) l.up_bytes);
+    memmove((uint8_t *) l.stage_down->data + (size_t) dst_j * (size_t) l.down_bytes,
+            (const uint8_t *) l.stage_down->data + (size_t) src_j * (size_t) l.down_bytes, (size_t) l.down_bytes);
+}
+
+void stage_read_to_scratch(llama_moe_paging_layer & l, int src_j) {
+    memcpy(g.stage_scratch.data() + l.gate_off, (const uint8_t *) l.stage_gate->data + (size_t) src_j * (size_t) l.gate_bytes, (size_t) l.gate_bytes);
+    memcpy(g.stage_scratch.data() + l.up_off,   (const uint8_t *) l.stage_up->data   + (size_t) src_j * (size_t) l.up_bytes,   (size_t) l.up_bytes);
+    memcpy(g.stage_scratch.data() + l.down_off, (const uint8_t *) l.stage_down->data + (size_t) src_j * (size_t) l.down_bytes, (size_t) l.down_bytes);
+}
+
+void stage_event(llama_moe_paging_layer & l, const int32_t * req, int k, int32_t * out_slot) {
+    // Demand-only frequency_age and resident overlap share the authoritative
+    // demand engine. With P=0 there are no nominations, probation slots or reads.
+    if (g.prefetch_enabled || (llama_moe_paging_direct_storage() &&
+            g.backend == "gguf3" && !g.hot && !l.oracle_plan_valid &&
+            (g.overlap_enabled || g.policy == "frequency_age"))) {
+        stage_event_prefetch(l, req, k, out_slot);
+        return;
+    }
+    if (l.oracle_plan_valid && llama_moe_paging_direct_storage()) {
+        stage_event_oracle_demand(l, req, k, out_slot);
+        return;
+    }
+    const bool decay = g.policy == "event_decay90";
+
+    // event-decay90: one decay of every resident score per layer event
+    if (decay) {
+        for (int s = 0; s < l.n_slots; s++) {
+            l.score[s] *= 0.90;
+        }
+    }
+
+    std::fill(l.reserved.begin(), l.reserved.end(), (uint8_t) 0);
+
+    int32_t cache_slot[MAX_K];
+    int     miss_i[MAX_K];
+    bool    is_miss[MAX_K] = {};
+    int     n_miss = 0;
+
+    for (int i = 0; i < k; i++) {
+        cache_slot[i] = find_slot(l, req[i]);
+        if (cache_slot[i] >= 0) {
+            l.hits++;
+            l.last_use[cache_slot[i]] = ++g.clock;
+            l.reserved[cache_slot[i]] = 1; // never evict an expert required by this event
+            if (decay) {
+                l.score[cache_slot[i]] += 1.0;
+            }
+        } else {
+            miss_i[n_miss++] = i;
+            is_miss[i] = true;
+        }
+    }
+
+    // reserve one distinct cache slot per miss before any read starts
+    for (int m = 0; m < n_miss; m++) {
+        const int s = pick_victim(l);
+        if (s < 0) {
+            GGML_ABORT("moe paging: no victim slot available (M=%d, misses=%d)", l.n_slots, n_miss);
+        }
+        if (l.slot_expert[s] >= 0) {
+            l.evictions++;
+        }
+        l.reserved[s] = 1;
+        cache_slot[miss_i[m]] = s;
+    }
+
+    // gather the read set for all misses
+    std::vector<io_task> tasks;
+    tasks.reserve((size_t) n_miss * (g.backend == "gguf3" ? MAX_READ_COMPONENTS : 1));
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = cache_slot[i];
+        if (g.hot) {
+            // compute-only control: no file I/O, fill the destination directly
+            uint8_t * rec = llama_moe_paging_direct_storage()
+                ? nullptr : l.cache.data() + (size_t) s * (size_t) g.record_stride;
+            if (llama_moe_paging_direct_storage()) {
+                memcpy((uint8_t *) l.slot_gate->data + (size_t) s * (size_t) l.gate_bytes,
+                       g.hot_src.data() + l.gate_off, (size_t) l.gate_bytes);
+                memcpy((uint8_t *) l.slot_up->data   + (size_t) s * (size_t) l.up_bytes,
+                       g.hot_src.data() + l.up_off,   (size_t) l.up_bytes);
+                memcpy((uint8_t *) l.slot_down->data + (size_t) s * (size_t) l.down_bytes,
+                       g.hot_src.data() + l.down_off, (size_t) l.down_bytes);
+            } else {
+                memcpy(rec, g.hot_src.data(), (size_t) g.record_stride);
+            }
+            g.hot_fills++;
+        } else {
+            build_read_tasks(l, req[i], s, tasks);
+        }
+    }
+
+    const int ntasks = (int) tasks.size();
+    const uint64_t eff_qd = ntasks > 0
+        ? (uint64_t) std::min<int>((int) std::max<size_t>(g.workers.size(), 1), ntasks)
+        : 0;
+    l.qd_sum += eff_qd;
+    l.qd_max = std::max(l.qd_max, eff_qd);
+
+    const bool persistent = (g.stage_mode == "persistent_overlap");
+
+    // Final stage order: ascending resident-cache slot. mul_mat_id accumulates
+    // expert contributions in that order, reproducing the Execution-004 CPU
+    // accumulation order. Every mode keeps this order.
+    int order[MAX_K];
+    for (int i = 0; i < k; i++) {
+        order[i] = i;
+    }
+    std::sort(order, order + k, [&](int a, int b) { return cache_slot[a] < cache_slot[b]; });
+    for (int j = 0; j < k; j++) {
+        out_slot[order[j]] = j;
+    }
+
+    if (getenv("LLAMA_MOE_PAGING_SLOTLOG") != nullptr) {
+        fprintf(stderr, "SLOTLOG stage  il=%d req=", l.il);
+        for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", req[i]); }
+        fprintf(stderr, " slot=");
+        for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", cache_slot[i]); }
+        fprintf(stderr, "\n");
+    }
+
+    // staged-byte hit/miss split is independent of the copy source
+    for (int j = 0; j < k; j++) {
+        if (is_miss[order[j]]) {
+            l.stage_miss_bytes += (uint64_t) g.record_stride;
+        } else {
+            l.stage_hit_bytes += (uint64_t) g.record_stride;
+        }
+    }
+
+    int32_t desired[MAX_K];
+    int     desired_cache[MAX_K];
+    bool    desired_miss[MAX_K];
+    bool    p_done[MAX_K] = {};
+    bool    p_defer[MAX_K] = {};
+    int     scratch_expert = -1;
+    for (int j = 0; j < k; j++) {
+        const int i = order[j];
+        desired[j] = req[i];
+        desired_cache[j] = cache_slot[i];
+        desired_miss[j] = is_miss[i];
+    }
+
+    const double wall0 = now_ms();
+    double pre_wait_dt = 0.0;
+    read_pending rp;
+
+    if (llama_moe_paging_direct_storage()) {
+        // Execution 009: no K8 materialization. The selected experts stay in
+        // their resident slots. Reads (already submitted into those slots, or
+        // waiting below in serial QD) are the only data movement. Output order is
+        // ascending resident-slot id, matching the accepted Execution-003/004
+        // accumulation order.
+        int order_d[MAX_K];
+        for (int i = 0; i < k; i++) {
+            order_d[i] = i;
+        }
+        std::sort(order_d, order_d + k, [&](int a, int b) { return cache_slot[a] < cache_slot[b]; });
+
+        // The read set is the same gather that the staging path uses; in direct
+        // mode read_dst() already points each component at its resident slot, so
+        // no extra copy into a K8 tensor is needed.
+        const double pre_wait_t0_d = now_ms();
+        double dw_pre = 0.0;
+        if (!g.hot && g.stage_mode != "serial") {
+            submit_read_tasks(tasks, rp);
+            dw_pre = now_ms() - pre_wait_t0_d;
+        }
+
+        const double dw0 = now_ms();
+        bool dok = true;
+        if (!g.hot) {
+            if (g.stage_mode == "serial") {
+                if (!tasks.empty()) {
+                    dok = run_read_tasks(tasks);
+                }
+            } else {
+                dok = wait_read_tasks(rp);
+            }
+        }
+        const double dw_wait = now_ms() - dw0;
+        if (!tasks.empty()) {
+            // Canonical demand-side blocking interval for the demand-only path.
+            // The protected-prefetch path adds to the same counters in stage_event_prefetch.
+            g.demand_blocking_wait_ms += dw_wait;
+            g.demand_wait_events++;
+            l.fault_ms += dw_wait;
+            l.read_wait_ms += dw_wait;
+            l.readset_wall_ms += dw_pre + dw_wait;
+            {
+                std::lock_guard<std::mutex> lk(g.hist_m);
+                hist_add(g.readset_hist, dw_pre + dw_wait);
+            }
+            hist_add(l.readset_hist, dw_pre + dw_wait);
+            if (!dok) {
+                LLAMA_LOG_ERROR("%s: cannot read the full expert read set (layer %d, %d reads)\n",
+                                __func__, l.il, (int) tasks.size());
+                GGML_ABORT("moe paging: incomplete expert read set; refusing to run with partial weights");
+            }
+        }
+
+        // publish cache metadata only after every exact read succeeded
+        for (int m = 0; m < n_miss; m++) {
+            const int i = miss_i[m];
+            const int s = cache_slot[i];
+            l.slot_expert[s] = req[i];
+            l.last_use[s] = ++g.clock;
+            l.score[s] = decay ? 1.0 : 0.0;
+            l.misses++;
+            if (!g.hot) {
+                l.bytes_read += (uint64_t) g.record_stride;
+            }
+        }
+        l.miss_hist[std::min(n_miss, 8)]++;
+        l.events++;
+
+        // the graph must receive the resident slot id chosen for each requested
+        // expert position; the mul_mat_id below reads expert matrices by slot id
+        for (int j = 0; j < k; j++) {
+            out_slot[j] = cache_slot[j];
+        }
+        l.direct_calls++;
+        l.stage_wall_ms += now_ms() - wall0;
+        // inference compute happens after this op returns; the end marker uses this
+        l.compute_start_ms = now_ms();
+
+        if (getenv("LLAMA_MOE_PAGING_SLOTLOG") != nullptr) {
+            fprintf(stderr, "SLOTLOG direct il=%d req=", l.il);
+            for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", req[i]); }
+            fprintf(stderr, " slot=");
+            for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", cache_slot[i]); }
+            fprintf(stderr, "\n");
+        }
+        if (g.assert_checks) {
+            for (int j = 0; j < k; j++) {
+                const int s = cache_slot[j];
+                if (!(s >= 0 && s < l.n_slots)) {
+                    GGML_ABORT("moe paging assert: cache slot %d out of range", s);
+                }
+                if (l.slot_expert[s] != req[j]) {
+                    GGML_ABORT("moe paging assert: slot %d holds expert %d, expected %d",
+                               s, l.slot_expert[s], req[j]);
+                }
+                for (int q = 0; q < j; q++) {
+                    if (cache_slot[q] == s) {
+                        GGML_ABORT("moe paging assert: cache slot %d assigned twice", s);
+                    }
+                }
+            }
+        }
+        return;
+    }
+
+
+
+    if (g.stage_mode == "serial") {
+        // serial: no copy work overlaps the read set
+    } else {
+        const double pre_wait_t0 = now_ms();
+        submit_read_tasks(tasks, rp);
+        if (persistent) {
+            // persistent strict K8 stage: retain exact positions, permute experts
+            // already in stage, copy the rest from the resident cache. Only miss
+            // experts absent from stage are deferred until their reads complete.
+            for (int j = 0; j < k; j++) {
+                int p = -1;
+                for (int q = 0; q < k; q++) {
+                    if (l.stage_expert[q] == desired[j]) { p = q; break; }
+                }
+                p_done[j] = (p == j);
+                p_defer[j] = (p < 0 && desired_miss[j]);
+                if (p_done[j]) {
+                    l.stage_retain_bytes += (uint64_t) g.record_stride;
+                    l.retain_exact++;
+                }
+            }
+            for (;;) {
+                bool progress = false;
+                for (int j = 0; j < k; j++) {
+                    if (p_done[j] || p_defer[j]) {
+                        continue;
+                    }
+                    const int32_t cur = l.stage_expert[j];
+                    bool needed = false;
+                    if (cur >= 0) {
+                        for (int e = 0; e < k; e++) {
+                            if (!p_done[e] && e != j && desired[e] == cur) { needed = true; break; }
+                        }
+                    }
+                    if (needed) {
+                        continue;
+                    }
+                    int p = -1;
+                    for (int q = 0; q < k; q++) {
+                        if (l.stage_expert[q] == desired[j]) { p = q; break; }
+                    }
+                    if (p >= 0) {
+                        stage_move(l, j, p);
+                        l.stage_expert[p] = -1;
+                        l.stage_move_bytes += (uint64_t) g.record_stride;
+                        l.moved_in_stage++;
+                    } else if (scratch_expert == desired[j]) {
+                        stage_write_record(l, j, g.stage_scratch.data());
+                        scratch_expert = -1;
+                        l.stage_move_bytes += (uint64_t) g.record_stride;
+                        l.moved_in_stage++;
+                    } else {
+                        stage_write_record(l, j, l.cache.data() + (size_t) desired_cache[j] * (size_t) g.record_stride);
+                        l.stage_cache_bytes += (uint64_t) g.record_stride;
+                        l.newly_staged++;
+                    }
+                    l.stage_expert[j] = desired[j];
+                    p_done[j] = true;
+                    progress = true;
+                }
+                bool remaining = false;
+                for (int j = 0; j < k; j++) {
+                    if (!p_done[j] && !p_defer[j]) { remaining = true; break; }
+                }
+                if (!remaining) {
+                    break;
+                }
+                if (!progress) {
+                    // a cycle of stage-internal moves; break it with the one scratch record
+                    int j0 = -1;
+                    for (int j = 0; j < k; j++) {
+                        if (!p_done[j] && !p_defer[j]) { j0 = j; break; }
+                    }
+                    if (j0 < 0 || scratch_expert >= 0) {
+                        GGML_ABORT("moe paging: persistent staging permutation stalled");
+                    }
+                    stage_read_to_scratch(l, j0);
+                    scratch_expert = l.stage_expert[j0];
+                    l.stage_expert[j0] = -1;
+                }
+            }
+        } else {
+            // overlap: copy resident hits while the miss reads are outstanding
+            for (int j = 0; j < k; j++) {
+                const int i = order[j];
+                if (!is_miss[i]) {
+                    stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+                    l.stage_cache_bytes += (uint64_t) g.record_stride;
+                    l.newly_staged++;
+                }
+            }
+        }
+        pre_wait_dt = now_ms() - pre_wait_t0;
+        l.stage_pre_wait_ms += pre_wait_dt;
+    }
+
+    const double wait_t0 = now_ms();
+    bool read_ok = true;
+    if (g.stage_mode == "serial") {
+        if (!tasks.empty()) {
+            read_ok = run_read_tasks(tasks);
+        }
+    } else {
+        read_ok = wait_read_tasks(rp);
+    }
+    const double wait_dt = now_ms() - wait_t0;
+    // readset_dt is the full miss read-set wall: submit/start -> completion. In
+    // overlap/persistent it includes pre_wait_dt, the pre-wait staging overlapped with
+    // the in-flight reads. read_wait_ms (and the historical fault_ms) is only the
+    // residual caller-blocking wait after that pre-wait staging.
+    const double readset_dt = pre_wait_dt + wait_dt;
+    if (!tasks.empty()) {
+        l.fault_ms += wait_dt;
+        l.read_wait_ms += wait_dt;
+        l.readset_wall_ms += readset_dt;
+        {
+            std::lock_guard<std::mutex> lk(g.hist_m);
+            hist_add(g.readset_hist, readset_dt);
+        }
+        hist_add(l.readset_hist, readset_dt);
+        if (!read_ok) {
+            LLAMA_LOG_ERROR("%s: cannot read the full expert read set (layer %d, %d reads)\n",
+                            __func__, l.il, ntasks);
+            GGML_ABORT("moe paging: incomplete expert read set; refusing to run with partial weights");
+        }
+    }
+
+    // publish cache metadata only after every exact read succeeded
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = cache_slot[i];
+        l.slot_expert[s] = req[i];
+        l.last_use[s] = ++g.clock;
+        l.score[s] = decay ? 1.0 : 0.0;
+        l.misses++;
+        if (!g.hot) {
+            l.bytes_read += (uint64_t) g.record_stride;
+        }
+    }
+    l.miss_hist[std::min(n_miss, 8)]++;
+    l.events++;
+
+    const double post_wait_t0 = now_ms();
+    if (g.stage_mode == "serial") {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+            l.stage_cache_bytes += (uint64_t) g.record_stride;
+            l.newly_staged++;
+        }
+        std::fill(l.stage_expert.begin(), l.stage_expert.end(), -1);
+    } else if (persistent) {
+        for (int j = 0; j < k; j++) {
+            if (p_done[j]) {
+                continue;
+            }
+            stage_write_record(l, j, l.cache.data() + (size_t) desired_cache[j] * (size_t) g.record_stride);
+            l.stage_cache_bytes += (uint64_t) g.record_stride;
+            l.newly_staged++;
+            l.stage_expert[j] = desired[j];
+            p_done[j] = true;
+        }
+    } else {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            if (is_miss[i]) {
+                stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+                l.stage_cache_bytes += (uint64_t) g.record_stride;
+                l.newly_staged++;
+            }
+        }
+    }
+    const double post_wait_dt = now_ms() - post_wait_t0;
+
+    const double copy_dt = pre_wait_dt + post_wait_dt;
+    l.stage_post_wait_ms += post_wait_dt;
+    l.stage_ms += copy_dt;
+    l.stage_copy_ms = l.stage_ms;
+    l.stage_wall_ms += now_ms() - wall0;
+    l.stage_bytes += (uint64_t) k * (uint64_t) g.record_stride;
+    l.compute_start_ms = now_ms();
+
+    if (g.assert_checks) {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            const int s = cache_slot[i];
+            if (!(s >= 0 && s < l.n_slots)) {
+                GGML_ABORT("moe paging assert: cache slot %d out of range", s);
+            }
+            if (l.slot_expert[s] != req[i]) {
+                GGML_ABORT("moe paging assert: slot %d holds expert %d, expected %d",
+                           s, l.slot_expert[s], req[i]);
+            }
+            for (int q = 0; q < j; q++) {
+                if (cache_slot[order[q]] == s) {
+                    GGML_ABORT("moe paging assert: cache slot %d assigned twice", s);
+                }
+            }
+            const uint8_t * rec = l.cache.data() + (size_t) s * (size_t) g.record_stride;
+            if (memcmp((const uint8_t *) l.stage_gate->data + (size_t) j * (size_t) l.gate_bytes, rec + l.gate_off, (size_t) l.gate_bytes) != 0 ||
+                memcmp((const uint8_t *) l.stage_up->data   + (size_t) j * (size_t) l.up_bytes,   rec + l.up_off,   (size_t) l.up_bytes)   != 0 ||
+                memcmp((const uint8_t *) l.stage_down->data + (size_t) j * (size_t) l.down_bytes, rec + l.down_off, (size_t) l.down_bytes) != 0) {
+                GGML_ABORT("moe paging assert: stage position %d does not match expert %d bytes", j, req[i]);
+            }
+            if (persistent && l.stage_expert[j] != req[i]) {
+                GGML_ABORT("moe paging assert: persistent stage position %d holds expert %d, expected %d",
+                           j, l.stage_expert[j], req[i]);
+            }
+        }
+        for (int a = 0; a < k; a++) {
+            for (int b = a + 1; b < k; b++) {
+                if (req[order[a]] == req[order[b]]) {
+                    GGML_ABORT("moe paging assert: duplicate expert %d in stage order", req[order[a]]);
+                }
+            }
+        }
+    }
+}
+
+} // namespace
+
+void llama_moe_paging_init(const llama_model & model) {
+    if (g.initialized) {
+        return;
+    }
+    g.initialized = true;
+
+    const int m = getenv_int("LLAMA_MOE_PAGING_M", 0);
+    if (m <= 0) {
+        return;
+    }
+    if (model.hparams.n_layer() <= 0 || model.hparams.n_expert <= 0) {
+        return;
+    }
+
+    g.n_layer  = (int) model.hparams.n_layer();
+    g.n_expert = (int) model.hparams.n_expert;
+    g.m_slots  = m;
+    const uint32_t k = model.hparams.n_expert_used_max();
+    if (k == 0 || (int) k > MAX_K) {
+        LLAMA_LOG_WARN("%s: unsupported n_expert_used=%u, paging disabled\n", __func__, k);
+        return;
+    }
+    g.k_slots = (int) k;
+    g.policy  = getenv_str("LLAMA_MOE_PAGING_POLICY", "lru");
+    if (g.policy == "decay90") {
+        g.policy = "event_decay90";
+    }
+    g.stage_mode = getenv_str("LLAMA_MOE_PAGING_STAGE_MODE", "serial");
+    if (g.stage_mode != "serial" && g.stage_mode != "overlap" && g.stage_mode != "persistent_overlap") {
+        LLAMA_LOG_WARN("%s: unknown stage mode '%s', using serial\n", __func__, g.stage_mode.c_str());
+        g.stage_mode = "serial";
+    }
+    g.compute_mode = getenv_str("LLAMA_MOE_PAGING_COMPUTE_MODE", "staging");
+    // direct_dense: resident-slot tensors consumed by the normal (unmodified)
+    // CPU mul_mat_id. It exists only to falsify the M-shaped-cost hypothesis:
+    // it does the same K work but keeps the M-wide dispatch scan.
+    if (g.compute_mode != "staging" && g.compute_mode != "direct_sparse" && g.compute_mode != "direct_dense") {
+        LLAMA_LOG_WARN("%s: unknown compute mode '%s', using staging\n", __func__, g.compute_mode.c_str());
+        g.compute_mode = "staging";
+    }
+    g.backend = getenv_str("LLAMA_MOE_PAGING_BACKEND", "packed");
+    g.qd      = std::max(1, std::min(16, getenv_int("LLAMA_MOE_PAGING_QD", 4)));
+    g.hot     = getenv_bool("LLAMA_MOE_PAGING_HOT", false);
+    const std::string layout = getenv_str("LLAMA_MOE_PAGING_LAYOUT", "raw");
+    if (layout != "raw" && layout != "tile16") { GGML_ABORT("invalid expert layout"); }
+    g.tile16 = layout == "tile16";
+    g.nocache_requested = getenv_bool("LLAMA_MOE_PAGING_NOCACHE", false);
+    g.assert_checks = getenv_bool("LLAMA_MOE_PAGING_ASSERT", false);
+    g.timing = getenv_bool("LLAMA_MOE_PAGING_TIMING", true);
+    // Execution 017 measurement-only timeline and direct-cost bench.
+    g.timeline = getenv_bool("LLAMA_MOE_PAGING_TIMELINE", false);
+    g.direct_bench = std::max(0, std::min(512, getenv_int("LLAMA_MOE_PAGING_DIRECT_BENCH", 0)));
+    g.direct_bench_stride = std::max(1, getenv_int("LLAMA_MOE_PAGING_DIRECT_BENCH_STRIDE", 64));
+    g.overlap_enabled = getenv_bool("LLAMA_MOE_PAGING_OVERLAP", false);
+    g.overlap_verify = getenv_bool("LLAMA_MOE_PAGING_OVERLAP_VERIFY", false);
+    g.ov_threads = std::max(1, std::min(8, getenv_int("LLAMA_MOE_PAGING_OVERLAP_THREADS", 4)));
+    const char * events = getenv("LLAMA_MOE_PAGING_OVERLAP_EVENTS");
+    g.ov_metrics = g.overlap_enabled || (events && *events);
+    if (events && *events) {
+        g.ov_event_file = fopen(events, "w"); GGML_ASSERT(g.ov_event_file);
+        fprintf(g.ov_event_file, "step,layer,early_n,has_cold,submit_ms,cold_done_ms,early_start_ms,early_end_ms,early_cpu_ms,achieved_ms,idle_wait_ms,finished_before_io,outstanding_at_io,duplicated_cpu_proxy_ms\n");
+    }
+    g.stats_path = getenv_str("LLAMA_MOE_PAGING_STATS", "results/moe_paging_stats.json");
+    g.stats_interval = getenv_int("LLAMA_MOE_PAGING_STATS_INTERVAL", 128);
+    const std::string telemetry = getenv_str("MOE_TELEMETRY", "off");
+    if (telemetry != "off" && telemetry != "summary" && telemetry != "trace") { GGML_ABORT("invalid MOE_TELEMETRY"); }
+    const int telemetry_budget = getenv_int("MOE_TRACE_BUDGET_MIB", 4);
+    const int telemetry_first = getenv_int("MOE_TRACE_FIRST", 46);
+    const int telemetry_count = getenv_int("MOE_TRACE_COUNT", 4);
+    const int telemetry_stride = getenv_int("MOE_TRACE_STRIDE", 1);
+    if (telemetry_budget < 1 || telemetry_budget > 32 || telemetry_first < 0 || telemetry_count < 1 || telemetry_stride < 1) { GGML_ABORT("invalid bounded telemetry settings"); }
+    const std::string telemetry_path = getenv_str("MOE_TRACE_OUTPUT", "");
+    if (telemetry == "trace" && telemetry_path.empty()) { GGML_ABORT("trace needs MOE_TRACE_OUTPUT"); }
+    if (telemetry != "off" && (g.qd <= 1 || g.compute_mode != "direct_sparse" || g.backend != "gguf3")) { GGML_ABORT("telemetry requires direct_sparse/gguf3/QD>1"); }
+    observer.init(telemetry=="off"?0:telemetry=="summary"?1:2, (size_t)telemetry_budget*1024*1024,
+                  telemetry_first, telemetry_count, telemetry_stride, telemetry_path);
+    g.fault_after = getenv_int("LLAMA_MOE_PAGING_FAULT_AFTER", 0);
+    g.direct_verify   = getenv_bool("LLAMA_MOE_PAGING_DIRECT_VERIFY", false);
+    g.direct_verify_n = std::max(1, getenv_int("LLAMA_MOE_PAGING_DIRECT_VERIFY_N", 8));
+
+    // Execution 015 protected probation prefetch
+    g.demand_slots = m;
+    g.prefetch_p = std::max(0, std::min(32, getenv_int("LLAMA_MOE_PAGING_PREFETCH_P", 0)));
+    g.prefetch_mode = getenv_str("LLAMA_MOE_PAGING_PREFETCH_MODE", "off");
+    // Execution 017: the normal A0 path keeps the shared speculative batch
+    // (Execution-015 semantics). Set the env var to 0 for the split diagnostic mode.
+    g.prefetch_shared = getenv_bool("LLAMA_MOE_PAGING_PREFETCH_SHARED", true);
+    const char * pf_seq_path = getenv("LLAMA_MOE_PAGING_PREFETCH_SEQ");
+    if (pf_seq_path != nullptr && pf_seq_path[0] != '\0') {
+        g.pf_seq_f = fopen(pf_seq_path, "w");
+    }
+    g.prefetch_pool = std::max(1, std::min(64, getenv_int("LLAMA_MOE_PAGING_PREFETCH_K", 16)));
+    g.shadow_assert = g.assert_checks || getenv_bool("LLAMA_MOE_PAGING_SHADOW", false);
+    if (g.prefetch_p > 0 && g.prefetch_mode != "off") {
+        const bool usable = g.compute_mode == "direct_sparse" && g.backend == "gguf3" &&
+                            (g.policy == "lru" || g.policy == "frequency_age") && !g.hot && g.qd > 1;
+        if (!usable) {
+            LLAMA_LOG_WARN("%s: prefetch disabled (needs direct_sparse+gguf3+lru/frequency_age+qd>1+hot=0)\n", __func__);
+            g.prefetch_p = 0;
+            g.prefetch_mode = "off";
+        } else {
+            g.prefetch_enabled = true;
+            g.m_slots = m + g.prefetch_p;
+            g.prefetch_pool = std::max(g.prefetch_p, g.prefetch_pool);
+        }
+    }
+
+    if (g.policy == "frequency_age" && !(g.compute_mode == "direct_sparse" &&
+            g.backend == "gguf3" && !g.hot && g.qd > 1 &&
+            ((g.prefetch_enabled && g.prefetch_mode == "a0") ||
+             (!g.prefetch_enabled && g.prefetch_mode == "off" && g.prefetch_p == 0)))) {
+        GGML_ABORT("frequency_age requires direct_sparse/gguf3/QD>1/hot=0 and A0/P>0 or off/P0");
+    }
+
+    g.pf_admission = getenv_str("LLAMA_MOE_PAGING_PREFETCH_ADMISSION", "all");
+    if (g.pf_admission != "all" && g.pf_admission != "rank_gate" && g.pf_admission != "time_gate") { GGML_ABORT("invalid prefetch admission"); }
+    if (g.pf_admission != "all" && (!g.prefetch_enabled || g.prefetch_mode != "a0" || g.prefetch_p != 2 || g.prefetch_pool != 16)) {
+        GGML_ABORT("rank_gate/time_gate requires A0/P2/K16");
+    }
+    const char * decision_path = getenv("LLAMA_MOE_PAGING_PREFETCH_DECISIONS");
+    if (decision_path && *decision_path) {
+        GGML_ASSERT(g.prefetch_enabled && g.prefetch_mode == "a0");
+        g.pf_decisions_f = fopen(decision_path, "w"); GGML_ASSERT(g.pf_decisions_f);
+        fprintf(g.pf_decisions_f, "step,layer,expert,rank,admit,submitted,wanted,observations,useful");
+        if (g.pf_admission == "time_gate") {
+            fprintf(g.pf_decisions_f, ",decision_ms,lead_est_ms,read_est_ms,queue_est_ms,expected_gain_ms,lead_samples,read_samples,actual_lead_ms");
+        }
+        fprintf(g.pf_decisions_f, "\n");
+    }
+
+    const std::string store = getenv_str("LLAMA_MOE_PAGING_STORE", "cold-experts.bin");
+    if (g.backend != "gguf3") {
+        g.store_fd = open(store.c_str(), O_RDONLY);
+        if (g.store_fd < 0) {
+            LLAMA_LOG_WARN("%s: cannot open packed store '%s', paging disabled\n", __func__, store.c_str());
+            return;
+        }
+    }
+
+    if (g.backend == "gguf3") {
+        const std::string gguf = getenv_str("LLAMA_MOE_PAGING_GGUF", "");
+        if (gguf.empty()) {
+            GGML_ABORT("moe paging: backend=gguf3 requires LLAMA_MOE_PAGING_GGUF");
+        }
+        g.gguf_fd = open(gguf.c_str(), O_RDONLY);
+        if (g.gguf_fd < 0) {
+            GGML_ABORT("moe paging: cannot open source GGUF '%s'", gguf.c_str());
+        }
+    }
+
+    if (g.nocache_requested) {
+        bool any = false;
+#ifdef F_NOCACHE
+        if (g.store_fd >= 0 && fcntl(g.store_fd, F_NOCACHE, 1) == 0) { any = true; }
+        if (g.gguf_fd  >= 0 && fcntl(g.gguf_fd,  F_NOCACHE, 1) == 0) { any = true; }
+#endif
+        g.nocache_applied = any;
+    }
+
+    if (g.tile16) {
+        if (g.backend != "gguf3" || g.compute_mode != "direct_sparse" || g.hot || g.direct_verify ||
+            g.n_layer != 40 || g.n_expert != 256 || g.k_slots != 8) {
+            GGML_ABORT("tile16 requires supported model, gguf3/direct_sparse/hot=0/direct_verify=0");
+        }
+        tile_admit();
+    }
+
+    g.cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    if (g.cpu == nullptr) {
+        LLAMA_LOG_WARN("%s: no CPU backend, paging disabled\n", __func__);
+        return;
+    }
+
+    g.layers.assign(g.n_layer, llama_moe_paging_layer());
+
+    const auto * gate0 = model.layers[0].ffn_gate_exps;
+    const auto * up0   = model.layers[0].ffn_up_exps;
+    const auto * down0 = model.layers[0].ffn_down_exps;
+    if (gate0 == nullptr || up0 == nullptr || down0 == nullptr) {
+        LLAMA_LOG_WARN("%s: routed expert tensors not found, paging disabled\n", __func__);
+        return;
+    }
+
+    const int64_t gate_bytes = ggml_nbytes(gate0) / g.n_expert;
+    const int64_t up_bytes   = ggml_nbytes(up0)   / g.n_expert;
+    const int64_t down_bytes = ggml_nbytes(down0) / g.n_expert;
+    const int64_t gate_off = 0;
+    const int64_t up_off   = align_up(gate_bytes, 16);
+    const int64_t down_off = up_off + align_up(up_bytes, 16);
+    g.record_stride = align_up(down_off + align_up(down_bytes, 16), 4096);
+    g.stage_scratch.assign((size_t) g.record_stride, 0);
+
+    // per-layer GGUF offsets for backend=gguf3
+    std::vector<int64_t> gguf_gate(g.n_layer, 0), gguf_up(g.n_layer, 0), gguf_down(g.n_layer, 0);
+    if (g.backend == "gguf3") {
+        const std::string csv = getenv_str("LLAMA_MOE_PAGING_OFFSETS", "results/gguf_expert_offsets.csv");
+        FILE * cf = fopen(csv.c_str(), "r");
+        if (cf == nullptr) {
+            GGML_ABORT("moe paging: cannot open gguf offset table '%s'", csv.c_str());
+        }
+        char line[512];
+        int matched = 0;
+        while (fgets(line, sizeof(line), cf) != nullptr) {
+            int il = -1;
+            long long ga = 0, gb = 0, ua = 0, ub = 0, da = 0, dbb = 0;
+            if (sscanf(line, "%d,%lld,%lld,%lld,%lld,%lld,%lld", &il, &ga, &gb, &ua, &ub, &da, &dbb) == 7) {
+                if (il >= 0 && il < g.n_layer) {
+                    gguf_gate[il] = ga;
+                    gguf_up[il]   = ua;
+                    gguf_down[il] = da;
+                    matched++;
+                }
+            }
+        }
+        fclose(cf);
+        if (matched < g.n_layer) {
+            GGML_ABORT("moe paging: offset table has %d/%d rows", matched, g.n_layer);
+        }
+    }
+
+    if (g.backend != "gguf3") {
+        struct stat st;
+        if (fstat(g.store_fd, &st) != 0) {
+            GGML_ABORT("moe paging: cannot stat packed expert store");
+        }
+        const int64_t store_need = (int64_t) g.n_layer * g.n_expert * g.record_stride;
+        if ((int64_t) st.st_size < store_need) {
+            GGML_ABORT("moe paging: packed expert store is smaller than the required expert pool");
+        }
+    }
+
+    g.hot_src.assign((size_t) g.record_stride, (uint8_t) 0x11);
+
+    const int64_t stage_bytes_per_layer = (int64_t) g.k_slots * g.record_stride;
+    for (int il = 0; il < g.n_layer; il++) {
+        auto & l = g.layers[il];
+        auto * gt = model.layers[il].ffn_gate_exps;
+        auto * ut = model.layers[il].ffn_up_exps;
+        auto * dt = model.layers[il].ffn_down_exps;
+        if (gt == nullptr || ut == nullptr || dt == nullptr) {
+            continue;
+        }
+
+        if (g.tile16 && (gt->type != GGML_TYPE_Q4_K || ut->type != GGML_TYPE_Q4_K || dt->type != GGML_TYPE_Q6_K ||
+            gt->ne[0] != 2048 || ut->ne[0] != 2048 || dt->ne[0] != 512 ||
+            gt->ne[1] != 512 || ut->ne[1] != 512 || dt->ne[1] != 2048)) {
+            GGML_ABORT("tile16 model expert geometry mismatch");
+        }
+
+        // direct storage never materializes a K8 tensor, so it allocates no staging
