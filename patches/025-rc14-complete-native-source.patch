+            for (int n = 1; n <= 8; n++) {
+                const std::vector<double> & fv = g.tl_bench_first_us[p][n];
+                fprintf(f, "%s{\"n\": %d, \"samples\": %llu, \"p50_us\": %.3f, \"p95_us\": %.3f}",
+                        n > 1 ? ", " : "", n, (unsigned long long) fv.size(),
