+#include <cerrno>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <fcntl.h>
+#include <memory>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+#include <thread>
+#include <time.h>
+#include <functional>
+#include <unistd.h>
+#include <vector>
+
+// Execution 017 correction 4: production CPU swiglu kernel (ggml-cpu/vec.cpp).
+extern "C" void ggml_vec_swiglu_f32(const int n, float * y, const float * x, const float * g);
+
+// True when the resident-slot tensors are the compute storage (direct_sparse or
+// direct_dense). Declared before the anonymous namespace: the early helpers use it.
+namespace { bool llama_moe_paging_direct_storage(); }
+
+namespace {
+
+
+constexpr int    HIST_BUCKETS = 32;
+constexpr double HIST_LO_MS   = 0.01;
+constexpr int    MAX_READ_COMPONENTS = 3;
+constexpr int    MAX_K        = 64;
+
+static double hist_percentile(const uint64_t * hist, double q) {
+    uint64_t total = 0;
+    for (int b = 0; b < HIST_BUCKETS; b++) {
+        total += hist[b];
+    }
+    if (total == 0) {
+        return 0.0;
+    }
+    const double target = q * (double) total;
+    uint64_t cum = 0;
+    for (int b = 0; b < HIST_BUCKETS; b++) {
+        cum += hist[b];
+        if ((double) cum >= target) {
+            return HIST_LO_MS * (double) (1ULL << (b + 1));
+        }
+    }
+    return HIST_LO_MS * (double) (1ULL << HIST_BUCKETS);
+}
+
+static void hist_add(uint64_t * hist, double dt) {
+    int b = dt > HIST_LO_MS ? (int) std::floor(std::log2(dt / HIST_LO_MS)) : 0;
+    if (b < 0) { b = 0; }
+    if (b >= HIST_BUCKETS) { b = HIST_BUCKETS - 1; }
+    hist[b]++;
