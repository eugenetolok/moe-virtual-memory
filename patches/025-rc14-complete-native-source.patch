+            const size_t mem = 4096 + 8 * ggml_tensor_overhead();
+            ggml_init_params ip = { mem, nullptr, true };
+            l.stage_ctx = ggml_init(ip);
+            l.stage_gate = ggml_new_tensor_3d(l.stage_ctx, gt->type, gt->ne[0], gt->ne[1], g.k_slots);
+            l.stage_up   = ggml_new_tensor_3d(l.stage_ctx, ut->type, ut->ne[0], ut->ne[1], g.k_slots);
+            l.stage_down = ggml_new_tensor_3d(l.stage_ctx, dt->type, dt->ne[0], dt->ne[1], g.k_slots);
+            l.stage_buf = ggml_backend_alloc_ctx_tensors(l.stage_ctx, g.cpu);
+            if (l.stage_buf == nullptr) {
+                LLAMA_LOG_WARN("%s: failed to allocate staging buffer layer %d\n", __func__, il);
+                return;
+            }
+        }
+
+        if (llama_moe_paging_direct_storage()) {
+            // plain CPU resident-slot tensors: directly writable exact quant data,
+            // no CPU_REPACK shadow and no second K8 copy.
+            const size_t mem_d = 4096 + 8 * ggml_tensor_overhead();
+            ggml_init_params ip_d = { mem_d, nullptr, true };
+            l.slot_ctx = ggml_init(ip_d);
+            l.slot_gate = ggml_new_tensor_3d(l.slot_ctx, gt->type, gt->ne[0], gt->ne[1], g.m_slots);
+            l.slot_up   = ggml_new_tensor_3d(l.slot_ctx, ut->type, ut->ne[0], ut->ne[1], g.m_slots);
+            l.slot_down = ggml_new_tensor_3d(l.slot_ctx, dt->type, dt->ne[0], dt->ne[1], g.m_slots);
+            l.slot_buf = ggml_backend_alloc_ctx_tensors(l.slot_ctx, g.cpu);
+            if (l.slot_buf == nullptr) {
+                LLAMA_LOG_WARN("%s: failed to allocate resident-slot buffer layer %d\n", __func__, il);
+                return;
+            }
+            GGML_ASSERT(ggml_nbytes(l.slot_gate) == (size_t) g.m_slots * (size_t) (ggml_nbytes(gt) / g.n_expert));
+        }
+
+        l.il = il;
+        l.gate_bytes = gate_bytes;
+        l.up_bytes   = up_bytes;
+        l.down_bytes = down_bytes;
+        l.gate_off = gate_off;
+        l.up_off   = up_off;
+        l.down_off = down_off;
+        l.gguf_gate_off = gguf_gate[il];
+        l.gguf_up_off   = gguf_up[il];
+        l.gguf_down_off = gguf_down[il];
+        l.n_slots = g.m_slots;
+        l.slot_expert.assign(g.m_slots, -1);
+        l.last_use.assign(g.m_slots, 0);
+        l.score.assign(g.m_slots, 0.0);
+        l.reserved.assign(g.m_slots, 0);
+        l.early_slot.assign(g.m_slots, 0);
+        l.oracle_reserved.assign(g.m_slots, 0);
+        l.slot_state.assign((size_t) g.m_slots, ST_EMPTY);
+        l.pf_submit_ms.assign((size_t) g.m_slots, 0.0);
+        l.slot_batch.assign((size_t) g.m_slots, -1);
+        l.demand_count = 0;
+        l.shadow_expert.assign((size_t) g.demand_slots, -1);
+        l.shadow_last_use.assign((size_t) g.demand_slots, 0);
+        if (g.policy == "frequency_age") {
+            l.demand_frequency.assign(g.n_expert, 0);
+            l.demand_last_event.assign(g.n_expert, 0);
+            l.shadow_frequency.assign(g.n_expert, 0);
+            l.shadow_last_event.assign(g.n_expert, 0);
+        }
+        l.shadow_n = 0;
+        l.pf_cand_n = 0;
+        l.stage_expert.assign(g.k_slots, -1);
+        // the byte cache is the staging storage; direct compute reads the slot tensors
+        if (!llama_moe_paging_direct_storage()) {
+            l.cache.assign((size_t) g.m_slots * (size_t) g.record_stride, 0);
+        }
+        std::fill(l.miss_hist, l.miss_hist + 9, 0);
+        std::fill(l.readset_hist, l.readset_hist + HIST_BUCKETS, 0);
+
+        if (stage_bytes_per_layer <= 0) {
+            GGML_ABORT("moe paging: invalid staging size");
+        }
+    }
+
+    // bounded reusable worker pool; qd == 1 stays on the calling thread
+    if (g.qd > 1) {
+        for (int i = 0; i < g.qd; i++) {
+            g.workers.emplace_back(worker_main, i);
+        }
+    }
+
+    // Execution 014 diagnostic perfect-oracle early-start. Capture writes the
+    // authoritative ordered Top-8 per layer event; pre_attn/paid_a0 replay it.
+    g.oracle_trace_path = getenv_str("LLAMA_MOE_ORACLE_TRACE", "");
+    g.oracle_mode       = getenv_str("LLAMA_MOE_ORACLE_EARLY", "off");
+    g.oracle_capture    = getenv_bool("LLAMA_MOE_ORACLE_CAPTURE", false);
+    if (g.prefetch_enabled && g.prefetch_mode == "oracle") {
+        g.oracle_mode = "prefetch_oracle";
+    }
+    g.oracle_pending.resize(g.layers.size());
+    for (auto & p : g.oracle_pending) {
+        p = std::make_unique<read_pending>();
+    }
+    g.pf_batches.resize(g.layers.size());
+    if (!g.oracle_trace_path.empty()) {
+        if (g.oracle_capture) {
+            g.oracle_capture_f = fopen(g.oracle_trace_path.c_str(), "wb");
+            if (g.oracle_capture_f == nullptr) {
+                GGML_ABORT("moe oracle: cannot write route trace '%s'", g.oracle_trace_path.c_str());
+            }
+            const char magic[8] = {'M','O','E','O','R','T','0','1'};
+            int32_t hdr[3] = { g.n_layer, g.k_slots, 0 };
+            fwrite(magic, 1, 8, g.oracle_capture_f);
+            fwrite(hdr, sizeof(int32_t), 3, g.oracle_capture_f);
+            LLAMA_LOG_INFO("%s: oracle capture -> %s\n", __func__, g.oracle_trace_path.c_str());
+        } else if (g.oracle_mode == "pre_attn" || g.oracle_mode == "paid_a0" ||
+                   g.oracle_mode == "prefetch_oracle") {
+            if (g.compute_mode != "direct_sparse") {
+                GGML_ABORT("moe oracle: requires compute_mode=direct_sparse");
+            }
+            if (g.backend != "gguf3") {
+                GGML_ABORT("moe oracle: requires backend=gguf3");
+            }
+            if (g.policy != "lru") {
+                GGML_ABORT("moe oracle: requires policy=lru");
+            }
+            if (g.hot) {
+                GGML_ABORT("moe oracle: requires hot=0");
+            }
+            if (g.qd <= 1) {
+                GGML_ABORT("moe oracle: requires qd>1 for early reads");
+            }
+            FILE * f = fopen(g.oracle_trace_path.c_str(), "rb");
+            if (f == nullptr) {
+                GGML_ABORT("moe oracle: cannot read route trace '%s'", g.oracle_trace_path.c_str());
+            }
+            char magic[8];
+            int32_t hdr[3];
+            if (fread(magic, 1, 8, f) != 8 || fread(hdr, sizeof(int32_t), 3, f) != 3 ||
+                    memcmp(magic, "MOEORT01", 8) != 0) {
+                fclose(f);
+                GGML_ABORT("moe oracle: bad route trace header '%s'", g.oracle_trace_path.c_str());
+            }
+            const int32_t nl = hdr[0], kk = hdr[1], nev = hdr[2];
+            if (nl != g.n_layer) {
+                fclose(f);
+                GGML_ABORT("moe oracle: trace n_layer=%d != %d", nl, g.n_layer);
+            }
+            if (kk <= 0 || kk > 8) {
+                fclose(f);
+                GGML_ABORT("moe oracle: trace k=%d unsupported", kk);
+            }
+            if (nev <= 0 || (nev % nl) != 0) {
+                fclose(f);
+                GGML_ABORT("moe oracle: trace events %d not a multiple of n_layer %d", nev, nl);
+            }
+            g.oracle_k = kk;
+            g.oracle_n_token = (uint64_t) (nev / nl);
+            g.oracle_routes.resize((size_t) nev * (size_t) kk);
+            const size_t got = fread(g.oracle_routes.data(), sizeof(int32_t), g.oracle_routes.size(), f);
+            fclose(f);
+            if (got != g.oracle_routes.size()) {
+                GGML_ABORT("moe oracle: short route trace (%zu of %zu)", got, g.oracle_routes.size());
+            }
+            g.oracle_enabled = true;
+            LLAMA_LOG_INFO("%s: oracle early-start mode=%s tokens=%llu k=%d trace=%s\n",
+                           __func__, g.oracle_mode.c_str(), (unsigned long long) g.oracle_n_token,
+                           g.oracle_k, g.oracle_trace_path.c_str());
+        }
+    }
+
+    g.enabled = true;
+    if (g.compute_mode == "direct_sparse") {
+        // register the selected-only CPU mul_mat_id with the ggml-cpu backend
+        ggml_cpu_set_moe_mul_mat_id_hook(llama_moe_paging_direct_mul_mat_id);
+        LLAMA_LOG_INFO("%s: direct_sparse hook registered\n", __func__);
+    }
+    std::atexit(atexit_handler);
+    dump_stats();
+    LLAMA_LOG_INFO("%s: CPU staging paging enabled: M=%d K=%d backend=%s qd=%d stage_mode=%s hot=%d nocache=%d store=%s\n",
+                   __func__, g.m_slots, g.k_slots, g.backend.c_str(), g.qd, g.stage_mode.c_str(),
+                   g.hot ? 1 : 0, g.nocache_applied ? 1 : 0, store.c_str());
+}
