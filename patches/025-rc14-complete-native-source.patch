+// Explicit input dependency: slot resolution cannot observe a stale MoE input.
+void llama_moe_paging_slots_input(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor * input,
+                                  int ith, int nth, void * userdata) {
+    if (ith == 0) { ((llama_moe_paging_layer *) userdata)->early_in = input; }
+    llama_moe_paging_slots(dst, a, ith, nth, userdata);
+}
+
+// Return the paging layer that owns this resident-slot tensor, or nullptr.
+static llama_moe_paging_layer * direct_layer_for(const ggml_tensor * src0) {
+    if (!g.enabled || g.compute_mode != "direct_sparse") {
+        return nullptr;
+    }
+    for (auto & l : g.layers) {
+        if (l.slot_gate == src0 || l.slot_up == src0 || l.slot_down == src0) {
+            return &l;
+        }
+    }
+    return nullptr;
+}
+
+static bool llama_moe_paging_direct_mul_mat_id_impl(ggml_compute_params * params, ggml_tensor * op) {
+    if (op == nullptr || op->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    const ggml_tensor * src0 = op->src[0];
+    llama_moe_paging_layer * l = direct_layer_for(src0);
+    if (l == nullptr) {
+        return false;
+    }
+
+    const ggml_tensor * src1 = op->src[1];
+    const ggml_tensor * ids  = op->src[2];
+    ggml_tensor *       dst  = op;
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const ggml_type type = src0->type;
+    const ggml_type vec_dot_type = ggml_get_type_traits_cpu(type)->vec_dot_type;
+    const ggml_from_float_t from_float = ggml_get_type_traits_cpu(vec_dot_type)->from_float;
+
+    GGML_ASSERT(nb00 == ggml_type_size(type));
+    GGML_ASSERT(nb10 == ggml_type_size(src1->type));
+    GGML_ASSERT(nb0 == sizeof(float));
+    GGML_ASSERT(nb0 <= nb1);
+    GGML_ASSERT(nb1 <= nb2);
+    GGML_ASSERT(nb2 <= nb3);
+
+    const int n_ids = (int) ids->ne[0]; // K = 8
+    const int n_as  = (int) ne02;       // M resident slots
+
+    // decode scope: single token, K selected ids
+    if (ids->ne[1] != 1 || n_ids > MAX_K) {
+        if (g.tile16) { GGML_ABORT("tile16 invalid selected id geometry"); }
+        if (ith == 0) { l->direct_fallback_calls++; }
+        return false;
+    }
+
+    if (g.tile16 && (nth < 1 || nth > 16 || n_ids != 8 || ids->ne[1] != 1 ||
+        src1->type != GGML_TYPE_F32 || vec_dot_type != GGML_TYPE_Q8_K || ne12 != 1 ||
+        ne11 != (src0 == l->slot_down ? 8 : 1) || ne10 != ne00 || ne01 % 16 != 0 ||
+        params->wdata == nullptr || params->wsize < ggml_row_size(vec_dot_type, ne10)*size_t(ne11)*size_t(ne12))) {
+        GGML_ABORT("tile16 unsupported direct matmul geometry; no raw-layout fallback");
+    }
+
+    // Resolve the K selected resident-slot ids, reject duplicates, sort ascending
+    // so accumulation matches the accepted Execution-003/004 order.
+    int32_t sel[MAX_K];
+    int32_t order[MAX_K];
+    for (int i = 0; i < n_ids; i++) {
+        const int32_t s = *(const int32_t *) ((const char *) ids->data + i * ids->nb[0]);
+        if (s < 0 || s >= n_as) {
+            if (g.tile16) { GGML_ABORT("tile16 invalid resident slot"); }
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        sel[i] = s;
+        order[i] = i;
+    }
+    for (int i = 0; i < n_ids; i++) {
+        for (int q = i + 1; q < n_ids; q++) {
+            if (sel[order[i]] == sel[order[q]]) {
+                if (g.tile16) { GGML_ABORT("tile16 duplicate resident slot"); }
+                // duplicate resident slot: the normal grouping merges them, keep it
+                if (ith == 0) { l->direct_fallback_calls++; }
+                return false;
+            }
+        }
+    }
+    std::sort(order, order + n_ids, [&](int a, int b) { return sel[a] < sel[b]; });
+
+    // ggml indexes src1 as b[:, i % ne11, t]. This hook is single-token, so t = 0
+    // and only the ne11 rows of the token plane are read: gate/up have ne11 = 1
+    // (all experts share row 0), down has ne11 = K (request j uses row j).
+    const int proj = (src0 == l->slot_gate) ? 0 : (src0 == l->slot_up) ? 1 : 2;
+    if (g.timeline || g.direct_bench > 0) {
+        if (proj == 0) { l->tl_gate_out = dst; }
+        else if (proj == 1) { l->tl_up_out = dst; }
+        else { l->tl_down_out = dst; }
+    }
+    const size_t nbw1 = ggml_row_size(vec_dot_type, ne10);
+    char * wbuf = nullptr;
+    const double conv_t0 = (g.timeline && ith == 0) ? now_ms() : 0.0;
+    if (src1->type != vec_dot_type) {
+        wbuf = (char *) params->wdata;
+        if (wbuf == nullptr) {
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        const size_t need = nbw1 * (size_t) ne11 * (size_t) ne12;
+        if (params->wsize < need) {
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        // ne12 == ids->ne[1] == 1, so only the single token plane is converted.
+        // Threads split the rows; ggml's workspace layout is i11*row_size.
+        for (int64_t i11 = ith; i11 < ne11; i11 += nth) {
+            if (g.overlap_enabled && !g.overlap_verify && proj == 2 && l->early_ready[i11]) { continue; }
+            GGML_ASSERT(i11 >= 0);
+            from_float((const float *) ((const char *) src1->data + (size_t) i11 * nb11),
+                       wbuf + (size_t) i11 * nbw1,
+                       ne10);
+        }
+        ggml_barrier(params->threadpool);
+        if (g.timeline && ith == 0) {
+            g.tl_conv_ms[proj] += now_ms() - conv_t0;
+            g.tl_conv_n[proj]++;
+        }
+    }
+
+    if (ith == 0) {
+        l->direct_mul_mat_id_calls++;
+        l->direct_selected_matrices += (uint64_t) n_ids;
+    }
+
+    const int64_t nr0 = ne01;
+    int chunk_size = 16;
+    if (nr0 == 1 || n_ids == 1) {
+        chunk_size = 64;
+    }
+    const int64_t nchunk0 = (nr0 + chunk_size - 1) / chunk_size;
+    const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+
+    // Execution 017: keep the exact kernel loop in a lambda so the same path can
+    // be timed and replayed for n = 1..n_ids selected experts.
+    const bool skip_early = g.overlap_enabled && !g.overlap_verify;
+    auto run_selected = [&](int n_sel, bool production = false) {
+        for (int jj = 0; jj < n_sel; jj++) {
+            const int j = order[jj];
+            if (skip_early && l->early_ready[j]) { continue; }
+            const int32_t s = sel[j];
+            const bool capture = observer.mode==2 && production;
+            const double compute0 = capture?now_ms():0, cpu0 = capture?thread_cpu_ms():0;
+            const char * src0_cur = (const char *) src0->data + (size_t) s * nb02;
+            const int64_t i11 = (int64_t) j % ne11;
+            GGML_ASSERT(i11 >= 0 && i11 < ne11);
+            const char * src1_row = (src1->type == vec_dot_type)
+                ? (const char *) src1->data + (size_t) i11 * nb11
+                : wbuf + (size_t) i11 * nbw1;
+            float * dst_col = (float *) ((char *) dst->data + (size_t) j * nb1);
+
+            if (g.tile16) {
+                const int tiles = (int(nr0)/16 + nth-1)/nth;
+                const int begin = std::min(int(nr0), ith*tiles*16);
+                const int end = std::min(int(nr0), begin+tiles*16);
+                if (begin < end) { tile_compute(src0_cur + size_t(begin)*nb01, src1_row, dst_col+begin,
+                                               end-begin, int(ne00)/256, type==GGML_TYPE_Q6_K,
+                                               ggml_get_type_traits_cpu(type)->vec_dot, ith); }
+            } else {
+            (void) chunk_size;
+            for (int64_t ic = ith; ic < nchunk0; ic += nth) {
+                const int64_t ir0_start = dr0 * ic;
+                const int64_t ir0_end = std::min(ir0_start + dr0, nr0);
+                for (int64_t ir0 = ir0_start; ir0 < ir0_end; ir0++) {
+                    float tmp = 0.0f;
+                    ggml_vec_dot_t vec_dot = ggml_get_type_traits_cpu(type)->vec_dot;
+                    vec_dot(ne00, &tmp, 0, src0_cur + ir0 * nb01, 0, src1_row, 0, 1);
+                    dst_col[ir0] = tmp;
+                }
+            }
+            }
+            if(capture) { moe_observe_record r; r.type=1; r.step=l->events?l->events-1:0;
+                r.layer=l->il; r.expert=(size_t)s<l->slot_expert.size()?l->slot_expert[s]:-1;
+                r.component=proj; r.worker=ith; r.flags=j; r.start_ms=compute0; r.end_ms=now_ms();
+                r.value=thread_cpu_ms()-cpu0; observer.emit(r); }
+        }
+    };
+
+    // correction 5: first-touch matmul for exactly one cycled n, measured before the
+    // production run_selected(n_ids) touches the selected weight rows.
+    if (g.direct_bench > 0) {
+        if (ith == 0) {
+            g.tl_ft_now = 0;
+            const uint64_t seen = g.tl_op_n[proj];
+            const bool due = (seen % (uint64_t) g.direct_bench_stride) == 0;
+            if (due) {
+                const int cand = 1 + (int) ((seen / (uint64_t) g.direct_bench_stride) % (uint64_t) n_ids);
+                if (cand >= 1 && cand <= n_ids && g.tl_ft_done[proj][cand] < (uint64_t) g.direct_bench) {
+                    g.tl_ft_now = proj + 1;
+                    g.tl_ft_n = cand;
+                    g.tl_ft_done[proj][cand]++;
+                }
+            }
+        }
+        ggml_barrier(params->threadpool);
+        const int ft_proj = g.tl_ft_now;
+        const int ft_n = g.tl_ft_n;
+        if (ft_proj > 0 && ft_n >= 1 && ft_n <= n_ids) {
+            const double ft0 = (ith == 0) ? now_ms() : 0.0;
+            run_selected(ft_n);
+            ggml_barrier(params->threadpool);
+            if (ith == 0) {
+                g.tl_bench_first_us[proj][ft_n].push_back((now_ms() - ft0) * 1000.0);
+            }
+            ggml_barrier(params->threadpool);
+        }
+    }
+
+    const double op_t0 = (g.timeline && ith == 0) ? now_ms() : 0.0;
+
+    run_selected(n_ids, true);
+
+    if (g.timeline) {
+        ggml_barrier(params->threadpool);
+        if (ith == 0) {
+            const double opdt = now_ms() - op_t0;
+            g.tl_op_ms[proj] += opdt;
+            g.tl_op_n[proj]++;
+            if (proj == 0) { g.tl_event_op_gate_ms.push_back(opdt); }
+            else if (proj == 1) { g.tl_event_op_up_ms.push_back(opdt); }
+            else { g.tl_event_op_down_ms.push_back(opdt); }
+        }
+    }
+
+    // Execution 017: exact cost of n = 1..n_ids selected experts on the real
+    // resident weights. Bounded by LLAMA_MOE_PAGING_DIRECT_BENCH samples/projection.
+    if (g.direct_bench > 0) {
+        if (ith == 0) {
+            const uint64_t seen = g.tl_op_n[proj];
+            const bool due = (seen % (uint64_t) g.direct_bench_stride) == 0;
+            g.tl_bench_now = (due && g.tl_bench_done[proj] < (uint64_t) g.direct_bench) ? proj + 1 : 0;
+            if (g.tl_bench_now > 0) {
+                g.tl_bench_done[proj]++;
+            }
+        }
+        ggml_barrier(params->threadpool);
+        const int bench_proj = g.tl_bench_now;
+        if (bench_proj > 0) {
+            for (int n = 1; n <= n_ids; n++) {
+                ggml_barrier(params->threadpool);
+                const double c0 = (ith == 0) ? now_ms() : 0.0;
+                if (src1->type != vec_dot_type) {
+                    const int64_t n_conv = std::min<int64_t>(n, ne11);
+                    for (int64_t i11c = ith; i11c < n_conv; i11c += nth) {
+                        from_float((const float *) ((const char *) src1->data + (size_t) i11c * nb11),
+                                   wbuf + (size_t) i11c * nbw1,
+                                   ne10);
+                    }
+                }
+                ggml_barrier(params->threadpool);
+                const double b0 = (ith == 0) ? now_ms() : 0.0;
+                run_selected(n);
+                ggml_barrier(params->threadpool);
+                if (ith == 0) {
+                    const double bend = now_ms();
+                    g.tl_bench_conv_us[bench_proj - 1][n].push_back((b0 - c0) * 1000.0);
+                    g.tl_bench_us[bench_proj - 1][n].push_back((bend - b0) * 1000.0);
+                    g.tl_bench_full_us[bench_proj - 1][n].push_back((bend - c0) * 1000.0);
+                }
+            }
+            // restore the full production result (the kernel is deterministic)
+            ggml_barrier(params->threadpool);
+            run_selected(n_ids);
+            ggml_barrier(params->threadpool);
+            // correction 4: directly measured activation and routed-output weighting
+            if (bench_proj == 3 && l->tl_gate_out != nullptr && l->tl_up_out != nullptr &&
+                    l->tl_down_out != nullptr) {
+                const int n_ff  = (int) l->tl_gate_out->ne[0];
+                const int n_emb = (int) l->tl_down_out->ne[0];
+                const size_t need = (size_t) 8 * ((size_t) n_ff + (size_t) n_emb) + 16;
+                if (g.tl_bench_scratch.size() < need) {
+                    g.tl_bench_scratch.resize(need);
+                }
+                float * sact = g.tl_bench_scratch.data();
+                float * sout = sact + 8 * (size_t) n_ff;
+                for (int n = 1; n <= n_ids; n++) {
+                    ggml_barrier(params->threadpool);
+                    const double a0 = (ith == 0) ? now_ms() : 0.0;
+                    for (int j = ith; j < n; j += nth) {
+                        const float * gcol = (const float *) ((const char *) l->tl_gate_out->data + (size_t) j * l->tl_gate_out->nb[1]);
+                        const float * ucol = (const float *) ((const char *) l->tl_up_out->data   + (size_t) j * l->tl_up_out->nb[1]);
+                        ggml_vec_swiglu_f32(n_ff, sact + (size_t) j * n_ff, gcol, ucol);
+                    }
+                    ggml_barrier(params->threadpool);
+                    if (ith == 0) {
+                        g.tl_bench_act_us[n].push_back((now_ms() - a0) * 1000.0);
+                    }
+                    ggml_barrier(params->threadpool);
+                    const double o0 = (ith == 0) ? now_ms() : 0.0;
+                    for (int j = ith; j < n; j += nth) {
+                        const float * dcol = (const float *) ((const char *) l->tl_down_out->data + (size_t) j * l->tl_down_out->nb[1]);
+                        float * ocol = sout + (size_t) j * n_emb;
+                        for (int i = 0; i < n_emb; i++) {
+                            ocol[i] = dcol[i] * g.tl_bench_scale;
+                        }
+                    }
+                    ggml_barrier(params->threadpool);
+                    if (ith == 0) {
+                        g.tl_bench_out_us[n].push_back((now_ms() - o0) * 1000.0);
+                    }
+                }
+            }
+            if (ith == 0) {
+                g.tl_bench_now = 0;
+            }
+        }
+    }
+
+    // Execution 017 Part D: inject the early-computed ready experts; in verify mode
+    // diff them byte-for-byte against the canonical direct_sparse down result.
+    if (g.overlap_enabled) {
+        ggml_barrier(params->threadpool);
+        if (ith == 0) {
+            const int n_emb = (int) (proj == 2 ? l->slot_down->ne[1] : l->slot_gate->ne[1]);
+            for (int j = 0; j < n_ids; j++) {
+                if (!l->early_ready[j]) { continue; }
+                float * dcol = (float *) ((char *) dst->data + (size_t) j * nb1);
+                const auto & buf = proj == 0 ? l->early_gate : proj == 1 ? l->early_up : l->early_out;
+                const float * e = buf.data() + (size_t) j * (size_t) n_emb;
+                if (g.overlap_verify) {
+                    int mism = 0;
+                    for (int r = 0; r < n_emb; r++) {
+                        if (memcmp(&dcol[r], &e[r], sizeof(float)) != 0) { mism++; }
+                    }
+                    if (mism > 0) {
+                        g.ov_verify_fail++;
+                        fprintf(stderr, "MOE_OVERLAP_VERIFY layer=%d j=%d slot=%d mismatches=%d\n",
+                                l->il, j, sel[j], mism);
+                        GGML_ABORT("early compute differential mismatch; stopping immediately");
+                    } else {
+                        g.ov_verify_pass++;
+                    }
+                }
+                memcpy(dcol, e, (size_t) n_emb * sizeof(float));
+            }
+        }
+        ggml_barrier(params->threadpool);
+    }
+
+    // Execution 012 debug: run the ordinary CPU implementation on the same op and
+    // compare full tensors. Active only when LLAMA_MOE_PAGING_DIRECT_VERIFY=1. The
+    // generic result is kept in dst, so generation stays exact while checking.
+    {
+        if (ith == 0) {
+            g.direct_verify_now = g.direct_verify && g.direct_verify_done < g.direct_verify_n;
+            if (g.direct_verify_now) {
+                g.direct_verify_done++;
+            }
+        }
+        ggml_barrier(params->threadpool);
+        if (g.direct_verify_now) {
+            const size_t nbytes = ggml_nbytes(dst);
+            float * saved = (ith == 0) ? (float *) malloc(nbytes) : nullptr;
+            if (ith == 0 && saved != nullptr) {
+                memcpy(saved, dst->data, nbytes);
+            }
+            ggml_cpu_compute_forward_mul_mat_id_ref(params, op);
+            ggml_barrier(params->threadpool);
+            if (ith == 0 && saved != nullptr) {
+                const float * ref = (const float *) dst->data;
+                double max_abs = 0.0;
+                double max_rel = 0.0;
+                const int64_t ne = ggml_nelements(dst);
+                for (int64_t i = 0; i < ne; i++) {
+                    const double a = (double) saved[i];
+                    const double b = (double) ref[i];
+                    const double d = std::fabs(a - b);
+                    if (d > max_abs) { max_abs = d; }
+                    const double den = std::max(1e-9, std::fabs(b));
+                    if (d / den > max_rel) { max_rel = d / den; }
+                }
+                const bool same = (max_abs == 0.0);
+                g.direct_verify_pass += same ? 1 : 0;
+                g.direct_verify_fail += same ? 0 : 1;
+                if (max_abs > g.direct_verify_max_abs) { g.direct_verify_max_abs = max_abs; }
+                const char * proj = (src0 == l->slot_gate) ? "gate"
+                                  : (src0 == l->slot_up)   ? "up"
+                                  : (src0 == l->slot_down) ? "down" : "?";
+                fprintf(stderr, "MOE_DIRECT_VERIFY op=%d layer=%d proj=%s ne11=%lld n_ids=%d slots=[",
+                        g.direct_verify_done, l->il, proj, (long long) ne11, n_ids);
+                for (int i = 0; i < n_ids; i++) {
+                    fprintf(stderr, "%s%d", i ? "," : "", sel[order[i]]);
+                }
+                fprintf(stderr, "] max_abs=%.9g max_rel=%.9g identical=%d\n", max_abs, max_rel, same ? 1 : 0);
+                free(saved);
+            }
+        }
+    }
+
+    // Keep the timing mirror that the consumed op would otherwise record. Token
+    // accounting is owned by llama_moe_paging_slots, which fires once per layer
+    // event; counting here as well overcounted every direct token four times.
+    if (g.timing) {
+        l->compute_ms += now_ms() - l->compute_start_ms;
+    }
+
+    return true;
+}
+
+bool llama_moe_paging_timing_enabled() {
+    return g.timing;
+}
+
+llama_moe_paging_layer * llama_moe_paging_layer_for(int il) {
+    if (!g.enabled || il < 0 || il >= (int) g.layers.size()) {
+        return nullptr;
+    }
+    llama_moe_paging_layer * l = &g.layers[il];
+    // direct storage has no K8 tensors; the resident-slot tensors are the storage
+    if (llama_moe_paging_direct_storage()) {
+        return l->slot_gate != nullptr ? l : nullptr;
+    }
+    return l->stage_gate != nullptr ? l : nullptr;
+}
+
+void llama_moe_paging_stage(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    const int64_t k = a->ne[0];
+    const int64_t n_tok = a->ne[1];
+    if (k <= 0 || k > MAX_K) {
+        GGML_ABORT("moe paging: unsupported n_expert_used=%lld", (long long) k);
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        int32_t req[MAX_K];
+        int32_t slot[MAX_K];
+        for (int64_t i = 0; i < k; i++) {
+            req[i] = *(const int32_t *) ((const char *) a->data + t * a->nb[1] + i * a->nb[0]);
+        }
+        stage_event(*l, req, (int) k, slot);
+        for (int64_t i = 0; i < k; i++) {
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + i * dst->nb[0]) = slot[i];
+        }
+    }
+    if (l->il == g.n_layer - 1) {
+        g.tokens++;
+        if (g.stats_interval > 0 && g.tokens >= g.last_flush_tokens + (uint64_t) g.stats_interval) {
+            dump_stats();
+            g.last_flush_tokens = g.tokens;
+        }
+    }
+}
+
+void llama_moe_paging_end(ggml_tensor * dst, const ggml_tensor * a,
+                          int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    GGML_UNUSED(dst);
+    GGML_UNUSED(a);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    const double t = now_ms();
+    l->compute_ms += t - l->compute_start_ms;
+    if (observer.mode) { moe_observe_record r; r.type=3; r.layer=l->il; r.step=l->events?l->events-1:0;
+        r.start_ms=l->compute_start_ms; r.end_ms=t; observer.emit(r); }
+    if (g.timeline && l->tl_demand_unblock_ms > 0.0) {
+        g.tl_expert_ms += t - l->tl_demand_unblock_ms;
+        g.tl_expert_n++;
+        g.tl_event_expert_ms.push_back(t - l->tl_demand_unblock_ms);
+    }
+}
+
+bool llama_moe_paging_shexp_timing() {
+    return g.enabled && g.timeline && g.prefetch_enabled;
+}
+
+void llama_moe_paging_shexp_start(ggml_tensor * dst, const ggml_tensor * a,
+                                  int ith, int nth, void * userdata) {
+    if (ith == 0) {
+        auto * l = (llama_moe_paging_layer *) userdata;
+        l->tl_shexp_start_ms = now_ms();
+    }
+    GGML_UNUSED(nth);
+    memcpy(dst->data, a->data, ggml_nbytes(a));
+}
+
+void llama_moe_paging_shexp_end(ggml_tensor * dst, const ggml_tensor * a,
+                                int ith, int nth, void * userdata) {
+    if (ith == 0) {
+        auto * l = (llama_moe_paging_layer *) userdata;
+        const double t = now_ms();
+        if (l->tl_shexp_start_ms > 0.0) {
+            const double dt = t - l->tl_shexp_start_ms;
+            // The slots op increments g.tokens at the last layer before this
+            // marker runs, so undo that one-step skew.
+            const uint64_t step = (l->il == g.n_layer - 1 && g.tokens > 0) ? g.tokens - 1 : g.tokens;
+            g.tl_shexp_ms += dt;
+            g.tl_shexp_n++;
+            g.tl_shexp_step.push_back(step);
+            g.tl_shexp_ev_ms.push_back(dt);
+            l->tl_shexp_start_ms = 0.0;
+        }
+    }
+    GGML_UNUSED(nth);
+    memcpy(dst->data, a->data, ggml_nbytes(a));
+}
+
+// C-linkage entry registered with ggml-cpu (see ggml_cpu_set_moe_mul_mat_id_hook).
+extern "C" bool llama_moe_paging_direct_mul_mat_id(struct ggml_compute_params * params, struct ggml_tensor * op) {
+    return llama_moe_paging_direct_mul_mat_id_impl(params, op);
+}
+
+// Execution 022 passive graph landmarks. userdata encodes (phase*64 + layer+1).
+bool llama_moe_observe_enabled() { return g.enabled && observer.mode; }
+void llama_moe_observe_marker(ggml_tensor * dst, const ggml_tensor * a, int ith, int nth, void * userdata) {
+    GGML_UNUSED(dst); GGML_UNUSED(a); GGML_UNUSED(nth);
+    if (ith != 0 || !observer.mode) { return; }
+    const uintptr_t tag=(uintptr_t)userdata; const int phase=(int)(tag/64), layer=(int)(tag%64)-1;
+    moe_observe_record r; r.type=phase; r.layer=layer;
+    r.step = phase>=10 && g.tokens ? g.tokens-1 : g.tokens;
+    if (layer>=0 && phase>=8 && (size_t)layer<g.layers.size() && g.layers[layer].events) { r.step=g.layers[layer].events-1; }
+    r.start_ms=r.end_ms=now_ms();
+    const int index=layer<0?40:layer;
+    GGML_ASSERT(index>=0 && index<=40 && phase>=0 && phase<16);
+    const int previous=phase==7?6:phase==8?7:phase==9?8:phase==11?10:phase==12?11:phase==14?13:-1;
+    if (previous>=0 && observe_phase_ms[index][previous]>0) { r.start_ms=observe_phase_ms[index][previous]; }
+    observe_phase_ms[index][phase]=r.end_ms;
+    observer.emit(r);
+}
+
+void llama_moe_observe_a0(ggml_tensor * dst, const ggml_tensor * a, const ggml_tensor * ids,
+                         const ggml_tensor * scores, int ith, int nth, void * userdata) {
+    if (ith==0 && observer.mode) {
+        auto * l=(llama_moe_paging_layer *)userdata;
+        for(int i=0;i<ids->ne[0];++i) { const int expert=*(const int32_t*)((const char*)ids->data+i*ids->nb[0]);
+            GGML_ASSERT(expert>=0 && expert<scores->ne[0] && scores->type==GGML_TYPE_F32);
+            moe_observe_record r; r.type=4; r.step=g.tokens; r.layer=l->il; r.expert=expert; r.component=i+1;
+            r.value=*(const float*)((const char*)scores->data+expert*scores->nb[0]); r.start_ms=r.end_ms=now_ms(); observer.emit(r);
+        }
+    }
+    llama_moe_paging_prefetch_a0(dst,a,ids,ith,nth,userdata);
+}
diff --git a/src/llama-moe-paging.h b/src/llama-moe-paging.h
new file mode 100644
index 000000000..f18b3ba23
--- /dev/null
+++ b/src/llama-moe-paging.h
@@ -0,0 +1,311 @@
+#pragma once
+
+// Execution 004: decoupled staging + parallel cold I/O for CPU/hybrid MoE paging.
+//
+// Execution 003 coupled cache capacity M to the CPU mul_mat_id expert dimension:
+// every layer owned M-slot gate/up/down tensors, and the graph remapped global
+// expert ids to those M slots. Larger M meant more I/O hits but a slower kernel.
+//
+// This module keeps two separate objects per layer:
+//
+//   * resident cache: M raw record-layout byte slots, replaced by LRU or
+//     event-decay90; capacity M is independent of the compute shape;
+//   * staging: exactly K = n_expert_used gate/up/down tensors whose expert
+//     dimension is always K (8 for Qwen3.6-35B-A3B). The graph calls mul_mat_id
+//     on the staging tensors only, after the selected K experts are copied in.
+//
+// All misses of one layer event are gathered first and read through a bounded
+// reusable worker pool (QD 1/2/4/8). Two storage backends are supported:
+// one packed record per expert, or three component reads straight from the
+// source GGUF. Reads can be marked best-effort uncached (F_NOCACHE on macOS).
+//
+// Enabled when LLAMA_MOE_PAGING_M is set to a positive integer.
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_model;
+struct ggml_context;
+struct ggml_tensor;
+struct ggml_compute_params;
+typedef struct ggml_backend_buffer * ggml_backend_buffer_t;
+
+struct moe_prefetch_nomination {
+    int32_t expert = -1, rank = 0;
+    bool admitted = false, submitted = false;
+    uint64_t observations = 0, useful = 0;
+    // Execution 021: snapshots before this event's authoritative labels.
+    double decision_ms = 0.0, lead_ms = 0.0, read_ms = 0.0, queue_ms = 0.0;
+    double expected_gain_ms = 0.0;
+    uint64_t lead_samples = 0, read_samples = 0;
+};
+
+struct llama_moe_paging_layer {
+    int il = -1;
+
+    // K = n_expert_used staging tensors, expert dimension always K
+    ggml_tensor * stage_gate = nullptr;
+    ggml_tensor * stage_up   = nullptr;
+    ggml_tensor * stage_down = nullptr;
+
+    // Execution 009 direct_sparse: plain CPU resident-slot tensors with expert
+    // dimension M. Only the K selected slots are consumed by the CPU matmul, and
+    // a cold miss reads straight into the final resident slot. No K8 staging copy.
+    ggml_tensor * slot_gate = nullptr;
+    ggml_tensor * slot_up   = nullptr;
+    ggml_tensor * slot_down = nullptr;
+    ggml_context *        slot_ctx = nullptr;
+    ggml_backend_buffer_t slot_buf = nullptr;
+
+    ggml_context *        stage_ctx = nullptr;
+    ggml_backend_buffer_t stage_buf = nullptr;
+
+    // resident M-slot cache, one record-layout block per slot
+    std::vector<uint8_t> cache;
+    int n_slots = 0;
+    std::vector<int32_t>  slot_expert;  // global expert id per slot, -1 == empty
+    std::vector<uint64_t> last_use;     // per-slot recency clock
+    std::vector<double>   score;        // event-decay90 score
+    // Execution 019: authoritative demand history, including evicted experts.
+    std::vector<uint64_t> demand_frequency, demand_last_event;
+    std::vector<uint64_t> shadow_frequency, shadow_last_event;
+    std::vector<uint8_t>  reserved;     // per event: slot is a miss destination
+
+    // component geometry inside a record
+    int64_t gate_bytes = 0;
+    int64_t up_bytes   = 0;
+    int64_t down_bytes = 0;
+    int64_t gate_off   = 0;
+    int64_t up_off     = 0;
+    int64_t down_off   = 0;
+
+    // absolute GGUF offsets for backend=gguf3
+    int64_t gguf_gate_off = 0;
+    int64_t gguf_up_off   = 0;
+    int64_t gguf_down_off = 0;
+
+    // persistent K8 stage bookkeeping (Execution 008). Each entry records which
+    // global expert the stage position currently holds; -1 means unknown.
+    std::vector<int32_t> stage_expert;
+
+    // instrumentation
+    uint64_t hits       = 0;
+    uint64_t misses     = 0;
+    uint64_t evictions  = 0;
+    uint64_t bytes_read = 0;
+    uint64_t stage_bytes = 0;        // logical K * record_stride per event
+    uint64_t events     = 0;
+    uint64_t qd_sum     = 0;
+    uint64_t qd_max     = 0;
+    uint64_t miss_hist[9] = {};   // layer events with 0..8 unique misses
+    uint64_t readset_hist[32] = {}; // read-set latency buckets for this layer
+
+    // staging traffic split (Execution 008)
+    uint64_t stage_cache_bytes = 0;  // resident cache -> stage
+    uint64_t stage_move_bytes  = 0;  // stage -> stage (includes the scratch record)
+    uint64_t stage_retain_bytes = 0; // exact-position retains, zero copy
+    uint64_t stage_hit_bytes   = 0;  // staged bytes that were resident-cache hits
+    uint64_t stage_miss_bytes  = 0;  // staged bytes that came from a miss read
+    uint64_t retain_exact      = 0;  // experts retained in place
+    uint64_t moved_in_stage    = 0;  // experts permuted within the K8 stage
+    uint64_t newly_staged      = 0;  // experts copied into the K8 stage
+
+    double   fault_ms   = 0.0;    // historical name: caller-blocking wait on the miss read set (== read_wait_ms)
+    double   read_wait_ms = 0.0;  // caller-blocking wait after pre-wait staging; excludes overlapped read time
+    double   stage_ms   = 0.0;    // total staging copy time (pre + post wait)
+    double   stage_copy_ms = 0.0; // same as stage_ms, explicit split
+    double   stage_pre_wait_ms = 0.0;  // copy work done while reads are outstanding
+    double   stage_post_wait_ms = 0.0; // copy work after the read set is ready
+    double   stage_wall_ms = 0.0; // resolve/read-submit -> stage-ready
+    double   readset_wall_ms = 0.0; // full miss read-set wall: submit/start -> completion (includes overlapped pre-wait staging)
+
+    // Execution 009 direct_sparse instrumentation
+    uint64_t direct_calls             = 0;  // paging slot-resolution events (one per layer event)
+    uint64_t direct_mul_mat_id_calls  = 0;  // CPU MUL_MAT_ID ops served by the direct kernel (once per op)
+    uint64_t direct_selected_matrices = 0;  // == direct_mul_mat_id_calls * K
+    uint64_t direct_fallback_calls    = 0;
+    uint64_t direct_materialize_bytes = 0;
+    uint64_t direct_repack_bytes      = 0;
+    double   compute_ms = 0.0;    // router weights -> expert down projection
+    double   compute_start_ms = 0.0;
+
+    // Execution 014 diagnostic oracle early-start. Only direct_sparse uses these.
+    // early_slot: 0 none, 1 EARLY_RESERVED, 2 EARLY_LOADING.
+    std::vector<uint8_t> early_slot;
+    std::vector<uint8_t> oracle_reserved;  // plan scratch
+    bool    oracle_plan_valid = false;
+    int     oracle_n_miss = 0;
+    int64_t oracle_event = -1;
+    int32_t oracle_req[8]  = {};
+    int32_t oracle_slot[8] = {};
+    bool    oracle_is_miss[8] = {};
+    double  oracle_submit_ms = 0.0;
+    double  oracle_layer_start_ms = 0.0;
+
+    // Execution 015 protected probation slots. slot_state: 0 EMPTY, 1 DEMAND,
+    // 2 PREFETCH_LOADING, 3 PREFETCH_READY. Physical slots M+P; exactly M are
+    // logical DEMAND while the cache is warm.
+    std::vector<uint8_t>  slot_state;
+    std::vector<double>   pf_submit_ms;   // per-slot prefetch submit clock
+    int                   demand_count = 0;
+    // independent demand-only LRU model used to assert logical cache identity
+    std::vector<int32_t>  shadow_expert;
+    std::vector<uint64_t> shadow_last_use;
+    int                   shadow_n = 0;
+    // a0_shadow: the candidate set chosen at the layer-start A0 event
+    int32_t               pf_cand[32] = {};
