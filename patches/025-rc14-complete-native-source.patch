+#if defined(__aarch64__) && defined(__ARM_FEATURE_DOTPROD) && !defined(__ARM_FEATURE_SVE)
+#include <arm_neon.h>
+template <int N> static inline uint8x16_t col(const uint8_t *b, int c) {
+    if constexpr (N == 16)
+        return vld1q_u8(b + c * N);
+    else
+        return vcombine_u8(vld1_u8(b + c * N), vdup_n_u8(0));
+}
+template <int N> static inline void decode(const uint8_t *p, bool q6, int8x16_t *w) {
+    const auto mask = vdupq_n_u8(15);
+    const auto lo0 = vld1q_u8(p);
+    if constexpr (N == 16) {
+        const auto lo1 = vld1q_u8(p + 16);
+        uint8x16_t a[4] = {vandq_u8(lo0, mask), vandq_u8(lo1, mask), vshrq_n_u8(lo0, 4), vshrq_n_u8(lo1, 4)};
+        if (q6) {
+            const auto h = vld1q_u8(p + 32);
+            const auto m = vdupq_n_u8(3);
+            a[0] = vorrq_u8(a[0], vshlq_n_u8(vandq_u8(h, m), 4));
+            a[1] = vorrq_u8(a[1], vshlq_n_u8(vandq_u8(vshrq_n_u8(h, 2), m), 4));
+            a[2] = vorrq_u8(a[2], vshlq_n_u8(vandq_u8(vshrq_n_u8(h, 4), m), 4));
+            a[3] = vorrq_u8(a[3], vshlq_n_u8(vshrq_n_u8(h, 6), 4));
+        }
+        for (int i = 0; i < 4; ++i)
+            w[i] = vreinterpretq_s8_u8(a[i]);
+    } else {
+        auto a = vandq_u8(lo0, mask), b = vshrq_n_u8(lo0, 4);
+        if (q6) {
+            const auto h = vld1_u8(p + 16), m = vdup_n_u8(3);
+            auto h0 = vcombine_u8(vand_u8(h, m), vand_u8(vshr_n_u8(h, 2), m));
+            auto h1 = vcombine_u8(vand_u8(vshr_n_u8(h, 4), m), vshr_n_u8(h, 6));
+            a = vorrq_u8(a, vshlq_n_u8(h0, 4));
+            b = vorrq_u8(b, vshlq_n_u8(h1, 4));
+        }
+        w[0] = vreinterpretq_s8_u8(a);
+        w[1] = vreinterpretq_s8_u8(b);
+    }
+}
+
+template <int L, bool Q6>
+static inline float32x4_t continue_lane(float32x4_t state, int32x4_t a, int32x4_t b, const uint8_t *h,
+                                        float yd) {
+    ggml_half hd, hm;
+    std::memcpy(&hd, h, 2);
+    float sum = vgetq_lane_f32(state, L);
+    if constexpr (!Q6) {
+        std::memcpy(&hm, h + 2, 2);
+        const float d = yd * GGML_CPU_FP16_TO_FP32(hd);
+        const float dmin = yd * GGML_CPU_FP16_TO_FP32(hm);
+        sum -= dmin * vgetq_lane_s32(b, L);
+        sum += d * vgetq_lane_s32(a, L);
+    } else {
+        const float d_all = GGML_CPU_FP16_TO_FP32(hd);
+        sum += d_all * yd * vgetq_lane_s32(a, L);
+    }
+    return vsetq_lane_f32(sum, state, L);
+}
+
+template <int N, bool Q6>
+__attribute__((noinline)) static void kernel(const uint8_t *in, const block_q8_K *y, float *out, int rows,
+                                             int nb) {
+    constexpr int V = N / 4, SZ = Q6 ? 210 : 144, NH = Q6 ? 18 : 16, NG = Q6 ? 16 : 8, NQ = Q6 ? 4 : 8;
+    for (int t = 0; t < rows / N; ++t) {
+        float32x4_t sums[V];
+        for (auto &s : sums)
+            s = vdupq_n_f32(0);
+        for (int bp = 0; bp < nb; ++bp) {
+            const auto *block = in + (t * nb + bp) * N * SZ;
+            const auto *payload = block + N * NH;
+            int32x4_t A[V], B[V];
+            for (int i = 0; i < V; ++i)
+                A[i] = B[i] = vdupq_n_s32(0);
+            for (int g = 0; g < NG; ++g) {
+                int32x4_t dot[V];
+                for (auto &v : dot)
+                    v = vdupq_n_s32(0);
+                for (int p = 0; p < NQ; ++p) {
+                    int8x16_t w[V];
+                    decode<N>(payload + (g * NQ + p) * (Q6 ? 3 : 2) * N, Q6, w);
+                    int32_t quad;
+                    std::memcpy(&quad, y[bp].qs + (g * NQ + p) * 4, 4);
+                    auto q = vreinterpretq_s8_s32(vdupq_n_s32(quad));
+                    for (int i = 0; i < V; ++i)
+                        dot[i] = vdotq_s32(dot[i], w[i], q);
+                }
+                uint8x16_t s, m;
+                if constexpr (Q6) {
+                    s = col<N>(block, g);
+                    m = s;
+                } else if (g < 4) {
+                    s = vandq_u8(col<N>(block, 4 + g), vdupq_n_u8(63));
+                    m = vandq_u8(col<N>(block, 8 + g), vdupq_n_u8(63));
+                } else {
+                    auto x = col<N>(block, g), yy = col<N>(block, g + 4), z = col<N>(block, g + 8);
+                    s = vorrq_u8(vandq_u8(z, vdupq_n_u8(15)), vshlq_n_u8(vshrq_n_u8(x, 6), 4));
+                    m = vorrq_u8(vshrq_n_u8(z, 4), vshlq_n_u8(vshrq_n_u8(yy, 6), 4));
+                }
+                int16x8_t ss[2], mm[2];
+                if constexpr (Q6) {
+                    ss[0] = vmovl_s8(vreinterpret_s8_u8(vget_low_u8(s)));
+                    ss[1] = vmovl_s8(vreinterpret_s8_u8(vget_high_u8(s)));
+                    mm[0] = ss[0];
+                    mm[1] = ss[1];
+                } else {
+                    ss[0] = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(s)));
+                    ss[1] = vreinterpretq_s16_u16(vmovl_u8(vget_high_u8(s)));
+                    mm[0] = vreinterpretq_s16_u16(vmovl_u8(vget_low_u8(m)));
+                    mm[1] = vreinterpretq_s16_u16(vmovl_u8(vget_high_u8(m)));
+                }
+                int16_t bs = Q6 ? y[bp].bsums[g] : y[bp].bsums[2 * g] + y[bp].bsums[2 * g + 1];
+                for (int i = 0; i < V; ++i) {
+                    auto sc = (i % 2) ? vget_high_s16(ss[i / 2]) : vget_low_s16(ss[i / 2]);
+                    auto mi = (i % 2) ? vget_high_s16(mm[i / 2]) : vget_low_s16(mm[i / 2]);
+                    A[i] = vmlaq_s32(A[i], dot[i], vmovl_s16(sc));
+                    B[i] = vmlal_s16(B[i], mi, vdup_n_s16(bs));
+                }
+            }
+            for (int i = 0; i < V; ++i) {
+                if constexpr (Q6)
+                    A[i] = vsubq_s32(A[i], vshlq_n_s32(B[i], 5));
+                auto *h = block + (Q6 ? 16 * N + 8 * i : 16 * i);
+                constexpr int STEP = Q6 ? 2 : 4;
+                sums[i] = continue_lane<0, Q6>(sums[i], A[i], B[i], h, y[bp].d);
+                sums[i] = continue_lane<1, Q6>(sums[i], A[i], B[i], h + STEP, y[bp].d);
+                sums[i] = continue_lane<2, Q6>(sums[i], A[i], B[i], h + 2 * STEP, y[bp].d);
+                sums[i] = continue_lane<3, Q6>(sums[i], A[i], B[i], h + 3 * STEP, y[bp].d);
+            }
+        }
+        for (int i = 0; i < V; ++i)
+            vst1q_f32(out + t * N + 4 * i, sums[i]);
+    }
+}
+bool moe_tiled_dot(const uint8_t *p, const void *q, float *out, int rows, int nb, int nr, bool q6) {
+    assert((nr == 8 || nr == 16) && rows % nr == 0);
+    const auto *y = static_cast<const block_q8_K *>(q);
+    uint64_t fpcr;
+    __asm__ volatile("mrs %0, fpcr" : "=r"(fpcr));
+    if (fpcr != 0)
+        return false;
+    for (int bp = 0; bp < nb; ++bp) {
+        if (!std::isfinite(y[bp].d) || std::fabs(y[bp].d) > 1e20f)
+            return false;
+        for (int g = 0; g < 16; ++g)
+            if (y[bp].bsums[g] < -2048 || y[bp].bsums[g] > 2032)
+                return false;
+    }
+    const int sz = q6 ? 210 : 144;
+    for (int t = 0; t < rows / nr; ++t)
+        for (int bp = 0; bp < nb; ++bp) {
+            auto *b = p + (t * nb + bp) * nr * sz;
+            for (int r = 0; r < nr; ++r)
+                for (int k = 0; k < (q6 ? 1 : 2); ++k) {
+                    uint16_t h;
+                    std::memcpy(&h, b + (q6 ? 16 * nr + 2 * r : 4 * r) + 2 * k, 2);
+                    if ((h & 0x7c00) == 0x7c00)
+                        return false;
+                }
+        }
+    if (q6) {
+        if (nr == 16)
+            kernel<16, true>(p, y, out, rows, nb);
+        else
+            kernel<8, true>(p, y, out, rows, nb);
+    } else {
+        if (nr == 16)
+            kernel<16, false>(p, y, out, rows, nb);
+        else
+            kernel<8, false>(p, y, out, rows, nb);
+    }
+    return true;
+}
+
+#else
+bool moe_tiled_dot(const uint8_t *, const void *, float *, int, int, int, bool) { return false; }
+#endif
+
+#include "llama-moe-tiled.h"
+#include <cstring>
+#include <limits>
+
+static bool shape(int rows, int nb, int tile, bool q6, size_t capacity) {
+    const size_t size = q6 ? 210 : 144;
+    return rows > 0 && nb > 0 && (tile == 8 || tile == 16) && rows % tile == 0 &&
+           size_t(nb) <= capacity / size &&
+           size_t(rows) <= std::numeric_limits<size_t>::max() / size / size_t(nb) &&
+           nb <= std::numeric_limits<int>::max() / 256;
+}
+bool moe_tiled_unpack_row(const uint8_t *packed, void *raw, size_t capacity, int rows, int nb, int tile,
+                         bool q6, int row) {
+    if (!packed || !raw || !shape(rows, nb, tile, q6, capacity) || row < 0 || row >= rows)
+        return false;
+    const size_t size = q6 ? 210 : 144, header = q6 ? 18 : 16;
+    auto *out = static_cast<uint8_t *>(raw);
+    std::memset(out, 0, size_t(nb) * size);
+    const int lane = row % tile;
+    for (int bp = 0; bp < nb; ++bp) {
+        const auto *block = packed + (size_t(row / tile) * nb + bp) * tile * size;
+        auto *b = out + size_t(bp) * size;
+        if (q6) {
+            for (int c = 0; c < 16; ++c)
+                b[192 + c] = block[c * tile + lane];
+            std::memcpy(b + 208, block + 16 * tile + 2 * lane, 2);
+        } else {
+            std::memcpy(b, block + 4 * lane, 4);
+            for (int c = 4; c < 16; ++c)
+                b[c] = block[c * tile + lane];
+        }
+        for (int quad = 0; quad < 64; ++quad) {
+            const auto *p = block + header * tile + quad * (q6 ? 3 : 2) * tile;
+            for (int j = 0; j < 4; ++j) {
+                int f = 4 * lane + j, i = 4 * quad + j;
+                unsigned x = (p[f % (2 * tile)] >> (4 * (f / (2 * tile)))) & 15;
+                if (q6) {
+                    x |= ((p[2 * tile + f % tile] >> (2 * (f / tile))) & 3) << 4;
+                    int half = i / 128, local = i % 128;
+                    b[64 * half + local % 64] |= (x & 15) << (4 * (local / 64));
+                    b[128 + 32 * half + local % 32] |= (x >> 4) << (2 * (local / 32));
+                } else {
+                    b[16 + 32 * (i / 64) + i % 32] |= x << (4 * ((i % 64) / 32));
+                }
+            }
+        }
+    }
+    return true;
+}
+bool moe_tiled_reference_dot(const uint8_t *packed, const void *q8, float *out, int rows, int nb, int tile,
+                            bool q6, ggml_vec_dot_t dot, void *scratch, size_t capacity) {
+    if (!packed || !q8 || !out || !dot || !scratch || !shape(rows, nb, tile, q6, capacity))
+        return false;
+    for (int row = 0; row < rows; ++row) {
+        if (!moe_tiled_unpack_row(packed, scratch, capacity, rows, nb, tile, q6, row))
+            return false;
+        dot(nb * 256, out + row, 0, scratch, 0, q8, 0, 1);
+    }
+    return true;
+}
