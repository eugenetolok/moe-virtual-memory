+void resident_pool_stop() {
+    { std::lock_guard<std::mutex> lk(g.ov_m); g.ov_stop = true; }
+    g.ov_start.notify_all();
+    for (auto & w : g.ov_workers) { w.join(); }
+    g.ov_workers.clear();
+}
+
+void resident_parallel(const std::function<void(int)> & job) {
+    if (g.ov_threads == 1) { job(0); return; }
+    if (g.ov_workers.empty()) {
+        g.ov_stop = false;
+        for (int lane = 1; lane < g.ov_threads; ++lane) {
+            g.ov_workers.emplace_back([lane, initial_epoch = g.ov_epoch]() {
+                uint64_t seen = initial_epoch;
+                std::unique_lock<std::mutex> lk(g.ov_m);
+                for (;;) {
+                    g.ov_start.wait(lk, [&] { return g.ov_stop || g.ov_epoch != seen; });
+                    if (g.ov_stop) { return; }
+                    seen = g.ov_epoch;
+                    lk.unlock();
+                    g.ov_job(lane);
+                    lk.lock();
+                    if (--g.ov_running == 0) { g.ov_done.notify_one(); }
+                }
+            });
+        }
+    }
+    { std::lock_guard<std::mutex> lk(g.ov_m);
+      g.ov_job = job; g.ov_running = g.ov_threads - 1; ++g.ov_epoch; }
+    g.ov_start.notify_all();
+    job(0);
+    { std::unique_lock<std::mutex> lk(g.ov_m);
+      g.ov_done.wait(lk, [] { return g.ov_running == 0; }); }
+}
