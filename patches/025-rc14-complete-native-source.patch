+void llama_moe_paging_slots(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    const int64_t k = a->ne[0];
+    const int64_t n_tok = a->ne[1];
+    if (k <= 0 || k > MAX_K) {
+        GGML_ABORT("moe paging: unsupported n_expert_used=%lld", (long long) k);
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        int32_t req[MAX_K];
+        int32_t slot[MAX_K];
+        for (int64_t i = 0; i < k; i++) {
+            req[i] = *(const int32_t *) ((const char *) a->data + t * a->nb[1] + i * a->nb[0]);
+        }
+        if (g.oracle_capture && g.oracle_capture_f != nullptr && l->il >= 0) {
+            fwrite(req, sizeof(int32_t), (size_t) k, g.oracle_capture_f);
+            g.oracle_capture_events++;
+        }
+        stage_event(*l, req, (int) k, slot);
+        for (int64_t i = 0; i < k; i++) {
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + i * dst->nb[0]) = slot[i];
+        }
+    }
+    if (l->il == g.n_layer - 1) {
+        g.tokens++;
+        if (g.stats_interval > 0 && g.tokens >= g.last_flush_tokens + (uint64_t) g.stats_interval) {
+            dump_stats();
+            g.last_flush_tokens = g.tokens;
+        }
+    }
+}
+
+// Same production swiglu for cold columns, exact cached activation for ready columns.
+void llama_moe_paging_swiglu(ggml_tensor * dst, const ggml_tensor * gate, const ggml_tensor * up,
+                             int ith, int nth, void * userdata) {
+    auto * l = (llama_moe_paging_layer *) userdata;
+    GGML_ASSERT(gate->type == GGML_TYPE_F32 && up->type == GGML_TYPE_F32 && gate->ne[2] == 1);
+    const int n = gate->ne[0];
+    for (int j = ith; j < gate->ne[1]; j += nth) {
+        float * out = (float *) ((char *) dst->data + j * dst->nb[1]);
+        if (l->early_ready[j] && !g.overlap_verify) {
+            memcpy(out, l->early_act.data() + (size_t) j * n, n * sizeof(float));
+        } else {
+            ggml_vec_swiglu_f32(n, out, (const float *) ((const char *) gate->data + j * gate->nb[1]),
+                                       (const float *) ((const char *) up->data + j * up->nb[1]));
+        }
+    }
+}
