+double now_ms() {
+    using clk = std::chrono::steady_clock;
+    return std::chrono::duration<double, std::milli>(clk::now().time_since_epoch()).count();
+}
+
+// Exact read at off into dst. False on EOF, error, or injected fault.
+bool read_exact(int fd, void * buf, size_t n, off_t off) {
+    if (g.fault_after > 0 && g.reads_done.load() >= g.fault_after) {
+        return false;
+    }
+    size_t done = 0;
+    uint8_t * p = (uint8_t *) buf;
+    while (done < n) {
+        const ssize_t r = pread(fd, p + done, n - done, off + (off_t) done);
+        if (r < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (r == 0) {
+            return false;
+        }
+        done += (size_t) r;
+    }
+    g.reads_done.fetch_add(1);
+    return true;
+}
+
+uint8_t * read_dst(llama_moe_paging_layer & l, int32_t slot, int kind);
+
+// Execution 017 continuation: publish the gate/up/down completion of a promoted
+// speculative expert to the owning demand event.
+void record_expert_components(uint64_t ev, const tl_expert_rec * rec, int32_t slot, int32_t gid) {
+    if (rec == nullptr) {
+        return;
+    }
+    std::lock_guard<std::mutex> lk(g.tl_comp_m);
+    for (int kind = READ_GATE; kind <= READ_DOWN; kind++) {
+        if (rec->kind[kind].done.load()) {
+            g.tl_comp.push_back({ ev, slot, gid, (uint8_t) kind, rec->kind[kind].done_ms.load() });
+        }
+    }
+}
+
+void run_one_task(const io_task & t, int worker = -1) {
+#if defined(LLAMA_MOE_PAGING_BATCH_SELFTEST)
+    if (getenv("LLAMA_MOE_PAGING_PREFETCH_BATCHSELFTEST") != nullptr) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(120));
+    }
+#endif
+    int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+    uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+    const double t0 = now_ms();
+    const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+    const double done_ms = now_ms();
+    const double dt = done_ms - t0;
+    if (g.timeline && t.tl_rec != nullptr) {
+        t.tl_rec->done_ms.store(done_ms);
+        t.tl_rec->done.store(true);
+    }
+    {
+        std::lock_guard<std::mutex> lk(g.hist_m);
+        hist_add(g.hist, dt);
+        if ((g.pf_admission == "time_gate" || observer.mode) && ok && t.size > 0 && std::isfinite(dt) && dt > 0.0) {
+            const double sample = dt / (double) t.size;
+            g.pf_read_ms_per_byte = g.pf_read_samples == 0 ? sample :
+                                   0.875 * g.pf_read_ms_per_byte + 0.125 * sample;
+            if (g.pf_read_samples == UINT64_MAX) { GGML_ABORT("prefetch read sample overflow"); }
+            ++g.pf_read_samples;
+        }
+        if (observer.mode) {
+            auto record=t.observe; record.start_ms=t0; record.end_ms=done_ms;
+            record.worker=worker; record.flags |= ok?0:4;
+            record.value=g.pf_read_ms_per_byte; record.calibration_samples=g.pf_read_samples; observer.emit(record);
+        }
+        if (g.timeline) {
+            hist_add(g.tl_read_kind_hist[t.kind], dt);
+            g.tl_read_kind_n[t.kind]++;
+        }
+    }
+    if (g.timeline && t.event_id != (uint64_t) -1) {
+        std::lock_guard<std::mutex> lk(g.tl_comp_m);
+        g.tl_comp.push_back({ t.event_id, t.slot, t.gid, (uint8_t) t.kind, done_ms });
+    }
+    read_batch * b = t.batch;
+    if (b != nullptr) {
+        std::lock_guard<std::mutex> lk(b->m);
+        if (!ok) {
+            b->failed.store(true);
+        }
+        if (--b->remaining == 0) {
+            b->done_ms.store(done_ms);
+            b->cv.notify_all();
+        }
+    }
+}
+
+void worker_main(int worker) {
+    for (;;) {
+        io_task t;
+        {
+            std::unique_lock<std::mutex> lk(g.mtx);
+            g.cv_task.wait(lk, [] { return g.stopping || !g.queue_hi.empty() || !g.queue_lo.empty(); });
+            if (g.queue_hi.empty() && g.queue_lo.empty()) {
+                if (g.stopping) {
+                    return;
+                }
+                continue;
+            }
+            // demand (high priority) always before speculation (low priority)
+            if (!g.queue_hi.empty()) {
+                t = g.queue_hi.front();
+                g.queue_hi.pop_front();
+            } else {
+                t = g.queue_lo.front();
+                g.queue_lo.pop_front();
+            }
+            if (g.pf_admission == "time_gate" || observer.mode) { g.pf_active_bytes += t.size; }
+        }
+        run_one_task(t, worker);
+        if (g.pf_admission == "time_gate" || observer.mode) {
+            std::lock_guard<std::mutex> lk(g.mtx);
+            GGML_ASSERT(g.pf_active_bytes >= t.size);
+            g.pf_active_bytes -= t.size;
+        }
+    }
+}
+
+void observe_queued(io_task & t, bool high) {
+    if (!observer.mode) { return; }
+    auto & r = t.observe;
+    r.id = observer.next_id.fetch_add(1); r.step = g.tokens;
+    r.layer = t.layer->il; r.expert = t.gid; r.component = t.kind;
+    r.bytes = t.size; r.offset = t.offset; r.flags = high ? 1 : 0;
+    r.enqueue_ms = now_ms(); r.active_bytes=g.pf_active_bytes;
+    for (const auto & queued : g.queue_hi) { r.high_bytes += queued.size; }
+    for (const auto & queued : g.queue_lo) { r.low_bytes += queued.size; }
+}
+
+// Returns false if any read failed.
+bool run_read_tasks(const std::vector<io_task> & tasks) {
+    if (tasks.empty()) {
+        return true;
+    }
+    if (g.workers.empty()) {
+        for (const auto & t : tasks) {
+            int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+            uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+            const double t0 = now_ms();
+            const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+            const double dt = now_ms() - t0;
+            hist_add(g.hist, dt);
+            if (g.timeline) {
+                hist_add(g.tl_read_kind_hist[t.kind], dt);
+                g.tl_read_kind_n[t.kind]++;
+            }
+            if (!ok) {
+                return false;
+            }
+        }
+        return true;
+    }
+    read_batch batch;
+    batch.remaining.store((int) tasks.size());
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        for (const auto & t : tasks) {
+            io_task copy = t;
+            copy.batch = &batch;
+            observe_queued(copy, true);
+            g.queue_hi.push_back(copy);
+        }
+    }
+    g.cv_task.notify_all();
+    {
+        std::unique_lock<std::mutex> lk(batch.m);
+        batch.cv.wait(lk, [&] { return batch.remaining.load() == 0; });
+    }
+    return !batch.failed.load();
+}
+
+// Async read submission for overlap/persistent modes. The caller must keep `p`
+// alive until wait_read_tasks returns. QD1 stays synchronous (nothing to overlap).
+void submit_read_tasks(const std::vector<io_task> & tasks, read_pending & p, bool high = true) {
+    p.submitted = true;
+    p.ok = true;
+    if (tasks.empty()) {
+        return;
+    }
+    if (g.workers.empty()) {
+        for (const auto & t : tasks) {
+            int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+            uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+            const double r0 = now_ms();
+            const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+            const double dt = now_ms() - r0;
+            hist_add(g.hist, dt);
+            if (g.timeline) {
+                hist_add(g.tl_read_kind_hist[t.kind], dt);
+                g.tl_read_kind_n[t.kind]++;
+            }
+            if (!ok) { p.ok = false; break; }
+        }
+        p.batch.done_ms.store(now_ms());
+        return;
+    }
+    p.batch.done_ms.store(0.0);
+    p.batch.remaining.store((int) tasks.size());
+    p.batch.failed.store(false);
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        auto & q = high ? g.queue_hi : g.queue_lo;
+        for (const auto & t : tasks) {
+            io_task copy = t;
+            copy.batch = &p.batch;
+            observe_queued(copy, high);
+            q.push_back(copy);
+        }
+    }
+    g.cv_task.notify_all();
+    p.async = true;
+}
+
+// Execution 015: move not-yet-started speculative component tasks for one expert
+// to the high-priority queue when authoritative demand joins that expert.
+void promote_prefetch_tasks(llama_moe_paging_layer & l, int32_t gid) {
+    if (g.workers.empty()) {
+        return;
+    }
+    std::lock_guard<std::mutex> lk(g.mtx);
+    for (auto it = g.queue_lo.begin(); it != g.queue_lo.end(); ) {
+        if (it->layer == &l && it->gid == gid) {
+            if (observer.mode) { it->observe.promotion_ms = now_ms(); it->observe.flags |= 2; }
+            g.queue_hi.push_back(*it);
+            it = g.queue_lo.erase(it);
+        } else {
+            ++it;
+        }
+    }
+}
+
+bool wait_read_tasks(read_pending & p) {
+    if (!p.submitted) {
+        return true;
+    }
+    if (p.async) {
+        std::unique_lock<std::mutex> lk(p.batch.m);
+        p.batch.cv.wait(lk, [&] { return p.batch.remaining.load() == 0; });
+        p.ok = !p.batch.failed.load();
+    }
+    return p.ok;
+}
+
+void pool_stop() {
+    if (g.workers.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        g.stopping = true;
+    }
+    g.cv_task.notify_all();
+    for (auto & w : g.workers) {
+        if (w.joinable()) {
+            w.join();
+        }
+    }
+    g.workers.clear();
+}
