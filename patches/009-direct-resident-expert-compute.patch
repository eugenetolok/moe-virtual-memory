@@ -0,0 +1,1561 @@
+#include "llama-moe-paging.h"
+
+#include "llama-impl.h"
+#include "llama-model.h"
+
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpu.h"
+#include "ggml-cpu-impl.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cmath>
+#include <condition_variable>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <fcntl.h>
+#include <mutex>
+#include <string>
+#include <sys/stat.h>
+#include <thread>
+#include <unistd.h>
+#include <vector>
+
+// True when the resident-slot tensors are the compute storage (direct_sparse or
+// direct_dense). Declared before the anonymous namespace: the early helpers use it.
+namespace { bool llama_moe_paging_direct_storage(); }
+
+namespace {
+
+
+constexpr int    HIST_BUCKETS = 32;
+constexpr double HIST_LO_MS   = 0.01;
+constexpr int    MAX_READ_COMPONENTS = 3;
+constexpr int    MAX_K        = 64;
+
+static double hist_percentile(const uint64_t * hist, double q) {
+    uint64_t total = 0;
+    for (int b = 0; b < HIST_BUCKETS; b++) {
+        total += hist[b];
+    }
+    if (total == 0) {
+        return 0.0;
+    }
+    const double target = q * (double) total;
+    uint64_t cum = 0;
+    for (int b = 0; b < HIST_BUCKETS; b++) {
+        cum += hist[b];
+        if ((double) cum >= target) {
+            return HIST_LO_MS * (double) (1ULL << (b + 1));
+        }
+    }
+    return HIST_LO_MS * (double) (1ULL << HIST_BUCKETS);
+}
+
+static void hist_add(uint64_t * hist, double dt) {
+    int b = dt > HIST_LO_MS ? (int) std::floor(std::log2(dt / HIST_LO_MS)) : 0;
+    if (b < 0) { b = 0; }
+    if (b >= HIST_BUCKETS) { b = HIST_BUCKETS - 1; }
+    hist[b]++;
+}
+
+enum read_kind {
+    READ_PACKED = 0,
+    READ_GATE,
+    READ_UP,
+    READ_DOWN,
+};
+
+struct read_batch {
+    std::atomic<int>  remaining {0};
+    std::atomic<bool> failed {false};
+    std::mutex m;
+    std::condition_variable cv;
+};
+
+struct io_task {
+    llama_moe_paging_layer * layer = nullptr;
+    read_batch * batch = nullptr;
+    int32_t gid  = -1;
+    int32_t slot = -1;
+    int     kind = READ_PACKED;
+    int64_t offset = 0;
+    size_t  size = 0;
+};
+
+struct paging_state {
+    bool enabled = false;
+    bool initialized = false;
+    int  n_layer = 0;
+    int  n_expert = 0;
+    int  m_slots = 0;
+    int  k_slots = 0;
+    int64_t record_stride = 0;
+    std::string policy;      // lru | event_decay90
+    std::string stage_mode;  // serial | overlap | persistent_overlap
+    std::string compute_mode; // staging | direct_sparse
+    std::string backend;     // packed | gguf3
+    std::string stats_path;
+    int  qd = 4;
+    bool hot = false;
+    bool nocache_requested = false;
+    bool nocache_applied = false;
+    bool assert_checks = false;
+    bool timing = true;
+
+    int store_fd = -1;
+    int gguf_fd  = -1;
+
+    ggml_backend_t cpu = nullptr;
+    std::vector<llama_moe_paging_layer> layers;
+    std::vector<uint8_t> hot_src;
+
+    // one global expert-sized scratch record for the persistent in-stage permutation
+    std::vector<uint8_t> stage_scratch;
+
+    uint64_t clock = 0;
+    uint64_t tokens = 0;
+    int      stats_interval = 128;
+    uint64_t last_flush_tokens = 0;
+    int      fault_after = 0;
+    std::atomic<int> reads_done {0};
+    uint64_t hot_fills = 0;
+
+    // global read latency and read-set histograms
+    std::mutex hist_m;
+    uint64_t hist[HIST_BUCKETS]        = {};
+    uint64_t readset_hist[HIST_BUCKETS] = {};
+
+    // worker pool
+    std::mutex mtx;
+    std::condition_variable cv_task;
+    std::deque<io_task> queue;
+    bool stopping = false;
+    std::vector<std::thread> workers;
+};
+
+paging_state g;
+
+bool llama_moe_paging_direct_storage() {
+    return g.compute_mode == "direct_sparse" || g.compute_mode == "direct_dense";
+}
+
+int getenv_int(const char * name, int fallback) {
+    const char * v = getenv(name);
+    if (v == nullptr || v[0] == '\0') {
+        return fallback;
+    }
+    return atoi(v);
+}
+
+bool getenv_bool(const char * name, bool fallback) {
+    const char * v = getenv(name);
+    if (v == nullptr || v[0] == '\0') {
+        return fallback;
+    }
+    return atoi(v) != 0;
+}
+
+std::string getenv_str(const char * name, const char * fallback) {
+    const char * v = getenv(name);
+    return (v != nullptr && v[0] != '\0') ? std::string(v) : std::string(fallback);
+}
+
+int64_t align_up(int64_t v, int64_t a) {
+    return (v + a - 1) & ~(a - 1);
+}
+
+double now_ms() {
+    using clk = std::chrono::steady_clock;
+    return std::chrono::duration<double, std::milli>(clk::now().time_since_epoch()).count();
+}
+
+// Exact read at off into dst. False on EOF, error, or injected fault.
+bool read_exact(int fd, void * buf, size_t n, off_t off) {
+    if (g.fault_after > 0 && g.reads_done.load() >= g.fault_after) {
+        return false;
+    }
+    size_t done = 0;
+    uint8_t * p = (uint8_t *) buf;
+    while (done < n) {
+        const ssize_t r = pread(fd, p + done, n - done, off + (off_t) done);
+        if (r < 0) {
+            if (errno == EINTR) {
+                continue;
+            }
+            return false;
+        }
+        if (r == 0) {
+            return false;
+        }
+        done += (size_t) r;
+    }
+    g.reads_done.fetch_add(1);
+    return true;
+}
+
+uint8_t * read_dst(llama_moe_paging_layer & l, int32_t slot, int kind);
+
+void run_one_task(const io_task & t) {
+    int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+    uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+    const double t0 = now_ms();
+    const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+    const double dt = now_ms() - t0;
+    {
+        std::lock_guard<std::mutex> lk(g.hist_m);
+        hist_add(g.hist, dt);
+    }
+    read_batch * b = t.batch;
+    if (b != nullptr) {
+        std::lock_guard<std::mutex> lk(b->m);
+        if (!ok) {
+            b->failed.store(true);
+        }
+        if (--b->remaining == 0) {
+            b->cv.notify_all();
+        }
+    }
+}
+
+void worker_main() {
+    for (;;) {
+        io_task t;
+        {
+            std::unique_lock<std::mutex> lk(g.mtx);
+            g.cv_task.wait(lk, [] { return g.stopping || !g.queue.empty(); });
+            if (g.queue.empty()) {
+                if (g.stopping) {
+                    return;
+                }
+                continue;
+            }
+            t = g.queue.front();
+            g.queue.pop_front();
+        }
+        run_one_task(t);
+    }
+}
+
+// Returns false if any read failed.
+bool run_read_tasks(const std::vector<io_task> & tasks) {
+    if (tasks.empty()) {
+        return true;
+    }
+    if (g.workers.empty()) {
+        for (const auto & t : tasks) {
+            int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+            uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+            const double t0 = now_ms();
+            const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+            hist_add(g.hist, now_ms() - t0);
+            if (!ok) {
+                return false;
+            }
+        }
+        return true;
+    }
+    read_batch batch;
+    batch.remaining.store((int) tasks.size());
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        for (const auto & t : tasks) {
+            io_task copy = t;
+            copy.batch = &batch;
+            g.queue.push_back(copy);
+        }
+    }
+    g.cv_task.notify_all();
+    {
+        std::unique_lock<std::mutex> lk(batch.m);
+        batch.cv.wait(lk, [&] { return batch.remaining.load() == 0; });
+    }
+    return !batch.failed.load();
+}
+
+// Async read submission for overlap/persistent modes. The caller must keep `p`
+// alive until wait_read_tasks returns. QD1 stays synchronous (nothing to overlap).
+struct read_pending {
+    read_batch batch;
+    bool   submitted = false;
+    bool   async     = false;
+    bool   ok        = true;
+};
+
+void submit_read_tasks(const std::vector<io_task> & tasks, read_pending & p) {
+    p.submitted = true;
+    p.ok = true;
+    if (tasks.empty()) {
+        return;
+    }
+    if (g.workers.empty()) {
+        for (const auto & t : tasks) {
+            int fd = g.backend == "gguf3" ? g.gguf_fd : g.store_fd;
+            uint8_t * buf = read_dst(*t.layer, t.slot, t.kind);
+            const double r0 = now_ms();
+            const bool ok = read_exact(fd, buf, t.size, (off_t) t.offset);
+            hist_add(g.hist, now_ms() - r0);
+            if (!ok) { p.ok = false; break; }
+        }
+        return;
+    }
+    p.batch.remaining.store((int) tasks.size());
+    p.batch.failed.store(false);
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        for (const auto & t : tasks) {
+            io_task copy = t;
+            copy.batch = &p.batch;
+            g.queue.push_back(copy);
+        }
+    }
+    g.cv_task.notify_all();
+    p.async = true;
+}
+
+bool wait_read_tasks(read_pending & p) {
+    if (!p.submitted) {
+        return true;
+    }
+    if (p.async) {
+        std::unique_lock<std::mutex> lk(p.batch.m);
+        p.batch.cv.wait(lk, [&] { return p.batch.remaining.load() == 0; });
+        p.ok = !p.batch.failed.load();
+    }
+    return p.ok;
+}
+
+void pool_stop() {
+    if (g.workers.empty()) {
+        return;
+    }
+    {
+        std::lock_guard<std::mutex> lk(g.mtx);
+        g.stopping = true;
+    }
+    g.cv_task.notify_all();
+    for (auto & w : g.workers) {
+        if (w.joinable()) {
+            w.join();
+        }
+    }
+    g.workers.clear();
+}
+
+void dump_stats() {
+    if (!g.enabled) {
+        return;
+    }
+    FILE * f = fopen(g.stats_path.c_str(), "w");
+    if (f == nullptr) {
+        return;
+    }
+    uint64_t hits = 0, misses = 0, evict = 0, bytes = 0, stage_bytes = 0, events = 0;
