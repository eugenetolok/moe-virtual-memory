+
+// Destination pointer of one read. In staging mode the record is assembled in
+// the M-slot cache; in direct_sparse a component lands in its resident-slot
+// tensor and never touches the byte cache.
+uint8_t * read_dst(llama_moe_paging_layer & l, int32_t slot, int kind) {
+    if (llama_moe_paging_direct_storage()) {
+        switch (kind) {
+            case READ_GATE: return (uint8_t *) l.slot_gate->data + (size_t) slot * (size_t) l.gate_bytes;
+            case READ_UP:   return (uint8_t *) l.slot_up->data   + (size_t) slot * (size_t) l.up_bytes;
+            default:        return (uint8_t *) l.slot_down->data + (size_t) slot * (size_t) l.down_bytes;
+        }
+    }
+    uint8_t * rec = l.cache.data() + (size_t) slot * (size_t) g.record_stride;
+    switch (kind) {
+        case READ_GATE: return rec + l.gate_off;
+        case READ_UP:   return rec + l.up_off;
+        default:        return rec + l.down_off;
+    }
+}
+
+void build_read_tasks(llama_moe_paging_layer & l, int32_t gid, int32_t slot, std::vector<io_task> & tasks) {
+    if (g.backend == "gguf3") {
+        io_task a; a.layer = &l; a.gid = gid; a.slot = slot; a.kind = READ_GATE;
+        a.offset = l.gguf_gate_off + (int64_t) gid * l.gate_bytes;
+        a.size = (size_t) l.gate_bytes;
+        tasks.push_back(a);
+        io_task b = a; b.kind = READ_UP;
+        b.offset = l.gguf_up_off + (int64_t) gid * l.up_bytes;
+        b.size = (size_t) l.up_bytes;
+        tasks.push_back(b);
+        io_task c = a; c.kind = READ_DOWN;
+        c.offset = l.gguf_down_off + (int64_t) gid * l.down_bytes;
+        c.size = (size_t) l.down_bytes;
+        tasks.push_back(c);
+    } else {
+        io_task a;
+        a.layer = &l; a.gid = gid; a.slot = slot; a.kind = READ_PACKED;
+        a.offset = ((int64_t) l.il * g.n_expert + gid) * g.record_stride;
+        a.size = (size_t) g.record_stride;
+        tasks.push_back(a);
+    }
+}
+
+int find_slot(const llama_moe_paging_layer & l, int32_t gid) {
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.slot_expert[s] == gid) {
+            return s;
+        }
+    }
+    return -1;
+}
+
+int pick_victim(const llama_moe_paging_layer & l) {
+    int slot = -1;
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.reserved[s]) {
+            continue;
+        }
+        if (l.slot_expert[s] < 0) {
+            slot = s;
+            break;
+        }
+    }
+    if (slot >= 0) {
+        return slot;
+    }
+    const bool decay = g.policy == "event_decay90";
+    for (int s = 0; s < l.n_slots; s++) {
+        if (l.reserved[s]) {
+            continue;
+        }
+        if (slot < 0) {
+            slot = s;
+            continue;
+        }
+        const bool better = decay ? (l.score[s] < l.score[slot]) : (l.last_use[s] < l.last_use[slot]);
+        if (better) {
+            slot = s;
+        }
+    }
+    return slot;
+}
+
+// --- Execution 008 staging copy helpers -------------------------------------
+
+// copy a record (gate/up/down at the component offsets) into stage position j
+void stage_write_record(llama_moe_paging_layer & l, int j, const uint8_t * rec) {
+    memcpy((uint8_t *) l.stage_gate->data + (size_t) j * (size_t) l.gate_bytes, rec + l.gate_off, (size_t) l.gate_bytes);
+    memcpy((uint8_t *) l.stage_up->data   + (size_t) j * (size_t) l.up_bytes,   rec + l.up_off,   (size_t) l.up_bytes);
+    memcpy((uint8_t *) l.stage_down->data + (size_t) j * (size_t) l.down_bytes, rec + l.down_off, (size_t) l.down_bytes);
+}
+
+// permute a record within the K8 stage; src_j and dst_j are distinct positions
+void stage_move(llama_moe_paging_layer & l, int dst_j, int src_j) {
+    memmove((uint8_t *) l.stage_gate->data + (size_t) dst_j * (size_t) l.gate_bytes,
+            (const uint8_t *) l.stage_gate->data + (size_t) src_j * (size_t) l.gate_bytes, (size_t) l.gate_bytes);
+    memmove((uint8_t *) l.stage_up->data   + (size_t) dst_j * (size_t) l.up_bytes,
+            (const uint8_t *) l.stage_up->data   + (size_t) src_j * (size_t) l.up_bytes,   (size_t) l.up_bytes);
+    memmove((uint8_t *) l.stage_down->data + (size_t) dst_j * (size_t) l.down_bytes,
+            (const uint8_t *) l.stage_down->data + (size_t) src_j * (size_t) l.down_bytes, (size_t) l.down_bytes);
+}
+
+void stage_read_to_scratch(llama_moe_paging_layer & l, int src_j) {
+    memcpy(g.stage_scratch.data() + l.gate_off, (const uint8_t *) l.stage_gate->data + (size_t) src_j * (size_t) l.gate_bytes, (size_t) l.gate_bytes);
+    memcpy(g.stage_scratch.data() + l.up_off,   (const uint8_t *) l.stage_up->data   + (size_t) src_j * (size_t) l.up_bytes,   (size_t) l.up_bytes);
+    memcpy(g.stage_scratch.data() + l.down_off, (const uint8_t *) l.stage_down->data + (size_t) src_j * (size_t) l.down_bytes, (size_t) l.down_bytes);
+}
+
+void stage_event(llama_moe_paging_layer & l, const int32_t * req, int k, int32_t * out_slot) {
+    const bool decay = g.policy == "event_decay90";
+
+    // event-decay90: one decay of every resident score per layer event
+    if (decay) {
+        for (int s = 0; s < l.n_slots; s++) {
+            l.score[s] *= 0.90;
+        }
+    }
+
+    std::fill(l.reserved.begin(), l.reserved.end(), (uint8_t) 0);
+
+    int32_t cache_slot[MAX_K];
+    int     miss_i[MAX_K];
+    bool    is_miss[MAX_K] = {};
+    int     n_miss = 0;
+
+    for (int i = 0; i < k; i++) {
+        cache_slot[i] = find_slot(l, req[i]);
+        if (cache_slot[i] >= 0) {
+            l.hits++;
+            l.last_use[cache_slot[i]] = ++g.clock;
+            l.reserved[cache_slot[i]] = 1; // never evict an expert required by this event
+            if (decay) {
+                l.score[cache_slot[i]] += 1.0;
+            }
+        } else {
+            miss_i[n_miss++] = i;
+            is_miss[i] = true;
+        }
+    }
+
+    // reserve one distinct cache slot per miss before any read starts
+    for (int m = 0; m < n_miss; m++) {
+        const int s = pick_victim(l);
+        if (s < 0) {
+            GGML_ABORT("moe paging: no victim slot available (M=%d, misses=%d)", l.n_slots, n_miss);
+        }
+        if (l.slot_expert[s] >= 0) {
+            l.evictions++;
+        }
+        l.reserved[s] = 1;
+        cache_slot[miss_i[m]] = s;
+    }
+
+    // gather the read set for all misses
+    std::vector<io_task> tasks;
+    tasks.reserve((size_t) n_miss * (g.backend == "gguf3" ? MAX_READ_COMPONENTS : 1));
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = cache_slot[i];
+        if (g.hot) {
+            // compute-only control: no file I/O, fill the destination directly
+            uint8_t * rec = llama_moe_paging_direct_storage()
+                ? nullptr : l.cache.data() + (size_t) s * (size_t) g.record_stride;
+            if (llama_moe_paging_direct_storage()) {
+                memcpy((uint8_t *) l.slot_gate->data + (size_t) s * (size_t) l.gate_bytes,
+                       g.hot_src.data() + l.gate_off, (size_t) l.gate_bytes);
+                memcpy((uint8_t *) l.slot_up->data   + (size_t) s * (size_t) l.up_bytes,
+                       g.hot_src.data() + l.up_off,   (size_t) l.up_bytes);
+                memcpy((uint8_t *) l.slot_down->data + (size_t) s * (size_t) l.down_bytes,
+                       g.hot_src.data() + l.down_off, (size_t) l.down_bytes);
+            } else {
+                memcpy(rec, g.hot_src.data(), (size_t) g.record_stride);
+            }
+            g.hot_fills++;
+        } else {
+            build_read_tasks(l, req[i], s, tasks);
+        }
+    }
+
+    const int ntasks = (int) tasks.size();
+    const uint64_t eff_qd = ntasks > 0
+        ? (uint64_t) std::min<int>((int) std::max<size_t>(g.workers.size(), 1), ntasks)
+        : 0;
+    l.qd_sum += eff_qd;
+    l.qd_max = std::max(l.qd_max, eff_qd);
+
+    const bool persistent = (g.stage_mode == "persistent_overlap");
+
+    // Final stage order: ascending resident-cache slot. mul_mat_id accumulates
+    // expert contributions in that order, reproducing the Execution-004 CPU
+    // accumulation order. Every mode keeps this order.
+    int order[MAX_K];
+    for (int i = 0; i < k; i++) {
+        order[i] = i;
+    }
+    std::sort(order, order + k, [&](int a, int b) { return cache_slot[a] < cache_slot[b]; });
+    for (int j = 0; j < k; j++) {
+        out_slot[order[j]] = j;
+    }
+
+    if (getenv("LLAMA_MOE_PAGING_SLOTLOG") != nullptr) {
+        fprintf(stderr, "SLOTLOG stage  il=%d req=", l.il);
+        for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", req[i]); }
+        fprintf(stderr, " slot=");
+        for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", cache_slot[i]); }
+        fprintf(stderr, "\n");
+    }
+
+    // staged-byte hit/miss split is independent of the copy source
+    for (int j = 0; j < k; j++) {
+        if (is_miss[order[j]]) {
+            l.stage_miss_bytes += (uint64_t) g.record_stride;
+        } else {
+            l.stage_hit_bytes += (uint64_t) g.record_stride;
+        }
+    }
+
+    int32_t desired[MAX_K];
+    int     desired_cache[MAX_K];
+    bool    desired_miss[MAX_K];
+    bool    p_done[MAX_K] = {};
+    bool    p_defer[MAX_K] = {};
+    int     scratch_expert = -1;
+    for (int j = 0; j < k; j++) {
+        const int i = order[j];
+        desired[j] = req[i];
+        desired_cache[j] = cache_slot[i];
+        desired_miss[j] = is_miss[i];
+    }
+
+    const double wall0 = now_ms();
+    double pre_wait_dt = 0.0;
+    read_pending rp;
+
+    if (llama_moe_paging_direct_storage()) {
+        // Execution 009: no K8 materialization. The selected experts stay in
+        // their resident slots. Reads (already submitted into those slots, or
+        // waiting below in serial QD) are the only data movement. Output order is
+        // ascending resident-slot id, matching the accepted Execution-003/004
+        // accumulation order.
+        int order_d[MAX_K];
+        for (int i = 0; i < k; i++) {
+            order_d[i] = i;
+        }
+        std::sort(order_d, order_d + k, [&](int a, int b) { return cache_slot[a] < cache_slot[b]; });
+
+        // The read set is the same gather that the staging path uses; in direct
+        // mode read_dst() already points each component at its resident slot, so
+        // no extra copy into a K8 tensor is needed.
+        const double pre_wait_t0_d = now_ms();
+        double dw_pre = 0.0;
+        if (!g.hot && g.stage_mode != "serial") {
+            submit_read_tasks(tasks, rp);
+            dw_pre = now_ms() - pre_wait_t0_d;
+        }
+
+        const double dw0 = now_ms();
+        bool dok = true;
+        if (!g.hot) {
+            if (g.stage_mode == "serial") {
+                if (!tasks.empty()) {
+                    dok = run_read_tasks(tasks);
+                }
+            } else {
+                dok = wait_read_tasks(rp);
+            }
+        }
+        const double dw_wait = now_ms() - dw0;
+        if (!tasks.empty()) {
+            l.fault_ms += dw_wait;
+            l.read_wait_ms += dw_wait;
+            l.readset_wall_ms += dw_pre + dw_wait;
+            {
+                std::lock_guard<std::mutex> lk(g.hist_m);
+                hist_add(g.readset_hist, dw_pre + dw_wait);
+            }
+            hist_add(l.readset_hist, dw_pre + dw_wait);
+            if (!dok) {
+                LLAMA_LOG_ERROR("%s: cannot read the full expert read set (layer %d, %d reads)\n",
+                                __func__, l.il, (int) tasks.size());
+                GGML_ABORT("moe paging: incomplete expert read set; refusing to run with partial weights");
+            }
+        }
+
+        // publish cache metadata only after every exact read succeeded
+        for (int m = 0; m < n_miss; m++) {
+            const int i = miss_i[m];
+            const int s = cache_slot[i];
+            l.slot_expert[s] = req[i];
+            l.last_use[s] = ++g.clock;
+            l.score[s] = decay ? 1.0 : 0.0;
+            l.misses++;
+            if (!g.hot) {
+                l.bytes_read += (uint64_t) g.record_stride;
+            }
+        }
+        l.miss_hist[std::min(n_miss, 8)]++;
+        l.events++;
+
+        // the graph must receive the resident slot id chosen for each requested
+        // expert position; the mul_mat_id below reads expert matrices by slot id
+        for (int j = 0; j < k; j++) {
+            out_slot[j] = cache_slot[j];
+        }
+        l.direct_calls++;
+        l.stage_wall_ms += now_ms() - wall0;
+        // inference compute happens after this op returns; the end marker uses this
+        l.compute_start_ms = now_ms();
+
+        if (getenv("LLAMA_MOE_PAGING_SLOTLOG") != nullptr) {
+            fprintf(stderr, "SLOTLOG direct il=%d req=", l.il);
+            for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", req[i]); }
+            fprintf(stderr, " slot=");
+            for (int i = 0; i < k; i++) { fprintf(stderr, "%d,", cache_slot[i]); }
+            fprintf(stderr, "\n");
+        }
+        if (g.assert_checks) {
+            for (int j = 0; j < k; j++) {
+                const int s = cache_slot[j];
+                if (!(s >= 0 && s < l.n_slots)) {
+                    GGML_ABORT("moe paging assert: cache slot %d out of range", s);
+                }
+                if (l.slot_expert[s] != req[j]) {
+                    GGML_ABORT("moe paging assert: slot %d holds expert %d, expected %d",
+                               s, l.slot_expert[s], req[j]);
+                }
+                for (int q = 0; q < j; q++) {
+                    if (cache_slot[q] == s) {
+                        GGML_ABORT("moe paging assert: cache slot %d assigned twice", s);
+                    }
+                }
+            }
+        }
+        return;
+    }
+
+
+
+    if (g.stage_mode == "serial") {
+        // serial: no copy work overlaps the read set
+    } else {
+        const double pre_wait_t0 = now_ms();
+        submit_read_tasks(tasks, rp);
+        if (persistent) {
+            // persistent strict K8 stage: retain exact positions, permute experts
+            // already in stage, copy the rest from the resident cache. Only miss
+            // experts absent from stage are deferred until their reads complete.
+            for (int j = 0; j < k; j++) {
+                int p = -1;
+                for (int q = 0; q < k; q++) {
+                    if (l.stage_expert[q] == desired[j]) { p = q; break; }
+                }
+                p_done[j] = (p == j);
+                p_defer[j] = (p < 0 && desired_miss[j]);
+                if (p_done[j]) {
+                    l.stage_retain_bytes += (uint64_t) g.record_stride;
+                    l.retain_exact++;
+                }
+            }
+            for (;;) {
+                bool progress = false;
+                for (int j = 0; j < k; j++) {
+                    if (p_done[j] || p_defer[j]) {
+                        continue;
+                    }
+                    const int32_t cur = l.stage_expert[j];
+                    bool needed = false;
+                    if (cur >= 0) {
+                        for (int e = 0; e < k; e++) {
+                            if (!p_done[e] && e != j && desired[e] == cur) { needed = true; break; }
+                        }
+                    }
+                    if (needed) {
+                        continue;
+                    }
+                    int p = -1;
+                    for (int q = 0; q < k; q++) {
+                        if (l.stage_expert[q] == desired[j]) { p = q; break; }
+                    }
+                    if (p >= 0) {
+                        stage_move(l, j, p);
+                        l.stage_expert[p] = -1;
+                        l.stage_move_bytes += (uint64_t) g.record_stride;
+                        l.moved_in_stage++;
+                    } else if (scratch_expert == desired[j]) {
+                        stage_write_record(l, j, g.stage_scratch.data());
+                        scratch_expert = -1;
+                        l.stage_move_bytes += (uint64_t) g.record_stride;
+                        l.moved_in_stage++;
+                    } else {
+                        stage_write_record(l, j, l.cache.data() + (size_t) desired_cache[j] * (size_t) g.record_stride);
+                        l.stage_cache_bytes += (uint64_t) g.record_stride;
+                        l.newly_staged++;
+                    }
+                    l.stage_expert[j] = desired[j];
+                    p_done[j] = true;
+                    progress = true;
+                }
+                bool remaining = false;
+                for (int j = 0; j < k; j++) {
+                    if (!p_done[j] && !p_defer[j]) { remaining = true; break; }
+                }
+                if (!remaining) {
+                    break;
+                }
+                if (!progress) {
+                    // a cycle of stage-internal moves; break it with the one scratch record
+                    int j0 = -1;
+                    for (int j = 0; j < k; j++) {
+                        if (!p_done[j] && !p_defer[j]) { j0 = j; break; }
+                    }
+                    if (j0 < 0 || scratch_expert >= 0) {
+                        GGML_ABORT("moe paging: persistent staging permutation stalled");
+                    }
+                    stage_read_to_scratch(l, j0);
+                    scratch_expert = l.stage_expert[j0];
+                    l.stage_expert[j0] = -1;
+                }
+            }
+        } else {
+            // overlap: copy resident hits while the miss reads are outstanding
+            for (int j = 0; j < k; j++) {
+                const int i = order[j];
+                if (!is_miss[i]) {
+                    stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+                    l.stage_cache_bytes += (uint64_t) g.record_stride;
+                    l.newly_staged++;
+                }
+            }
+        }
+        pre_wait_dt = now_ms() - pre_wait_t0;
+        l.stage_pre_wait_ms += pre_wait_dt;
+    }
+
+    const double wait_t0 = now_ms();
+    bool read_ok = true;
+    if (g.stage_mode == "serial") {
+        if (!tasks.empty()) {
+            read_ok = run_read_tasks(tasks);
+        }
+    } else {
+        read_ok = wait_read_tasks(rp);
+    }
+    const double wait_dt = now_ms() - wait_t0;
+    // readset_dt is the full miss read-set wall: submit/start -> completion. In
+    // overlap/persistent it includes pre_wait_dt, the pre-wait staging overlapped with
+    // the in-flight reads. read_wait_ms (and the historical fault_ms) is only the
+    // residual caller-blocking wait after that pre-wait staging.
+    const double readset_dt = pre_wait_dt + wait_dt;
+    if (!tasks.empty()) {
+        l.fault_ms += wait_dt;
+        l.read_wait_ms += wait_dt;
+        l.readset_wall_ms += readset_dt;
+        {
+            std::lock_guard<std::mutex> lk(g.hist_m);
+            hist_add(g.readset_hist, readset_dt);
+        }
+        hist_add(l.readset_hist, readset_dt);
+        if (!read_ok) {
+            LLAMA_LOG_ERROR("%s: cannot read the full expert read set (layer %d, %d reads)\n",
+                            __func__, l.il, ntasks);
+            GGML_ABORT("moe paging: incomplete expert read set; refusing to run with partial weights");
+        }
+    }
+
+    // publish cache metadata only after every exact read succeeded
+    for (int m = 0; m < n_miss; m++) {
+        const int i = miss_i[m];
+        const int s = cache_slot[i];
+        l.slot_expert[s] = req[i];
+        l.last_use[s] = ++g.clock;
+        l.score[s] = decay ? 1.0 : 0.0;
+        l.misses++;
+        if (!g.hot) {
+            l.bytes_read += (uint64_t) g.record_stride;
+        }
+    }
+    l.miss_hist[std::min(n_miss, 8)]++;
+    l.events++;
+
+    const double post_wait_t0 = now_ms();
+    if (g.stage_mode == "serial") {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+            l.stage_cache_bytes += (uint64_t) g.record_stride;
+            l.newly_staged++;
+        }
+        std::fill(l.stage_expert.begin(), l.stage_expert.end(), -1);
+    } else if (persistent) {
+        for (int j = 0; j < k; j++) {
+            if (p_done[j]) {
+                continue;
+            }
+            stage_write_record(l, j, l.cache.data() + (size_t) desired_cache[j] * (size_t) g.record_stride);
+            l.stage_cache_bytes += (uint64_t) g.record_stride;
+            l.newly_staged++;
+            l.stage_expert[j] = desired[j];
+            p_done[j] = true;
+        }
+    } else {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            if (is_miss[i]) {
+                stage_write_record(l, j, l.cache.data() + (size_t) cache_slot[i] * (size_t) g.record_stride);
+                l.stage_cache_bytes += (uint64_t) g.record_stride;
+                l.newly_staged++;
+            }
+        }
+    }
+    const double post_wait_dt = now_ms() - post_wait_t0;
+
+    const double copy_dt = pre_wait_dt + post_wait_dt;
+    l.stage_post_wait_ms += post_wait_dt;
+    l.stage_ms += copy_dt;
+    l.stage_copy_ms = l.stage_ms;
+    l.stage_wall_ms += now_ms() - wall0;
+    l.stage_bytes += (uint64_t) k * (uint64_t) g.record_stride;
+    l.compute_start_ms = now_ms();
+
+    if (g.assert_checks) {
+        for (int j = 0; j < k; j++) {
+            const int i = order[j];
+            const int s = cache_slot[i];
+            if (!(s >= 0 && s < l.n_slots)) {
+                GGML_ABORT("moe paging assert: cache slot %d out of range", s);
+            }
+            if (l.slot_expert[s] != req[i]) {
+                GGML_ABORT("moe paging assert: slot %d holds expert %d, expected %d",
+                           s, l.slot_expert[s], req[i]);
+            }
+            for (int q = 0; q < j; q++) {
+                if (cache_slot[order[q]] == s) {
+                    GGML_ABORT("moe paging assert: cache slot %d assigned twice", s);
+                }
+            }
+            const uint8_t * rec = l.cache.data() + (size_t) s * (size_t) g.record_stride;
+            if (memcmp((const uint8_t *) l.stage_gate->data + (size_t) j * (size_t) l.gate_bytes, rec + l.gate_off, (size_t) l.gate_bytes) != 0 ||
+                memcmp((const uint8_t *) l.stage_up->data   + (size_t) j * (size_t) l.up_bytes,   rec + l.up_off,   (size_t) l.up_bytes)   != 0 ||
+                memcmp((const uint8_t *) l.stage_down->data + (size_t) j * (size_t) l.down_bytes, rec + l.down_off, (size_t) l.down_bytes) != 0) {
+                GGML_ABORT("moe paging assert: stage position %d does not match expert %d bytes", j, req[i]);
+            }
+            if (persistent && l.stage_expert[j] != req[i]) {
+                GGML_ABORT("moe paging assert: persistent stage position %d holds expert %d, expected %d",
+                           j, l.stage_expert[j], req[i]);
+            }
+        }
+        for (int a = 0; a < k; a++) {
+            for (int b = a + 1; b < k; b++) {
+                if (req[order[a]] == req[order[b]]) {
+                    GGML_ABORT("moe paging assert: duplicate expert %d in stage order", req[order[a]]);
+                }
+            }
+        }
+    }
+}
+
+} // namespace
+
+void llama_moe_paging_init(const llama_model & model) {
+    if (g.initialized) {
+        return;
+    }
+    g.initialized = true;
+
+    const int m = getenv_int("LLAMA_MOE_PAGING_M", 0);
+    if (m <= 0) {
+        return;
+    }
+    if (model.hparams.n_layer() <= 0 || model.hparams.n_expert <= 0) {
+        return;
+    }
+
+    g.n_layer  = (int) model.hparams.n_layer();
+    g.n_expert = (int) model.hparams.n_expert;
+    g.m_slots  = m;
+    const uint32_t k = model.hparams.n_expert_used_max();
+    if (k == 0 || (int) k > MAX_K) {
+        LLAMA_LOG_WARN("%s: unsupported n_expert_used=%u, paging disabled\n", __func__, k);
+        return;
+    }
+    g.k_slots = (int) k;
+    g.policy  = getenv_str("LLAMA_MOE_PAGING_POLICY", "lru");
+    if (g.policy == "decay90") {
+        g.policy = "event_decay90";
+    }
+    g.stage_mode = getenv_str("LLAMA_MOE_PAGING_STAGE_MODE", "serial");
+    if (g.stage_mode != "serial" && g.stage_mode != "overlap" && g.stage_mode != "persistent_overlap") {
+        LLAMA_LOG_WARN("%s: unknown stage mode '%s', using serial\n", __func__, g.stage_mode.c_str());
+        g.stage_mode = "serial";
+    }
+    g.compute_mode = getenv_str("LLAMA_MOE_PAGING_COMPUTE_MODE", "staging");
+    // direct_dense: resident-slot tensors consumed by the normal (unmodified)
+    // CPU mul_mat_id. It exists only to falsify the M-shaped-cost hypothesis:
+    // it does the same K work but keeps the M-wide dispatch scan.
+    if (g.compute_mode != "staging" && g.compute_mode != "direct_sparse" && g.compute_mode != "direct_dense") {
+        LLAMA_LOG_WARN("%s: unknown compute mode '%s', using staging\n", __func__, g.compute_mode.c_str());
+        g.compute_mode = "staging";
+    }
+    g.backend = getenv_str("LLAMA_MOE_PAGING_BACKEND", "packed");
+    g.qd      = std::max(1, std::min(16, getenv_int("LLAMA_MOE_PAGING_QD", 4)));
+    g.hot     = getenv_bool("LLAMA_MOE_PAGING_HOT", false);
+    g.nocache_requested = getenv_bool("LLAMA_MOE_PAGING_NOCACHE", false);
+    g.assert_checks = getenv_bool("LLAMA_MOE_PAGING_ASSERT", false);
+    g.timing = getenv_bool("LLAMA_MOE_PAGING_TIMING", true);
+    g.stats_path = getenv_str("LLAMA_MOE_PAGING_STATS", "results/moe_paging_stats.json");
+    g.stats_interval = getenv_int("LLAMA_MOE_PAGING_STATS_INTERVAL", 128);
+    g.fault_after = getenv_int("LLAMA_MOE_PAGING_FAULT_AFTER", 0);
+
+    const std::string store = getenv_str("LLAMA_MOE_PAGING_STORE", "cold-experts.bin");
+    if (g.backend != "gguf3") {
+        g.store_fd = open(store.c_str(), O_RDONLY);
+        if (g.store_fd < 0) {
+            LLAMA_LOG_WARN("%s: cannot open packed store '%s', paging disabled\n", __func__, store.c_str());
+            return;
+        }
+    }
+
+    if (g.backend == "gguf3") {
+        const std::string gguf = getenv_str("LLAMA_MOE_PAGING_GGUF", "");
+        if (gguf.empty()) {
+            GGML_ABORT("moe paging: backend=gguf3 requires LLAMA_MOE_PAGING_GGUF");
+        }
+        g.gguf_fd = open(gguf.c_str(), O_RDONLY);
+        if (g.gguf_fd < 0) {
+            GGML_ABORT("moe paging: cannot open source GGUF '%s'", gguf.c_str());
+        }
+    }
+
+    if (g.nocache_requested) {
+        bool any = false;
+#ifdef F_NOCACHE
+        if (g.store_fd >= 0 && fcntl(g.store_fd, F_NOCACHE, 1) == 0) { any = true; }
+        if (g.gguf_fd  >= 0 && fcntl(g.gguf_fd,  F_NOCACHE, 1) == 0) { any = true; }
+#endif
+        g.nocache_applied = any;
+    }
+
+    g.cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    if (g.cpu == nullptr) {
+        LLAMA_LOG_WARN("%s: no CPU backend, paging disabled\n", __func__);
+        return;
+    }
+
+    g.layers.assign(g.n_layer, llama_moe_paging_layer());
+
+    const auto * gate0 = model.layers[0].ffn_gate_exps;
+    const auto * up0   = model.layers[0].ffn_up_exps;
+    const auto * down0 = model.layers[0].ffn_down_exps;
+    if (gate0 == nullptr || up0 == nullptr || down0 == nullptr) {
+        LLAMA_LOG_WARN("%s: routed expert tensors not found, paging disabled\n", __func__);
+        return;
+    }
+
+    const int64_t gate_bytes = ggml_nbytes(gate0) / g.n_expert;
+    const int64_t up_bytes   = ggml_nbytes(up0)   / g.n_expert;
+    const int64_t down_bytes = ggml_nbytes(down0) / g.n_expert;
+    const int64_t gate_off = 0;
+    const int64_t up_off   = align_up(gate_bytes, 16);
+    const int64_t down_off = up_off + align_up(up_bytes, 16);
+    g.record_stride = align_up(down_off + align_up(down_bytes, 16), 4096);
+    g.stage_scratch.assign((size_t) g.record_stride, 0);
+
+    // per-layer GGUF offsets for backend=gguf3
+    std::vector<int64_t> gguf_gate(g.n_layer, 0), gguf_up(g.n_layer, 0), gguf_down(g.n_layer, 0);
+    if (g.backend == "gguf3") {
+        const std::string csv = getenv_str("LLAMA_MOE_PAGING_OFFSETS", "results/gguf_expert_offsets.csv");
+        FILE * cf = fopen(csv.c_str(), "r");
+        if (cf == nullptr) {
+            GGML_ABORT("moe paging: cannot open gguf offset table '%s'", csv.c_str());
+        }
+        char line[512];
+        int matched = 0;
+        while (fgets(line, sizeof(line), cf) != nullptr) {
+            int il = -1;
+            long long ga = 0, gb = 0, ua = 0, ub = 0, da = 0, dbb = 0;
+            if (sscanf(line, "%d,%lld,%lld,%lld,%lld,%lld,%lld", &il, &ga, &gb, &ua, &ub, &da, &dbb) == 7) {
+                if (il >= 0 && il < g.n_layer) {
+                    gguf_gate[il] = ga;
+                    gguf_up[il]   = ua;
+                    gguf_down[il] = da;
+                    matched++;
+                }
+            }
+        }
+        fclose(cf);
+        if (matched < g.n_layer) {
+            GGML_ABORT("moe paging: offset table has %d/%d rows", matched, g.n_layer);
+        }
+    }
+
+    if (g.backend != "gguf3") {
+        struct stat st;
+        if (fstat(g.store_fd, &st) != 0) {
+            GGML_ABORT("moe paging: cannot stat packed expert store");
+        }
+        const int64_t store_need = (int64_t) g.n_layer * g.n_expert * g.record_stride;
+        if ((int64_t) st.st_size < store_need) {
+            GGML_ABORT("moe paging: packed expert store is smaller than the required expert pool");
+        }
+    }
+
+    g.hot_src.assign((size_t) g.record_stride, (uint8_t) 0x11);
+
+    const int64_t stage_bytes_per_layer = (int64_t) g.k_slots * g.record_stride;
+    for (int il = 0; il < g.n_layer; il++) {
+        auto & l = g.layers[il];
+        auto * gt = model.layers[il].ffn_gate_exps;
+        auto * ut = model.layers[il].ffn_up_exps;
+        auto * dt = model.layers[il].ffn_down_exps;
+        if (gt == nullptr || ut == nullptr || dt == nullptr) {
+            continue;
+        }
+
+        // direct storage never materializes a K8 tensor, so it allocates no staging
+        if (!llama_moe_paging_direct_storage()) {
+            const size_t mem = 4096 + 8 * ggml_tensor_overhead();
+            ggml_init_params ip = { mem, nullptr, true };
+            l.stage_ctx = ggml_init(ip);
+            l.stage_gate = ggml_new_tensor_3d(l.stage_ctx, gt->type, gt->ne[0], gt->ne[1], g.k_slots);
+            l.stage_up   = ggml_new_tensor_3d(l.stage_ctx, ut->type, ut->ne[0], ut->ne[1], g.k_slots);
+            l.stage_down = ggml_new_tensor_3d(l.stage_ctx, dt->type, dt->ne[0], dt->ne[1], g.k_slots);
+            l.stage_buf = ggml_backend_alloc_ctx_tensors(l.stage_ctx, g.cpu);
+            if (l.stage_buf == nullptr) {
+                LLAMA_LOG_WARN("%s: failed to allocate staging buffer layer %d\n", __func__, il);
+                return;
+            }
+        }
+
+        if (llama_moe_paging_direct_storage()) {
+            // plain CPU resident-slot tensors: directly writable exact quant data,
+            // no CPU_REPACK shadow and no second K8 copy.
+            const size_t mem_d = 4096 + 8 * ggml_tensor_overhead();
+            ggml_init_params ip_d = { mem_d, nullptr, true };
+            l.slot_ctx = ggml_init(ip_d);
+            l.slot_gate = ggml_new_tensor_3d(l.slot_ctx, gt->type, gt->ne[0], gt->ne[1], g.m_slots);
+            l.slot_up   = ggml_new_tensor_3d(l.slot_ctx, ut->type, ut->ne[0], ut->ne[1], g.m_slots);
+            l.slot_down = ggml_new_tensor_3d(l.slot_ctx, dt->type, dt->ne[0], dt->ne[1], g.m_slots);
+            l.slot_buf = ggml_backend_alloc_ctx_tensors(l.slot_ctx, g.cpu);
+            if (l.slot_buf == nullptr) {
+                LLAMA_LOG_WARN("%s: failed to allocate resident-slot buffer layer %d\n", __func__, il);
+                return;
+            }
+            GGML_ASSERT(ggml_nbytes(l.slot_gate) == (size_t) g.m_slots * (size_t) (ggml_nbytes(gt) / g.n_expert));
+        }
+
+        l.il = il;
+        l.gate_bytes = gate_bytes;
+        l.up_bytes   = up_bytes;
+        l.down_bytes = down_bytes;
+        l.gate_off = gate_off;
+        l.up_off   = up_off;
+        l.down_off = down_off;
+        l.gguf_gate_off = gguf_gate[il];
+        l.gguf_up_off   = gguf_up[il];
+        l.gguf_down_off = gguf_down[il];
+        l.n_slots = g.m_slots;
+        l.slot_expert.assign(g.m_slots, -1);
+        l.last_use.assign(g.m_slots, 0);
+        l.score.assign(g.m_slots, 0.0);
+        l.reserved.assign(g.m_slots, 0);
+        l.stage_expert.assign(g.k_slots, -1);
+        // the byte cache is the staging storage; direct compute reads the slot tensors
+        if (!llama_moe_paging_direct_storage()) {
+            l.cache.assign((size_t) g.m_slots * (size_t) g.record_stride, 0);
+        }
+        std::fill(l.miss_hist, l.miss_hist + 9, 0);
+        std::fill(l.readset_hist, l.readset_hist + HIST_BUCKETS, 0);
+
+        if (stage_bytes_per_layer <= 0) {
+            GGML_ABORT("moe paging: invalid staging size");
+        }
+    }
+
+    // bounded reusable worker pool; qd == 1 stays on the calling thread
+    if (g.qd > 1) {
+        for (int i = 0; i < g.qd; i++) {
+            g.workers.emplace_back(worker_main);
+        }
+    }
+
+    g.enabled = true;
+    if (g.compute_mode == "direct_sparse") {
+        // register the selected-only CPU mul_mat_id with the ggml-cpu backend
+        ggml_cpu_set_moe_mul_mat_id_hook(llama_moe_paging_direct_mul_mat_id);
+        LLAMA_LOG_INFO("%s: direct_sparse hook registered\n", __func__);
+    }
+    std::atexit(atexit_handler);
+    dump_stats();
+    LLAMA_LOG_INFO("%s: CPU staging paging enabled: M=%d K=%d backend=%s qd=%d stage_mode=%s hot=%d nocache=%d store=%s\n",
+                   __func__, g.m_slots, g.k_slots, g.backend.c_str(), g.qd, g.stage_mode.c_str(),
+                   g.hot ? 1 : 0, g.nocache_applied ? 1 : 0, store.c_str());
+}
+
+bool llama_moe_paging_enabled() {
+    return g.enabled;
+}
+
+// --- Execution 009: direct_sparse -------------------------------------------------
+
+bool llama_moe_paging_direct_mode() {
+    return g.enabled && llama_moe_paging_direct_storage();
+}
+
+void llama_moe_paging_slots(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    const int64_t k = a->ne[0];
+    const int64_t n_tok = a->ne[1];
+    if (k <= 0 || k > MAX_K) {
+        GGML_ABORT("moe paging: unsupported n_expert_used=%lld", (long long) k);
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        int32_t req[MAX_K];
+        int32_t slot[MAX_K];
+        for (int64_t i = 0; i < k; i++) {
+            req[i] = *(const int32_t *) ((const char *) a->data + t * a->nb[1] + i * a->nb[0]);
+        }
+        stage_event(*l, req, (int) k, slot);
+        for (int64_t i = 0; i < k; i++) {
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + i * dst->nb[0]) = slot[i];
+        }
+    }
+    if (l->il == g.n_layer - 1) {
+        g.tokens++;
+        if (g.stats_interval > 0 && g.tokens >= g.last_flush_tokens + (uint64_t) g.stats_interval) {
+            dump_stats();
+            g.last_flush_tokens = g.tokens;
+        }
+    }
+}
+
+// Return the paging layer that owns this resident-slot tensor, or nullptr.
+static llama_moe_paging_layer * direct_layer_for(const ggml_tensor * src0) {
+    if (!g.enabled || g.compute_mode != "direct_sparse") {
+        return nullptr;
+    }
+    for (auto & l : g.layers) {
+        if (l.slot_gate == src0 || l.slot_up == src0 || l.slot_down == src0) {
+            return &l;
+        }
+    }
+    return nullptr;
+}
+
+static bool llama_moe_paging_direct_mul_mat_id_impl(ggml_compute_params * params, ggml_tensor * op) {
+    if (op == nullptr || op->op != GGML_OP_MUL_MAT_ID) {
+        return false;
+    }
+    const ggml_tensor * src0 = op->src[0];
+    llama_moe_paging_layer * l = direct_layer_for(src0);
+    if (l == nullptr) {
+        return false;
+    }
+
+    const ggml_tensor * src1 = op->src[1];
+    const ggml_tensor * ids  = op->src[2];
+    ggml_tensor *       dst  = op;
+
+    GGML_TENSOR_BINARY_OP_LOCALS
+
+    const int ith = params->ith;
+    const int nth = params->nth;
+
+    const ggml_type type = src0->type;
+    const ggml_type vec_dot_type = ggml_get_type_traits_cpu(type)->vec_dot_type;
+    const ggml_from_float_t from_float = ggml_get_type_traits_cpu(vec_dot_type)->from_float;
+
+    GGML_ASSERT(nb00 == ggml_type_size(type));
+    GGML_ASSERT(nb10 == ggml_type_size(src1->type));
+    GGML_ASSERT(nb0 == sizeof(float));
+    GGML_ASSERT(nb0 <= nb1);
+    GGML_ASSERT(nb1 <= nb2);
+    GGML_ASSERT(nb2 <= nb3);
+
+    const int n_ids = (int) ids->ne[0]; // K = 8
+    const int n_as  = (int) ne02;       // M resident slots
+
+    // decode scope: single token, K selected ids
+    if (ids->ne[1] != 1 || n_ids > MAX_K) {
+        if (ith == 0) { l->direct_fallback_calls++; }
+        return false;
+    }
+
+    // Resolve the K selected resident-slot ids, reject duplicates, sort ascending
+    // so accumulation matches the accepted Execution-003/004 order.
+    int32_t sel[MAX_K];
+    int32_t order[MAX_K];
+    for (int i = 0; i < n_ids; i++) {
+        const int32_t s = *(const int32_t *) ((const char *) ids->data + i * ids->nb[0]);
+        if (s < 0 || s >= n_as) {
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        sel[i] = s;
+        order[i] = i;
+    }
+    for (int i = 0; i < n_ids; i++) {
+        for (int q = i + 1; q < n_ids; q++) {
+            if (sel[order[i]] == sel[order[q]]) {
+                // duplicate resident slot: the normal grouping merges them, keep it
+                if (ith == 0) { l->direct_fallback_calls++; }
+                return false;
+            }
+        }
+    }
+    std::sort(order, order + n_ids, [&](int a, int b) { return sel[a] < sel[b]; });
+
+    // scratch: convert src1 (F32) to vec_dot_type for the selected rows only
+    const size_t nbw1 = ggml_row_size(vec_dot_type, ne10);
+    char * wbuf = nullptr;
+    if (src1->type != vec_dot_type) {
+        wbuf = (char *) params->wdata;
+        if (wbuf == nullptr) {
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        const size_t need = nbw1 * (size_t) n_ids * (size_t) ne12;
+        if (params->wsize < need) {
+            if (ith == 0) { l->direct_fallback_calls++; }
+            return false;
+        }
+        // Every thread needs all K selected rows (K=8 is tiny), and the row loop
+        // below is not partitioned per thread, so each thread converts the whole
+        // selected set into its own view of the shared workspace.
+        for (int j = ith; j < n_ids; j += nth) {
+            for (int64_t i12 = 0; i12 < ne12; i12++) {
+                from_float((const float *) ((const char *) src1->data + (size_t) j * nb11 + (size_t) i12 * nb12),
+                           wbuf + (size_t) j * nbw1 + (size_t) i12 * nbw1,
+                           ne10);
+            }
+        }
+        ggml_barrier(params->threadpool);
+    }
+
+    if (ith == 0) {
+        l->direct_mul_mat_id_calls++;
+        l->direct_selected_matrices += (uint64_t) n_ids;
+    }
+
+    const int64_t nr0 = ne01;
+    int chunk_size = 16;
+    if (nr0 == 1 || n_ids == 1) {
+        chunk_size = 64;
+    }
+    const int64_t nchunk0 = (nr0 + chunk_size - 1) / chunk_size;
+    const int64_t dr0 = (nr0 + nchunk0 - 1) / nchunk0;
+
+    // one selected matrix per ascending resident slot
+    for (int jj = 0; jj < n_ids; jj++) {
+        const int j = order[jj];
+        const int32_t s = sel[j];
+        const char * src0_cur = (const char *) src0->data + (size_t) s * nb02;
+        const char * src1_row = (src1->type == vec_dot_type)
+            ? (const char *) src1->data + (size_t) j * nb11
+            : wbuf + (size_t) j * nbw1;
+        float * dst_col = (float *) ((char *) dst->data + (size_t) j * nb1);
+
+        (void) chunk_size;
+        for (int64_t ic = ith; ic < nchunk0; ic += nth) {
+            const int64_t ir0_start = dr0 * ic;
+            const int64_t ir0_end = std::min(ir0_start + dr0, nr0);
+            for (int64_t ir0 = ir0_start; ir0 < ir0_end; ir0++) {
+                float tmp = 0.0f;
+                ggml_vec_dot_t vec_dot = ggml_get_type_traits_cpu(type)->vec_dot;
+                vec_dot(ne00, &tmp, 0, src0_cur + ir0 * nb01, 0, src1_row, 0, 1);
+                dst_col[ir0] = tmp;
+            }
+        }
+    }
+
+    // The hook consumes the op before the CPU timing marker and the slot-count op
+    // can run, so mirror their bookkeeping here. Only the last layer counts a token.
+    if (g.timing) {
+        l->compute_ms += now_ms() - l->compute_start_ms;
+    }
+    if (ith == 0 && l->il == g.n_layer - 1) {
+        g.tokens++;
+        if (g.stats_interval > 0 && g.tokens >= g.last_flush_tokens + (uint64_t) g.stats_interval) {
+            dump_stats();
+            g.last_flush_tokens = g.tokens;
+        }
+    }
+
+    return true;
+}
+
+bool llama_moe_paging_timing_enabled() {
+    return g.timing;
+}
+
+llama_moe_paging_layer * llama_moe_paging_layer_for(int il) {
+    if (!g.enabled || il < 0 || il >= (int) g.layers.size()) {
+        return nullptr;
+    }
+    llama_moe_paging_layer * l = &g.layers[il];
+    // direct storage has no K8 tensors; the resident-slot tensors are the storage
+    if (llama_moe_paging_direct_storage()) {
+        return l->slot_gate != nullptr ? l : nullptr;
+    }
+    return l->stage_gate != nullptr ? l : nullptr;
+}
+
+void llama_moe_paging_stage(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    const int64_t k = a->ne[0];
+    const int64_t n_tok = a->ne[1];
+    if (k <= 0 || k > MAX_K) {
+        GGML_ABORT("moe paging: unsupported n_expert_used=%lld", (long long) k);
+    }
+    for (int64_t t = 0; t < n_tok; t++) {
+        int32_t req[MAX_K];
+        int32_t slot[MAX_K];
+        for (int64_t i = 0; i < k; i++) {
+            req[i] = *(const int32_t *) ((const char *) a->data + t * a->nb[1] + i * a->nb[0]);
+        }
+        stage_event(*l, req, (int) k, slot);
+        for (int64_t i = 0; i < k; i++) {
+            *(int32_t *) ((char *) dst->data + t * dst->nb[1] + i * dst->nb[0]) = slot[i];
+        }
+    }
+    if (l->il == g.n_layer - 1) {
+        g.tokens++;
+        if (g.stats_interval > 0 && g.tokens >= g.last_flush_tokens + (uint64_t) g.stats_interval) {
+            dump_stats();
+            g.last_flush_tokens = g.tokens;
+        }
+    }
+}
+
+void llama_moe_paging_end(ggml_tensor * dst, const ggml_tensor * a,
+                          int ith, int nth, void * userdata) {
+    if (ith != 0) {
+        return;
+    }
+    GGML_UNUSED(nth);
+    GGML_UNUSED(dst);
+    GGML_UNUSED(a);
+    auto * l = (llama_moe_paging_layer *) userdata;
+    l->compute_ms += now_ms() - l->compute_start_ms;
+}
+
+// C-linkage entry registered with ggml-cpu (see ggml_cpu_set_moe_mul_mat_id_hook).
+extern "C" bool llama_moe_paging_direct_mul_mat_id(struct ggml_compute_params * params, struct ggml_tensor * op) {
+    return llama_moe_paging_direct_mul_mat_id_impl(params, op);
+}
diff --git a/src/llama-moe-paging.h b/src/llama-moe-paging.h
new file mode 100644
index 0000000..0a38f11
--- /dev/null
+++ b/src/llama-moe-paging.h
@@ -0,0 +1,169 @@
+#pragma once
+
+// Execution 004: decoupled staging + parallel cold I/O for CPU/hybrid MoE paging.
+//
+// Execution 003 coupled cache capacity M to the CPU mul_mat_id expert dimension:
+// every layer owned M-slot gate/up/down tensors, and the graph remapped global
+// expert ids to those M slots. Larger M meant more I/O hits but a slower kernel.
+//
+// This module keeps two separate objects per layer:
+//
+//   * resident cache: M raw record-layout byte slots, replaced by LRU or
+//     event-decay90; capacity M is independent of the compute shape;
+//   * staging: exactly K = n_expert_used gate/up/down tensors whose expert
+//     dimension is always K (8 for Qwen3.6-35B-A3B). The graph calls mul_mat_id
+//     on the staging tensors only, after the selected K experts are copied in.
+//
+// All misses of one layer event are gathered first and read through a bounded
+// reusable worker pool (QD 1/2/4/8). Two storage backends are supported:
+// one packed record per expert, or three component reads straight from the
+// source GGUF. Reads can be marked best-effort uncached (F_NOCACHE on macOS).
+//
+// Enabled when LLAMA_MOE_PAGING_M is set to a positive integer.
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <vector>
+
+struct llama_model;
+struct ggml_context;
+struct ggml_tensor;
+struct ggml_compute_params;
+typedef struct ggml_backend_buffer * ggml_backend_buffer_t;
+
+struct llama_moe_paging_layer {
+    int il = -1;
+
+    // K = n_expert_used staging tensors, expert dimension always K
+    ggml_tensor * stage_gate = nullptr;
+    ggml_tensor * stage_up   = nullptr;
+    ggml_tensor * stage_down = nullptr;
+
+    // Execution 009 direct_sparse: plain CPU resident-slot tensors with expert
+    // dimension M. Only the K selected slots are consumed by the CPU matmul, and
+    // a cold miss reads straight into the final resident slot. No K8 staging copy.
+    ggml_tensor * slot_gate = nullptr;
+    ggml_tensor * slot_up   = nullptr;
+    ggml_tensor * slot_down = nullptr;
+    ggml_context *        slot_ctx = nullptr;
+    ggml_backend_buffer_t slot_buf = nullptr;
+
+    ggml_context *        stage_ctx = nullptr;
+    ggml_backend_buffer_t stage_buf = nullptr;
+
+    // resident M-slot cache, one record-layout block per slot
+    std::vector<uint8_t> cache;
+    int n_slots = 0;
+    std::vector<int32_t>  slot_expert;  // global expert id per slot, -1 == empty
+    std::vector<uint64_t> last_use;     // per-slot recency clock
+    std::vector<double>   score;        // event-decay90 score
+    std::vector<uint8_t>  reserved;     // per event: slot is a miss destination
+
+    // component geometry inside a record
+    int64_t gate_bytes = 0;
+    int64_t up_bytes   = 0;
+    int64_t down_bytes = 0;
+    int64_t gate_off   = 0;
+    int64_t up_off     = 0;
+    int64_t down_off   = 0;
+
+    // absolute GGUF offsets for backend=gguf3
+    int64_t gguf_gate_off = 0;
+    int64_t gguf_up_off   = 0;
+    int64_t gguf_down_off = 0;
+
+    // persistent K8 stage bookkeeping (Execution 008). Each entry records which
+    // global expert the stage position currently holds; -1 means unknown.
+    std::vector<int32_t> stage_expert;
+
+    // instrumentation
+    uint64_t hits       = 0;
+    uint64_t misses     = 0;
+    uint64_t evictions  = 0;
+    uint64_t bytes_read = 0;
+    uint64_t stage_bytes = 0;        // logical K * record_stride per event
+    uint64_t events     = 0;
+    uint64_t qd_sum     = 0;
+    uint64_t qd_max     = 0;
+    uint64_t miss_hist[9] = {};   // layer events with 0..8 unique misses
+    uint64_t readset_hist[32] = {}; // read-set latency buckets for this layer
+
+    // staging traffic split (Execution 008)
+    uint64_t stage_cache_bytes = 0;  // resident cache -> stage
+    uint64_t stage_move_bytes  = 0;  // stage -> stage (includes the scratch record)
+    uint64_t stage_retain_bytes = 0; // exact-position retains, zero copy
+    uint64_t stage_hit_bytes   = 0;  // staged bytes that were resident-cache hits
+    uint64_t stage_miss_bytes  = 0;  // staged bytes that came from a miss read
+    uint64_t retain_exact      = 0;  // experts retained in place
+    uint64_t moved_in_stage    = 0;  // experts permuted within the K8 stage
+    uint64_t newly_staged      = 0;  // experts copied into the K8 stage
+
+    double   fault_ms   = 0.0;    // historical name: caller-blocking wait on the miss read set (== read_wait_ms)
+    double   read_wait_ms = 0.0;  // caller-blocking wait after pre-wait staging; excludes overlapped read time
+    double   stage_ms   = 0.0;    // total staging copy time (pre + post wait)
+    double   stage_copy_ms = 0.0; // same as stage_ms, explicit split
+    double   stage_pre_wait_ms = 0.0;  // copy work done while reads are outstanding
+    double   stage_post_wait_ms = 0.0; // copy work after the read set is ready
+    double   stage_wall_ms = 0.0; // resolve/read-submit -> stage-ready
+    double   readset_wall_ms = 0.0; // full miss read-set wall: submit/start -> completion (includes overlapped pre-wait staging)
+
+    // Execution 009 direct_sparse instrumentation
+    uint64_t direct_calls             = 0;  // paging slot-resolution events (one per layer event)
+    uint64_t direct_mul_mat_id_calls  = 0;  // CPU MUL_MAT_ID ops served by the direct kernel (once per op)
+    uint64_t direct_selected_matrices = 0;  // == direct_mul_mat_id_calls * K
+    uint64_t direct_fallback_calls    = 0;
+    uint64_t direct_materialize_bytes = 0;
+    uint64_t direct_repack_bytes      = 0;
+    double   compute_ms = 0.0;    // router weights -> expert down projection
+    double   compute_start_ms = 0.0;
+};
+
+// Idempotent. Reads the env vars:
+//   LLAMA_MOE_PAGING_M        slots per layer (0 == disabled)
+//   LLAMA_MOE_PAGING_STORE    packed store path (default cold-experts.bin)
+//   LLAMA_MOE_PAGING_GGUF     source GGUF path (required by backend=gguf3)
+//   LLAMA_MOE_PAGING_OFFSETS  GGUF offset CSV (default results/gguf_expert_offsets.csv)
+//   LLAMA_MOE_PAGING_STATS    stats output path
+//   LLAMA_MOE_PAGING_POLICY   lru | event_decay90 (decay90 accepted as alias)
+//   LLAMA_MOE_PAGING_BACKEND  packed | gguf3 (default packed)
+//   LLAMA_MOE_PAGING_QD       read queue depth 1/2/4/8 (default 4)
+//   LLAMA_MOE_PAGING_STAGE_MODE  serial | overlap | persistent_overlap (default serial)
+//   LLAMA_MOE_PAGING_COMPUTE_MODE  staging | direct_sparse (default staging)
+//   LLAMA_MOE_PAGING_NOCACHE  0|1 best-effort F_NOCACHE (default 0)
+//   LLAMA_MOE_PAGING_HOT      0|1 no-file-I/O compute control (default 0)
+//   LLAMA_MOE_PAGING_STATS_INTERVAL  tokens between stats flushes (default 128)
+//   LLAMA_MOE_PAGING_FAULT_AFTER     inject a read failure after N reads (test)
+//   LLAMA_MOE_PAGING_ASSERT   0|1 internal consistency checks (default 0)
+void llama_moe_paging_init(const llama_model & model);
+
+bool llama_moe_paging_enabled();
+
+// False when LLAMA_MOE_PAGING_TIMING=0: skips the end-of-MoE timestamp marker.
+bool llama_moe_paging_timing_enabled();
+
+llama_moe_paging_layer * llama_moe_paging_layer_for(int il);
+
+// ggml custom op: ensure the K selected global experts are resident, copy them
+// into staging, and write staging slot ids 0..K-1 to dst.
+void llama_moe_paging_stage(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata);
+
+// Execution 009: true when direct_sparse compute mode is active. In that mode the
+// graph must call mul_mat_id on the resident-slot tensors with resident slot ids
+// instead of on the K8 staging tensors.
+bool llama_moe_paging_direct_mode();
+
+// Execution 009: resolve the global expert ids in `a` to resident slot ids and
+// page any missing expert directly into its final resident slot. Writes ascending
+// resident-slot ids to dst. Registered as a ggml custom op.
+void llama_moe_paging_slots(ggml_tensor * dst, const ggml_tensor * a,
+                            int ith, int nth, void * userdata);
+
+// Execution 009: selected-only CPU mul_mat_id for direct_sparse resident-slot
+// tensors. Returns true when this call took over `op`.
+extern "C" bool llama_moe_paging_direct_mul_mat_id(struct ggml_compute_params * params, ggml_tensor * op);
+
+// ggml custom op: end-of-MoE timestamp marker (copies a to dst).
+void llama_moe_paging_end(ggml_tensor * dst, const ggml_tensor * a,
+                          int ith, int nth, void * userdata);
